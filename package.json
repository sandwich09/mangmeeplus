{
  "name": "watchdog-bms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "dev": "turbo run dev",
    "lint": "corepack pnpm -r --if-present lint",
    "security:audit": "corepack pnpm audit --audit-level=high",
    "config:validate": "tsx scripts/validate-prod-config.ts",
    "security:m14-evidence": "tsx scripts/m14-scanner-evidence.ts",
    "legal:release-gate": "bash infra/security/validate-legal-release-readiness.sh",
    "e2e": "playwright test",
    "e2e:critical": "playwright test --project=critical",
    "test:harness": "pnpm --filter @watchdog-bms/contracts build && tsx --test scripts/line-ai-latency-autonomy.corpus.spec.ts scripts/expense-category.golden.spec.ts scripts/expense-capture-read.fixtures.spec.ts scripts/brain-family-questions.golden.spec.ts",
    "agent:gates": "node scripts/check-agent-gates.mjs",
    "test": "corepack pnpm -r --if-present test",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "docker:local": "docker compose -f infra/docker/compose.local.yml --env-file .env up --build",
    "docker:local:infra": "docker compose -f infra/docker/compose.local.yml --env-file .env up postgres redis minio minio-create-bucket"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.15",
      "@svgr/plugin-svgo>svgo": "3.3.5",
      "@swc/cli>minimatch": "10.2.5",
      "@swc/cli>piscina": "4.9.4",
      "cacheable-request>http-cache-semantics": "4.3.0",
      "express>body-parser": "2.4.0",
      "brace-expansion": "5.0.12",
      "browserslist": "^4.28.7",
      "deepmerge-ts": ">=8.0.0",
      "fast-uri": "^3.1.8",
      "hono": "^4.13.11",
      "js-yaml": "4.3.2",
      "multer": "^2.5.0",
      "mysql2": "^3.22.0",
      "nanoid": "^3.3.17",
      "postcss": "^8.5.18",
      "proxy-addr": "^2.0.8",
      "qs": "^6.16.0",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "valibot": "^1.4.2"
    },
    "patchedDependencies": {
      "pdfjs-dist@6.2.108": "patches/pdfjs-dist@6.2.108.patch"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
