// =============================================================================
// Feature entitlement decoupling — F1 control plane (additive only)
// Spec: docs/specs/feature-entitlement-decoupling-spec.md (CC1 spec:49-68,
// CC3 spec:78-85, CC7 spec:232-238). Plan: docs/plans/feature-entitlement-decoupling-plan.md F1.
//
// Two distinct object families live here and they are NOT the same state machine:
//  - TENANT entitlement lifecycle (ON | DRAINING | OFF), per company x feature —
//    company-scoped rows, cascade with the Company.
//  - GLOBAL launch gate (OPEN | CLOSED), per (gateKey, routeKey) — internal-only
//    operational control plane, never company-scoped, never customer/partner/AI visible.
//
// Child transitions intentionally carry natural-key scalars instead of a compound FK
// to their parent row: the spec fixes uniqueness on (companyId, featureKey, seq) and
// (gateKey, routeKey, seq), and a compound-FK relation would force callers through
// nested-connect writes (repo Prisma-7 trap).
// =============================================================================

enum EntitlementTransitionAction {
  ENABLE
  DISABLE_REQUESTED
  OFF
}

enum CompanyEntitlementNormalizationStatus {
  STARTED
  COMPLETED
  FAILED
}

enum FeatureLaunchGateState {
  CLOSED
  OPEN
}

enum FeatureLaunchGateAction {
  OPEN
  CLOSE
}

enum FeatureLaunchRouteClass {
  ORDINARY
  SPECIALIST_LEGAL
}

// What a control-plane command DID: nothing (already satisfied), a real state change, or a per-build
// acceptance at the same generation.
enum FeatureLaunchCommandResultKind {
  NOOP
  APPLIED
  ACCEPTED
}

// U1 remote-writer truth. RUNNING and UNKNOWN are deliberately nonterminal: either one blocks the
// next release/F2/retirement writer for this environment until the exact operation is reconciled.
enum RemoteReleaseOperationStatus {
  RUNNING
  UNKNOWN
  SUCCEEDED
  FAILED_CONFIRMED
  RECONCILED_SUCCEEDED
  RECONCILED_FAILED_CONFIRMED
}

enum RemoteReleaseMutationIntentStatus {
  OPEN
  BOUND
  CONFIRMED_NO_MUTATION
}

enum ExecutionAttemptStatus {
  QUEUED
  CLAIMED
  DISPATCHING
  SUCCEEDED
  HANDED_OFF
  SUPPRESSED_FEATURE_DISABLED
  SKIPPED_FEATURE_DISABLED
  SUPPRESSED_LAUNCH_GATE_CLOSED
  SKIPPED_LAUNCH_GATE_CLOSED
  // The two post-dispatch terminals are NOT interchangeable, and the difference decides whether the
  // work may ever run again (spec:62, spec:64):
  //   UNKNOWN_EXTERNAL_OUTCOME — the provider MAY have received it. No retry, no Resume, no Reissue
  //     until a human or a provider poll reconciles the row; a blind retry here double-sends.
  //   FAILED_CONFIRMED        — the provider gave a DEFINITIVE failure, so nothing was effected and
  //     Resume/Reissue at the next attemptSeq is allowed later.
  // Only a holder that can still prove its unexpired lease may assert the definitive half; a holder
  // that cannot has, by definition, an unknown outcome.
  UNKNOWN_EXTERNAL_OUTCOME
  FAILED_CONFIRMED
  POISONED
}

enum BackfillRunStatus {
  AUTHORIZED
  MATERIALIZED
  RUNNING
  COMPLETED
  FAILED
}

enum BackfillRunItemStatus {
  PENDING
  APPLIED
  SKIPPED
  NEEDS_REVIEW
}

// spec:51 — canonical batch-CAS root. `setVersion` increments exactly once per
// successful multi/single-key entitlement command.
model CompanyEntitlementSet {
  id               String    @id @default(cuid())
  companyId        String    @unique
  setVersion       Int       @default(0)
  lastTransitionAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// spec:51 — whole-set idempotency. Same key + same fingerprint returns the stored
// result before CAS; key reuse with another payload rejects.
model EntitlementCommand {
  id                 String   @id @default(cuid())
  companyId          String
  commandId          String
  payloadFingerprint String
  expectedSetVersion Int
  resultSetVersion   Int
  resultJson         Json
  createdAt          DateTime @default(now())
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, commandId])
  @@index([companyId, createdAt])
}

// spec:51 — append-only child of the entitlement set. Never updated in place.
model EntitlementTransition {
  id          String                      @id @default(cuid())
  companyId   String
  featureKey  String
  seq         Int
  epoch       Int
  commandId   String
  action      EntitlementTransitionAction
  actorUserId String // user id, or the literal 'SYSTEM' (spec:51)
  reasonJson  Json?
  createdAt   DateTime                    @default(now())
  company     Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureKey, seq])
  @@unique([companyId, featureKey, commandId])
  @@index([companyId, createdAt])
}

// spec:57 — written once inside the disable transaction; membership NEVER widens.
// Keyed by the DISABLE_REQUESTED transition seq so a later disable cycle gets its own
// immutable snapshot and re-enable never revives the old one (spec:64).
model RunoffSnapshot {
  id         String   @id @default(cuid())
  companyId  String
  featureKey String
  disableSeq Int
  cutoffAt   DateTime
  rootsJson  Json
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureKey, disableSeq])
  @@index([companyId, featureKey])
}

// spec:234-235 (CC7) — distinct from feature transitions. A company is EXPLICIT only
// when status is COMPLETED; the resolver uses legacy or explicit semantics for the
// whole company, never per feature.
model CompanyEntitlementNormalization {
  id                String                                @id @default(cuid())
  companyId         String                                @unique
  status            CompanyEntitlementNormalizationStatus @default(STARTED)
  snapshotHash      String
  runId             String
  // CC7 ruling 5 — the repair generation that produced this marker (`NORMALIZER_VERSION` in
  // normalize-entitlements.ts). The runner re-opens any COMPLETED company below the current
  // number, so raising the constant re-runs repair without a data migration. The default matches
  // the constant's starting value, which keeps onboarding-written markers (EXPLICIT grants that
  // need no repair) out of the pass.
  normalizerVersion Int                                   @default(0)
  // The DURABLE cohort this marker was completed as: `LEGACY` = the grandfather pass materialized
  // rows that predate explicit entitlements, `EXPLICIT` = onboarding or verified paid package
  // wrote a full explicit set as real decisions.
  // Verify reads THIS, never "does any row carry grantOrigin=LEGACY" — a legacy company whose
  // provenance stamp landed on zero rows is indistinguishable from an explicit one by inference,
  // and used to pass verify with its entire cohort marker missing. Null = written by a normalizer
  // that predates the column, which verify treats as incomplete rather than guessing.
  cohortKind        String?
  error             String?
  startedAt         DateTime                              @default(now())
  completedAt       DateTime?
  createdAt         DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt
  company           Company                               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
}

// spec:53 — GLOBAL, internal-only. One row per sellable feature or named operational
// route; `routeKey='DEFAULT'` when no staged route exists. Seeded CLOSED: unknown or
// missing rows are CLOSED and use the documented fallback (spec:270).
// `reason` is advisory free text and is NEVER authoritative (spec:54).
model FeatureLaunchGate {
  id         String                 @id @default(cuid())
  gateKey    String
  routeKey   String
  state      FeatureLaunchGateState @default(CLOSED)
  generation Int                    @default(0)
  lastSeq    Int                    @default(0)
  reason     String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([gateKey, routeKey])
  @@index([state])
}

// spec:53-54 — append-only child. The control-plane snapshot columns are immutable and
// queryable by contract: no required field may be reconstructed later from logs or
// `reason`. Requiredness (normal vs SPECIALIST_LEGAL vs emergency) is enforced by the
// command, not by nullability, because one table serves all three shapes.
model FeatureLaunchGateTransition {
  id                         String                  @id @default(cuid())
  gateKey                    String
  routeKey                   String
  seq                        Int
  generation                 Int
  commandId                  String
  action                     FeatureLaunchGateAction
  actorUserId                String // user id, or the literal 'SYSTEM' (spec:53)
  payloadFingerprint         String
  reason                     String?
  // controlPlaneSnapshot (spec:54) — immutable, queryable
  targetEnvironment          String
  buildReleaseId             String
  expectedGeneration         Int
  routeClass                 FeatureLaunchRouteClass
  validationEvidenceRef      String?
  validationEvidenceHash     String?
  specialistApprovedByUserId String?
  releaseApprovedByUserId    String?
  emergencyClose             Boolean                 @default(false)
  emergencyAuthorityUserId   String?
  incidentRef                String?
  createdAt                  DateTime                @default(now())

  @@unique([gateKey, routeKey, seq])
  @@unique([gateKey, routeKey, commandId])
  @@index([gateKey, routeKey, createdAt])
}

// UAT r5 item 2 — the durable stored result of EVERY control-plane command, no-ops included, and
// deliberately SEPARATE from the authority transitions above: a NOOP is a result, not a transition,
// and mixing the two would put rows that changed nothing into the append-only authority history.
// Without it a no-op OPEN recorded nothing, so a delayed retry of that command could arrive after
// its build had been retired and be re-decided as a fresh per-build acceptance.
model FeatureLaunchCommandResult {
  id                 String                         @id @default(cuid())
  gateKey            String
  routeKey           String
  commandId          String
  resultKind         FeatureLaunchCommandResultKind
  action             FeatureLaunchGateAction
  // The gate state/generation/seq this command resolved to — what a replay must answer with.
  state              FeatureLaunchGateState
  generation         Int
  lastSeq            Int
  payloadFingerprint String
  actorUserId        String // user id, or the literal 'SYSTEM'
  // Deployment identity of the process that answered, so a replay is attributable to a build even
  // when it produced no transition at all.
  targetEnvironment  String
  buildReleaseId     String
  createdAt          DateTime                       @default(now())

  @@unique([gateKey, routeKey, commandId])
  @@index([gateKey, routeKey, createdAt])
}

// U1 — durable environment lease for every remote release/F2/retirement task. The PostgreSQL
// session advisory lock remains the atomic mutating-operation fence; parallel deployment-evidence
// binders serialize on this row. It survives runner/task death and carries the exact ECS identity
// needed to decide whether another writer may start. A raw partial
// unique index in the migration permits at most one RUNNING/UNKNOWN row per environment.
model RemoteReleaseOperation {
  id                              String                        @id
  targetEnvironment               String
  mode                            String
  releaseDeployTarget             String?
  buildReleaseId                  String
  ecsTaskArn                      String
  ecsServiceArn                   String?
  serviceDeploymentArn            String?
  targetServiceRevisionArn        String?
  activeBuildsJson                Json?
  deploymentManifestJson          Json?
  platformAuthorizedAt            DateTime?
  sourceBranch                    String
  controllerKind                  String
  githubRunId                     String?
  githubRunAttempt                Int?
  githubActor                     String?
  githubActorId                   String?
  githubWorkflowRef               String?
  githubRepository                String?
  manualActorRef                  String?
  status                          RemoteReleaseOperationStatus  @default(RUNNING)
  leaseOwner                      String
  heartbeatAt                     DateTime                      @default(now())
  leaseExpiresAt                  DateTime
  unknownAt                       DateTime?
  completedAt                     DateTime?
  outcomeReason                   String?
  reconciledAt                    DateTime?
  reconciledByActorRef            String?
  reconciledByTaskArn             String?
  reconciliationEvidenceRef       String?
  reconciliationReason            String?
  preIntentApiCleanupCompletedAt  DateTime?
  preIntentApiCleanupEvidenceJson Json?
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
  mutationIntents                 RemoteReleaseMutationIntent[]

  @@index([targetEnvironment, status])
  @@index([ecsTaskArn])
  @@index([serviceDeploymentArn])
}

// A committed pre-AWS-mutation record. It closes the runner-death gap between create/update and
// release-bind: recovery can prove one exact causal deployment or an unchanged no-mutation state,
// while ambiguity leaves the parent UNKNOWN. Different services may be OPEN concurrently; the raw
// partial index in the migration permits only one OPEN intent per service under a held release.
model RemoteReleaseMutationIntent {
  id                             String                            @id
  operationId                    String
  targetEnvironment              String
  buildReleaseId                 String
  serviceKey                     String
  mutationKind                   String
  expectedServiceArn             String
  clusterName                    String
  serviceName                    String
  ssmParameterName               String
  requestHash                    String
  desiredConfigHash              String
  beforeDeploymentArnsJson       Json
  beforeCurrentDeploymentArn     String?
  beforeActiveConfigurationsJson Json
  legacyBootstrapDescriptorJson  Json?
  preparedByTaskArn              String
  status                         RemoteReleaseMutationIntentStatus @default(OPEN)
  evidenceJson                   Json?
  closedByTaskArn                String?
  recovererControllerJson        Json?
  legacyRollbackObservedAt       DateTime?
  legacyRollbackCleanedAt        DateTime?
  failedBuildCleanupRequiredAt   DateTime?
  failedBuildCleanupCompletedAt  DateTime?
  legacyCutoverCompletedAt       DateTime?
  requestStartedAt               DateTime                          @default(now())
  requestDeadlineAt              DateTime
  closedAt                       DateTime?
  createdAt                      DateTime                          @default(now())
  updatedAt                      DateTime                          @updatedAt
  operation                      RemoteReleaseOperation            @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@index([operationId, status])
  @@index([targetEnvironment, status])
  @@index([expectedServiceArn, requestStartedAt])
}

// r2 ruling — DURABLE shadow evidence. The shadow probes used to only LOG, so the evidence an
// enforcement flip is approved from (runbook §4.1 R1 step 2) evaporated with the log retention
// window. GLOBAL and tenant-anonymous: NO companyId, no user/customer identity, no free text.
// Every column is either a control-plane identifier or a count.
//
// ponytail: ONE counter column. `reason` and `wouldBlock` are IN the key, so denominator, mapped
// count, would-block count and rate are exact SUMs over the reason dimension — a stored total is a
// second bookkeeping that can disagree with its own rows. If the view ever gets slow, the upgrade
// path is a rollup table, not more columns here.
//
// Volume ceiling: 2 surfaces × ~20 routes × 5 reasons × 2 builds × 24h ≈ 9.6k rows/day worst case;
// realistically 10-100/day. No prune job ships with this (the repo has none); the `hourStartUtc`
// index makes a later range delete cheap. These rows are release-decision evidence and are meant to
// outlive an ordinary retention window, exactly like the gate transitions above.
model FeatureLaunchObservationBucket {
  id                String   @id @default(cuid())
  hourStartUtc      DateTime // UTC hour floor, stamped once per sweep at flush
  targetEnvironment String // resolveDeploymentIdentity() — server truth, never a caller string
  buildReleaseId    String
  surface           String // 'outbox.drain' | 'crm.campaign.delivery' — code constants, never user data
  gateKey           String // '__unmapped__' when the event's owning feature is not mapped yet
  routeKey          String
  reason            String // ShadowReason
  // Redundant with `reason` BY CONSTRUCTION and stored on purpose: this row outlives the build that
  // wrote it, and a later build must not reinterpret it if the reason→block mapping ever changes
  // (the same principle that stamps `executionPolicyKey` into an attempt).
  wouldBlock        Boolean
  observedCount     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt // doubles as the staleness signal inside the current hour

  // EXACTLY ONE unique index on this table, on purpose: `ON CONFLICT` arbitrates on one index, and
  // a second unique would make the loser of a concurrent upsert raise unique_violation instead of
  // taking DO UPDATE (see `execution-attempt.service.ts` `attemptIdentityLock`). Explicitly named
  // because both the derived Prisma property name and the derived Postgres index name are unusable
  // at 8 columns — Postgres silently truncates identifiers at 63 chars.
  @@unique([hourStartUtc, targetEnvironment, buildReleaseId, surface, gateKey, routeKey, reason, wouldBlock], name: "bucketKey", map: "FeatureLaunchObservationBucket_bucket_key")
  @@index([hourStartUtc])
}

// spec:59-62 — the linearization row for final execution. Every queued / outbound /
// final-mutation work row created after rollout stores its availability vector here:
// every required entitlement epoch AND every required (gateKey, routeKey, generation).
// The vector is stamped at creation and never mutated — no back-stamping (spec:63).
// The DISPATCHING lease/token is embedded (0..1 per attempt, spec:62) rather than a
// separate table; the token doubles as the provider idempotency key.
model ExecutionAttempt {
  id                     String                 @id @default(cuid())
  companyId              String? // nullable to mirror OutboxEvent.companyId for platform-level work
  // NOT-NULL mirror of `companyId` (`'__platform__'` when null). Postgres treats NULLs in a unique
  // index as DISTINCT, so every tenant-scoped uniqueness below is keyed on this column instead —
  // a nullable `companyId` would silently disable the constraint for platform-level work. A CHECK
  // constraint pins it to `COALESCE("companyId", '__platform__')` so it can never drift.
  companyScope           String
  sourceType             String
  sourceId               String
  attemptSeq             Int                    @default(1) // Resume/Reissue mints the next attempt (spec:64)
  attemptKey             String                 @unique // SCOPED `<companyScope>::<attemptSeq>::<callerKey>`; upsert-safe, never create-then-catch-P2002
  identityFingerprint    String? // `v2:<sha256>` immutable identity (scope/source/seq/features/routes/policy); compared on every upsert hit
  status                 ExecutionAttemptStatus @default(QUEUED)
  entitlementEpochsJson  Json // { featureKey: epoch } — every REQUIRED feature, not only the owner
  launchEntriesJson      Json // [{ gateKey, routeKey, generation }]
  availabilityVectorHash String // spec:61 batch-eligibility key; never reused across txn/company/build/generation
  // F1.5.2 blocker 2 — the DEPLOYMENT the vector was stamped on (spec:54 server truth, never a
  // caller string). An availability vector is only meaningful together with the environment and
  // build whose gate approval it read: an OPEN attested in uat, or on another build, never
  // authorized this work. Nullable because the column is additive; a row that carries neither
  // cannot prove which deployment authorized it and is treated as CLOSED at claim time.
  targetEnvironment      String?
  buildReleaseId         String?
  retainedArtifactPolicy String? // spec:58 retained-artifact compensation attempts only
  claimedAt              DateTime?
  dispatchToken          String?                @unique // spec:62 durable DISPATCHING token = provider idempotency key
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  // Monotonic fencing counter, bumped on every (re)acquisition of the DISPATCHING lease. An expired
  // lease taken over by a new worker invalidates the old holder's generation, so a resurrected
  // worker's dispatch/completion CAS matches 0 rows instead of overwriting the new holder's work.
  leaseGeneration        Int                    @default(0)
  dispatchedAt           DateTime?
  providerRequestRef     String?
  providerLastCheckedAt  DateTime?
  attempts               Int                    @default(0)
  lastError              String?
  terminalAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  company                Company?               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // TENANT-SCOPED source identity. The pre-F1.5.1 unique was GLOBAL `(sourceType, sourceId,
  // attemptSeq)`, so two companies whose source ids collide (any non-uuid business key: an invoice
  // number, an external ref) fought over one row. Same (scope, source, seq) = the same work and is
  // idempotent; a NEW seq is a NEW row, which is what makes Resume/Reissue mint an attempt instead
  // of reviving the old one (spec:64).
  @@unique([companyScope, sourceType, sourceId, attemptSeq], map: "ExecutionAttempt_scope_source_seq_key")
  // Belt-and-braces beside the globally unique SCOPED `attemptKey`, on the NOT-NULL scope column so
  // it actually constrains platform-level rows.
  @@unique([companyScope, attemptKey])
  @@index([companyId, status, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([status, terminalAt])
}

// spec:80-84 (CC3) — one durable enable-authorized run. The feature-enable command
// itself is the authorization (confirmationSource='FEATURE_ENABLE'); there is no second
// migration confirmation. A linked repair run inside the exact authorization points at
// its parent and never mutates the frozen manifest (spec:83).
model BackfillRun {
  id                        String            @id @default(cuid())
  companyId                 String
  featureKey                String
  commandId                 String
  confirmationSource        String            @default("FEATURE_ENABLE")
  authorizationFingerprint  String
  actorUserId               String
  policyVersionsJson        Json // policy / rule / config versions snapshotted at authorization
  authorizedSourceTypesJson Json
  cutoffAt                  DateTime
  itemSetHash               String? // null until the fixed-scope manifest is complete
  sourceCountsJson          Json? // per-source counts, frozen with the manifest
  status                    BackfillRunStatus @default(AUTHORIZED)
  checkpointJson            Json?
  errorSummary              String?
  parentRunId               String?
  startedAt                 DateTime?
  completedAt               DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  company                   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentRun                 BackfillRun?      @relation("BackfillRunRepairLineage", fields: [parentRunId], references: [id], onDelete: Restrict)
  repairRuns                BackfillRun[]     @relation("BackfillRunRepairLineage")
  items                     BackfillRunItem[]

  @@unique([companyId, commandId])
  @@index([companyId, featureKey, status])
  @@index([status, createdAt])
}

// spec:81-84 — immutable manifest item. Frozen scope: one row per authorized source.
// Revalidation may only move status (already posted -> SKIPPED, changed/invalid ->
// NEEDS_REVIEW); no item is silently replaced.
model BackfillRunItem {
  id            String                @id @default(cuid())
  companyId     String
  runId         String
  sourceType    String
  sourceId      String
  sourceVersion String?
  status        BackfillRunItemStatus @default(PENDING)
  resultRef     String? // generated journal / projection id once applied
  reviewReason  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run           BackfillRun           @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sourceType, sourceId])
  @@index([companyId, status])
  @@index([runId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Step 0 — Company tax identity
// Authority: docs/specs/company-tax-identity-setup-spec.md (v2.9). Release A is additive
// only: every table below is new, every column added above is nullable or defaulted, and no
// constraint is placed on pre-existing data. The §6.3 branch constraints wait for Release B1
// because live rows can violate them; the partial unique on the reconciliation item ships here
// because the table is created empty in the same migration.
// ─────────────────────────────────────────────────────────────────────────────

enum LegalIdentityAuthorityReason {
  TIN_VERIFIED
  VAT_MATCHED
  TAX_DOCUMENT_ISSUED
}

enum TinExistenceStatus {
  VERIFIED
  NOT_FOUND
}

enum VatDetailStatus {
  MATCHED
  NOT_FOUND
  MISMATCH
}

enum VerificationAttemptStatus {
  VERIFIED
  NOT_FOUND
  MISMATCH
  SERVICE_UNAVAILABLE
}

enum LegalIdentityChangeKind {
  INITIAL_CAPTURE
  CORRECTION
  LEGAL_CHANGE
  RECONCILIATION_CORRECTION
}

enum LegalIdentityCorrectionReason {
  TYPO
  FORMATTING
  TRANSLITERATION
}

enum BuyerEntityKind {
  JURISTIC
  INDIVIDUAL
}

enum BuyerVatStatus {
  VAT_REGISTERED
  NOT_REGISTERED
  UNKNOWN
}

// A VAT fact is binary. UNKNOWN is the absence of a covering fact, never a stored value.
enum VatFactStatus {
  REGISTERED
  NOT_REGISTERED
}

enum VatFactSource {
  LEGACY_SEED
  USER_ANSWER
  RD_VERIFIED
  RECONCILIATION
}

enum ReconciliationKind {
  TAX_ID
  BRANCH_DUP
  VAT_HINT
}

enum ReconciliationSourceState {
  ALIGNED
  PENDING_ONE_SIDED
  PENDING_CONFLICT
}

enum ReconciliationStatus {
  PENDING
  RESOLVED
}

enum BuyerEvidenceChangeKind {
  INITIAL_REMEDIATION
  DATA_CORRECTION
}

// Append-only history of the company's legal identity (spec §4.2). No update, no delete: the
// value that was printed on a tax invoice has to stay reconstructable afterwards, which is
// also what lets a backdated document freeze the identity as of its own date (§8.3).
model CompanyLegalIdentityRevision {
  id                   String                         @id @default(cuid())
  companyId            String
  legalIdentityVersion Int
  snapshotJson         Json
  changeKind           LegalIdentityChangeKind
  // LEGAL_CHANGE only. A civil date — stored at UTC midnight, compared against the company's
  // calendar day, never against a raw timestamp.
  effectiveFrom        DateTime?                      @db.Date
  correctionReason     LegalIdentityCorrectionReason?
  // Provenance for RECONCILIATION_CORRECTION: an item id on the resolver path, or a repair
  // command id on the post-B2 path where the reconciliation lane no longer produces items.
  // Exactly one is required there; application code enforces which, the DB enforces uniqueness.
  reconciliationItemId String?
  repairCommandId      String?
  note                 String?
  evidenceRef          String?
  actorUserId          String?
  createdAt            DateTime                       @default(now())

  company            Company                            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reconciliationItem CompanyIdentityReconciliationItem? @relation(fields: [companyId, reconciliationItemId], references: [companyId, id])

  @@unique([companyId, legalIdentityVersion])
  // Makes a repair replay idempotent in the database, not only under the advisory lock.
  // Postgres treats NULLs as distinct, so ordinary revisions are unaffected.
  @@unique([companyId, repairCommandId])
  @@index([companyId, changeKind, effectiveFrom])
  @@index([companyId, createdAt])
}

// CC4 (feature-entitlement-decoupling-spec:219-227) State/Command/Fact, verbatim shape.
model CompanyVatRegistrationState {
  companyId String   @id
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyVatRegistrationCommand {
  id                   String   @id @default(cuid())
  companyId            String
  commandId            String
  // Computed by the server from the normalized intent. Never accepted from a client.
  payloadFingerprint   String
  expectedStateVersion Int
  resultStateVersion   Int
  resultFactId         String?
  resultKind           String
  actorUserId          String?
  createdAt            DateTime @default(now())

  company    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resultFact CompanyVatRegistrationFact? @relation(fields: [companyId, resultFactId], references: [companyId, id])

  @@unique([companyId, commandId])
  @@index([companyId, createdAt])
}

model CompanyVatRegistrationFact {
  id                    String        @id @default(cuid())
  companyId             String
  status                VatFactStatus
  effectiveFrom         DateTime      @db.Date
  // Half-open interval [effectiveFrom, effectiveTo). NULL = still open-ended.
  effectiveTo           DateTime?     @db.Date
  source                VatFactSource
  evidenceRef           String?
  answeredAt            DateTime      @default(now())
  actorId               String?
  // A superseded fact stays on the table as history and is skipped by the accessor.
  supersededAt          DateTime?
  supersededByCommandId String?
  createdAt             DateTime      @default(now())

  company  Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commands CompanyVatRegistrationCommand[]

  @@unique([companyId, id])
  @@index([companyId, supersededAt, effectiveFrom])
}

// Ask-once-per-context prompt (§5.5). "Not sure" resolves the prompt WITHOUT creating a fact,
// so the status stays UNKNOWN and the user is not asked again in that context.
model VatRegistrationPrompt {
  id            String    @id @default(cuid())
  companyId     String
  context       String
  promptVersion Int       @default(1)
  promptedAt    DateTime  @default(now())
  resolvedAt    DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, context])
  @@index([companyId, resolvedAt])
}

// Reconciliation between Company and the deprecated CompanyTaxProfile, plus branch and VAT-hint
// drift (§16). The generator only ever writes rows here; every domain mutation goes through a
// resolver command with its own CAS, revision and audit.
model CompanyIdentityReconciliationItem {
  id                  String                    @id @default(cuid())
  companyId           String
  kind                ReconciliationKind
  // 'TAX_ID' / 'VAT_HINT' (one per company) or the duplicated taxBranchCode for BRANCH_DUP.
  discriminator       String
  sourceState         ReconciliationSourceState
  payloadMaskedJson   Json
  // Hash of what the generator actually read. A resolver command that no longer matches it is
  // stale and is refused rather than applied to changed data.
  sourceFingerprint   String
  status              ReconciliationStatus      @default(PENDING)
  resolutionCommandId String?
  resolutionJson      Json?
  resolvedByUserId    String?
  resolvedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  company   Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  revisions CompanyLegalIdentityRevision[]
  // A partial unique on (companyId, kind, discriminator) WHERE status = 'PENDING' is added by
  // raw SQL in the migration — Prisma cannot express a partial index. It allows at most one
  // PENDING row per key while RESOLVED rows accumulate, so a later drift inserts a NEW pending
  // row instead of reopening a resolved one and the resolve history stays append-only.

  @@unique([companyId, id])
  @@index([companyId, status, kind])
  @@index([status, kind])
}

// One row per COMPLETED issue. There is no IN_PROGRESS state: the row exists only if the whole
// issue transaction committed, so finding it is proof the work is done and can be replayed.
model AccountingDocumentIssueCommand {
  id                     String   @id @default(cuid())
  companyId              String
  commandId              String
  documentId             String
  actorUserId            String?
  payloadFingerprint     String
  resultDocumentNumber   String
  // Availability vector, same shape as ExecutionAttempt: EVERY entitlement epoch and EVERY
  // launch (gateKey, routeKey, generation) the mutation depended on, not just this feature's.
  entitlementEpochsJson  Json
  launchEntriesJson      Json
  availabilityVectorHash String
  // True for rows written between Release A and B1, while cap.company_tax_identity is not yet
  // registered. C1 reconciles this cohort against a frozen cutoff and never back-stamps it.
  preGateCutoff          Boolean  @default(false)
  completedAt            DateTime @default(now())

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document AccountingDocument @relation(fields: [companyId, documentId], references: [companyId, id])

  @@unique([companyId, commandId])
  @@index([companyId, documentId])
}

// Buyer identity evidence added to an ALREADY ISSUED tax invoice so a credit/debit note can be
// issued against it (§7.3). Append-only and no current pointer — current is max(revision).
// The original document is never edited: it left the building already.
model AccountingDocumentBuyerEvidenceRevision {
  id                    String                  @id @default(cuid())
  companyId             String
  documentId            String
  revision              Int
  commandId             String
  payloadFingerprint    String
  snapshotSchemaVersion Int                     @default(1)
  buyerSnapshotJson     Json
  evidenceRef           String
  changeKind            BuyerEvidenceChangeKind
  note                  String?
  reviewedByUserId      String?
  createdAt             DateTime                @default(now())

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document AccountingDocument @relation(fields: [companyId, documentId], references: [companyId, id])

  // Explicit names: the generated ones both truncate to the same identifier.
  @@unique([companyId, documentId, revision], map: "buyer_evidence_revision_company_document_revision_key")
  @@unique([companyId, documentId, commandId], map: "buyer_evidence_revision_company_document_command_key")
}

// Would-deny counter for the Release A log-only phase of type-specific issue permissions,
// and the observed half of report 1 (§17). Aggregate counts per hour bucket, written in their
// own short transaction so the issue preflight stays read-only against domain state. Holds
// companyId/roleKey on purpose: this is a system-admin table, not a tenant-anonymous launch bucket.
model AccountingIssueAuthzObservation {
  id                   String                 @id @default(cuid())
  companyId            String
  roleKey              String
  documentType         AccountingDocumentType
  missingPermissionKey String
  hourBucketUtc        DateTime
  count                Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, roleKey, documentType, missingPermissionKey, hourBucketUtc])
  @@index([hourBucketUtc])
}

// §8.3 (uat-correctness-latency): DB-backed NEUTRAL intake state for a financial clarification.
// The Redis ledger fails OPEN by design, so it may carry a bounded reference to a row here but is
// never the source of truth for money. Owner binding is the full triple (companyId, userId,
// chatKeyHash): a different chat, company or member can never resolve someone else's open state.
// `version` is the CAS token — resolve is a single conditional UPDATE, so a stale or expired
// version refuses instead of merging, and a store outage refuses instead of writing.
enum LineIntakeStateStatus {
  OPEN
  RESOLVED
  SUPERSEDED
  EXPIRED
}

model LineIntakeState {
  id                String                @id @default(cuid())
  companyId         String
  userId            String
  /// Hash of the chat the question was asked in (chatKeyHashOf) — never the raw LINE id.
  chatKeyHash       String
  targetIntent      String
  semanticOutcome   String?
  /// Grounded hints already accepted; merge rule 1 keeps them until an explicit correction.
  acceptedHintsJson Json?
  missingFields     String[]
  conflictingFields String[]
  /// Per-field origin (original vs follow-up turn) — bounded labels, never raw conversation.
  provenanceJson    Json?
  /// Hash of the originating webhook event/message, so a replay resolves the same row once.
  sourceEventHash   String
  version           Int                   @default(1)
  expiresAt         DateTime
  status            LineIntakeStateStatus @default(OPEN)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // NOTE: migration 20260826120000_line_intake_state also adds a PARTIAL unique index
  // "LineIntakeState_companyId_userId_chatKeyHash_open_key"
  // ON (companyId, userId, chatKeyHash) WHERE status = 'OPEN' — at most ONE open clarification
  // per owner. It is partial on purpose: terminal rows (RESOLVED/SUPERSEDED/EXPIRED) accumulate as
  // history, so a plain @@unique including `status` would reject the SECOND resolved row for the
  // same owner. Prisma cannot model partial indexes — do NOT let a future `prisma migrate diff`
  // drop it.
  @@index([companyId, userId, chatKeyHash, status])
  @@index([status, expiresAt])
}

// Transactional mail transport evidence. Never stores a token, body or credential.
model EmailSendAttempt {
  companyId          String?
  id                 String   @id @default(uuid())
  intentKey          String
  generation         Int
  purpose            String
  signupRequestId    String?
  provider           String
  providerServerId   Int
  stream             String
  recipient          String
  providerMessageId  String?
  status             String   @default("SENDING")
  possibleDuplicate  Boolean  @default(false)
  dispatchStartedAt  DateTime?
  historyArchivedAt  DateTime?
  errorCode          String?
  deadlineAt         DateTime?
  submittedAt        DateTime?
  deliveredAt        DateTime?
  suppressedAt       DateTime?
  nextRecoveryAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([intentKey, generation])
  @@unique([provider, providerServerId, providerMessageId])
  @@index([status, nextRecoveryAt])
  @@index([signupRequestId])
  @@index([provider, providerServerId, stream, createdAt, id], map: "EmailSendAttempt_monitor_history_idx")
}

// Scoped operational-history cleanup. Transport and audit evidence is retained.
model EmailHistoryPolicy {
  id                String   @id
  providerServerId  Int
  stream            String
  retentionDays     Int      @default(180)
  enabled           Boolean  @default(false)
  version           Int      @default(0)
  lastCleanupAt     DateTime?
  lastArchivedCount Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([providerServerId, stream])
}

model EmailSuppression {
  id               String @id @default(cuid())
  providerServerId Int
  stream           String
  recipient        String
  reason           String
  createdAt        DateTime @default(now())

  @@unique([providerServerId, stream, recipient])
}

// SaaS billing is separate from the customers' ERP invoices and payments.
model BillingPolicyRevision {
  id              String @id @default(uuid())
  stripeAccountId String
  livemode        Boolean
  version         Int
  state           String @default("DRAFT")
  policyJson      Json
  /// Promotion campaigns, `Record<campaignId, BillingPromotionCampaign>`. A sibling of `policyJson` so a binary
  /// that does not know campaigns still parses the policy (promotion plan R1). Null = no campaign.
  promotionJson   Json?
  createdByUserId  String
  approvedByUserId String?
  approvedAt      DateTime?
  createdAt       DateTime @default(now())

  @@unique([stripeAccountId, livemode, version])
}

model BillingSettings {
  id                String @id
  stripeAccountId   String
  livemode          Boolean
  version           Int @default(0)
  policyRevisionId  String?
  gatesJson         Json
  updatedAt         DateTime @updatedAt

  @@unique([stripeAccountId, livemode])
}

/// Additional company/mode boundary for delegated billing operators; system admins remain platform scoped.
model BillingOperatorScope {
  version         Int @default(0)
  updatedAt       DateTime @default(now()) @updatedAt
  id              String @id @default(uuid())
  userId          String
  stripeAccountId String
  livemode        Boolean
  companyId       String
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  createdByUserId String
  @@unique([userId, stripeAccountId, livemode, companyId])
}

model BillingAccount {
  id                  String @id @default(uuid())
  companyId           String
  stripeAccountId     String
  livemode            Boolean
  customerId          String?
  baseSubscriptionId  String?
  activeAttemptId     String?
  /// Add-on checkout slot (add-on spec T-02, §9.1): never read or written together with `activeAttemptId`,
  /// so an open add-on payment never blocks a package renewal, grace or command.
  activeAddOnAttemptId String? @unique
  activeEmailOperationId      String? @unique
  activeCollectionOperationId String? @unique
  collectionPauseJson Json?
  pendingPlanChangeId  String? @unique
  contractAttemptId   String?
  termProjectionHash  String?
  nextReconcileAt     DateTime @default(now())
  subscriptionState   String @default("NONE")
  renewalMode         String @default("NONE")
  billingAnchorDay    Int?
  cancelAtPeriodEnd   Boolean @default(false)
  paidThrough         DateTime?
  graceEndsAt         DateTime?
  nextChargeAt        DateTime?
  version             Int @default(0)
  observedAt          DateTime?
  leaseToken          String?
  leaseUntil          DateTime?
  // Purchase without setup (spec §18.2 §9, R-A4/R-A7): the company's document recipient is a column
  // this system owns, kept equal to the Stripe Customer email by the UPDATE_BILLING_EMAIL operation.
  // Billing values are String, not Prisma enums: ACCOUNT_EMAIL | CUSTOMER_OTP | STRIPE_CHECKOUT | ADMIN.
  recipientEmail            String?   @db.VarChar(320)
  recipientSource           String?
  recipientBouncedAt        DateTime?
  recipientBounceNotifiedAt DateTime?
  /// Address Stripe Checkout collected, kept as a document snapshot. Never written into Company (RV02/DQ5).
  checkoutAddressJson       Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  receiptGrants       BillingReceiptGrant[]
  receiptPlanTerms    CompanyPlanTerm[]
  subscriptionContracts BillingSubscriptionContract[]

  @@unique([id, companyId])
  @@unique([companyId, stripeAccountId, livemode])
  @@unique([stripeAccountId, livemode, customerId])
  @@unique([stripeAccountId, livemode, baseSubscriptionId])
  @@index([observedAt])
  @@index([recipientEmail])
}

/// Purchased, once-only trial carryover, or independently approved Admin units. Only a manual Admin grant has no paid account.
model BillingReceiptGrant {
  id                String @id @default(uuid())
  companyId         String
  billingAccountId  String?
  sourceKey         String
  sourceHash        String
  kind              String
  units             Int
  serviceStart      DateTime
  serviceEnd        DateTime
  availableAt       DateTime
  expiresAt         DateTime
  revokedAt         DateTime?
  policyRevisionId  String
  createdAt         DateTime @default(now())
  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  billingAccount    BillingAccount? @relation(fields: [billingAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  admissions        CompanyOcrUsageEvent[]
  unitEntries       ReceiptUnitEntry[]

  @@unique([id, companyId])
  @@unique([billingAccountId, sourceKey])
  @@index([companyId, billingAccountId, expiresAt])
}

/// Receipt image ledger (add-on spec §8.2, §15.3; plan PR B). Append-only: an admission RESERVEs one unit
/// of a lot, a usable result CONSUMEs it, a read with no usable result RELEASEs it, and an operator REVOKE
/// takes a lot's unused units. `operationKey` is the admission fence (`<sourceRoute>:<requestId>`), stable
/// when resume renews the event id; `generation` counts re-admissions of that operation after a release.
/// kind: RESERVE | CONSUME | RELEASE | REVOKE (String, no Prisma enum).
model ReceiptUnitEntry {
  id           String   @id @default(uuid())
  companyId    String
  grantId      String
  operationKey String
  generation   Int
  kind         String
  units        Int
  createdAt    DateTime @default(now())
  grant        BillingReceiptGrant @relation(fields: [grantId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([companyId, operationKey, generation, kind])
  @@index([grantId, kind])
}

/// One row per company per campaign per logical environment (promotion spec §6): the reservation, its use and
/// its release. The provider account is a binding, never part of the once-per-company identity (plan R12).
/// CHECKs live in migration 20261009120000 (Prisma cannot model them) — do NOT let `prisma migrate diff` drop them:
/// `_environment_check`, `_state_check` (RESERVED holds an attempt, CONSUMED an invoice, RELEASED no attempt).
model BillingPromotionRedemption {
  id                     String @id @default(uuid())
  /// 'LIVE' | 'TEST' — equals `livemode`.
  promotionEnvironmentId String
  campaignId             String
  companyId              String
  billingAccountId       String
  stripeAccountId        String
  livemode               Boolean
  /// 'RESERVED' | 'CONSUMED' | 'RELEASED'. `taken` = RESERVED + CONSUMED.
  state                  String
  policyRevisionId       String
  campaignRevision       Int
  termsHash              String
  offerKey               String
  interval               String
  offerSignature         String
  bonusMonths            Int
  bonusReceiptUnits      Int
  /// Cleared by a release; the released attempt's id lives in that release's audit row.
  attemptId              String? @unique
  invoiceId              String? @unique
  acceptedAt             DateTime
  /// acceptedAt + 10 minutes: the first Checkout dispatch must start before it.
  createBy               DateTime
  consumedAt             DateTime?
  benefitAppliedAt       DateTime?
  releasedAt             DateTime?
  entitlementAdjustedAt  DateTime?
  paidStart              DateTime?
  paidEnd                DateTime?
  bonusEnd               DateTime?
  releaseCount           Int @default(0)
  version                Int @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([promotionEnvironmentId, campaignId, companyId])
  @@index([promotionEnvironmentId, campaignId, state])
  @@index([companyId])
}

/// Immutable customer consent for recurring collection from a service boundary.
model BillingSubscriptionContract {
  revision          Int @default(autoincrement()) @unique
  id                String @id @default(uuid())
  billingAccountId  String
  sourceAttemptId   String
  effectiveAt       DateTime
  snapshotJson      Json
  createdAt         DateTime @default(now())
  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)

  @@unique([billingAccountId, sourceAttemptId])
  @@index([billingAccountId, effectiveAt])
}

model BillingQuote {
  id               String @id @default(uuid())
  companyId        String
  initiatingUserId String
  policyRevisionId String
  snapshotJson     Json
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  @@index([companyId, createdAt])
}

model BillingAttempt {
  id                String @id @default(uuid())
  billingAccountId  String
  initiatingUserId  String
  quoteId           String @unique
  channel           String
  idempotencyKey    String
  requestHash       String
  quoteSnapshot     Json
  /// PACKAGE | CHAT_CREDIT | RECEIPT_IMAGE (String, not a Prisma enum); equals the snapshot's kind.
  productKind       String @default("PACKAGE")
  policyRevisionId  String
  consentRevision   String
  consentAt         DateTime
  status            String @default("CREATING")
  checkoutSessionId String? @unique
  /// PackageChangeRequest.id when this Checkout is paying a sales deal (D-P3-9). The nightly
  /// EXPIRED sweep skips a deal that still has a live attempt, so a QR paid after the offer
  /// window closes still applies (S46). Mirrored from `quoteSnapshot.deal.requestId`.
  dealRequestId     String?
  collectionJson    Json?
  subscriptionId    String?
  errorCode         String?
  version           Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([billingAccountId, idempotencyKey])
  @@index([status, updatedAt])
  @@index([dealRequestId])
}

model BillingInvoice {
  id                String @id @default(uuid())
  billingAccountId  String
  providerInvoiceId String
  sourceAttemptId   String? @unique
  subscriptionId    String?
  providerNumber    String?
  offerSnapshot     Json
  contractSnapshot  Json?
  /// PACKAGE | CHAT_CREDIT | RECEIPT_IMAGE. Every package reader that orders by `periodEnd` filters PACKAGE;
  /// an add-on invoice also sets periodStart = periodEnd = paidAt (add-on spec §8.2, F-35).
  productKind       String @default("PACKAGE")
  policyRevisionId  String
  currency          String
  totalSatang       Int
  paidSatang        Int
  refundedSatang    Int @default(0)
  disputed          Boolean @default(false)
  financialObservedAt DateTime?
  taxSatang         Int @default(0)
  feeSatang         Int?
  providerChargeId  String?
  periodStart       DateTime
  periodEnd         DateTime
  /// Service end including a promotion's free time; null = `periodEnd`. Read through `invoiceServiceEnd()`
  /// only (promotion plan R2). The financial period above is never stretched.
  benefitEnd        DateTime?
  providerStatus    String
  evidenceHash      String
  applyStatus       String @default("PENDING")
  errorCode         String?
  appliedAt         DateTime?
  version           Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([billingAccountId, providerInvoiceId])
  @@index([applyStatus, updatedAt])
  @@index([billingAccountId, productKind, periodEnd])
}

model BillingProviderEvent {
  id              String @id @default(uuid())
  stripeAccountId String
  livemode        Boolean
  eventId         String
  eventType       String
  objectId        String
  apiVersion      String
  evidenceHash    String
  status          String @default("PENDING")
  leaseToken      String?
  leaseUntil      DateTime?
  attempts        Int @default(0)
  retryAt         DateTime @default(now())
  errorCode       String?
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  @@unique([stripeAccountId, livemode, eventId])
  @@index([status, retryAt])
}

model BillingIssue {
  id                String @id @default(uuid())
  stripeAccountId   String
  livemode          Boolean
  companyId         String?
  kind              String
  referenceId       String
  state             String @default("OPEN")
  assigneeUserId    String?
  backupUserId      String?
  priority          String @default("NORMAL")
  followUpAt        DateTime?
  slaStartedAt      DateTime?
  slaDueAt          DateTime?
  slaPolicyRevisionId String?
  episode           Int @default(1)
  lastSeenAt        DateTime @default(now())
  note              String?
  version           Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  resolvedAt        DateTime?
  @@unique([stripeAccountId, livemode, kind, referenceId])
  @@index([state, createdAt])
  @@index([stripeAccountId, livemode, state, followUpAt], map: "BillingIssue_scope_followUpAt_idx")
  @@index([stripeAccountId, livemode, state, slaDueAt], map: "BillingIssue_scope_slaDueAt_idx")
}

model BillingOperation {
  id                String @id @default(uuid())
  stripeAccountId   String
  livemode          Boolean
  companyId         String?
  type              String
  state             String @default("PREVIEW")
  referenceId       String?
  proposedJson      Json
  sourceVersion     Int
  version           Int @default(0)
  reason            String
  initiatorUserId   String
  approverUserId    String?
  idempotencyKey    String?
  requestHash       String
  expiresAt         DateTime
  scheduledFor      DateTime?
  leaseToken        String?
  leaseUntil        DateTime?
  errorCode         String?
  resultJson        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  observedAt        DateTime?
  @@unique([stripeAccountId, livemode, idempotencyKey])
  @@index([state, createdAt])
  @@index([stripeAccountId, livemode, state, scheduledFor], map: "BillingOperation_schedule_idx")
}

/// Public email access proof; deliberately separate from authenticated account email changes.
model EmailAccessChallenge {
  id                   String   @id
  email                String
  browserSecretHash    String
  requestKey           String   @unique
  codeHash             String
  keyVersion           String
  environment          String
  userId               String?
  securityBindingHash  String?
  status               String   @default("PENDING")
  failedAttempts       Int      @default(0)
  sendAttemptId        String?
  signupRequestId      String?
  expiresAt            DateTime
  verifiedAt           DateTime?
  usedAt               DateTime?
  createdAt            DateTime @default(now())
  @@index([email, createdAt])
  @@index([expiresAt])
}

model LineDeliveryPlan {
  id               String   @id
  outcomeId        String?  @unique
  ledgerDeliveryId String?  @unique
  outboxEventId    String?  @unique
  companyId        String?
  userId           String?
  version          Int      @default(2)
  planJson         Json
  planHash         String
  batchStateJson   Json
  status           String   @default("READY")
  leaseToken       String?
  leaseExpiresAt   DateTime?
  expiresAt        DateTime
  purgeAt          DateTime
  acceptedAt       DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  nextAttemptAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  outcome          LineTurnOutcome? @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  ledger           LineLedgerDelivery? @relation(fields: [ledgerDeliveryId], references: [id], onDelete: Cascade)
  outbox           OutboxEvent? @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, expiresAt])
  @@index([purgeAt])
  @@index([companyId, userId, createdAt])
}

// Platform-only team note; cascade cannot block company deletion, actor id has no FK.
model CompanyTeamNote {
  companyId       String   @id
  text            String   @db.VarChar(1000)
  version         Int      @default(0)
  updatedByUserId String
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// One live answer per starting month; historical answers are retained by supersession.
model WhtPayerModeFact {
  id                     String   @id @default(cuid())
  companyId              String
  mode                   String
  effectiveFromPeriodKey String
  answeredByUserId       String
  answeredAt             DateTime @default(now())
  supersededAt           DateTime?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, supersededAt, effectiveFromPeriodKey])
}

model ExpenseInputVatDecision {
  id String @id @default(uuid())
  companyId String
  expenseId String
  expense ExpenseRecord @relation(fields: [companyId, expenseId], references: [companyId, id], onDelete: Cascade)
  fromStatus InputVatClaimStatus
  toStatus InputVatClaimStatus
  reason String?
  conditionsJson Json
  evidenceAttachmentIds String[]
  decidedByUserId String
  decidedAt DateTime @default(now())
  @@index([companyId, expenseId, decidedAt])
}

/// Sales demo link (docs/specs/sales-demo-link-spec-th.md): only the token's sha256 is stored; one DEMO shop per link.
model DemoChatMessage {
  id             String   @id @default(cuid())
  companyId      String
  chatId         String
  direction      String
  messagesJson   Json
  webhookEventId String?
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Inbound association: a virtual reply token must resolve to exactly this chat.
  replyToken     String?  @unique
  deliveryKey    String?  @unique
  createdAt      DateTime @default(now())

  @@index([companyId, createdAt, id])
  @@index([webhookEventId])
}

model SalesDemoLink {
  aiCreditUnits   Int      @default(80)
  readLimit       Int      @default(3)
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  createdByUserId String
  expiresAt       DateTime
  companyId       String?  @unique
  openedAt        DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  createdBy User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
}
