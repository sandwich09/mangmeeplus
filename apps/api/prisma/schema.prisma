// P10 external-signup core. Public ingress remains absent until the owner chooses its signing and
// duplicate-identity policy. requestedOfferKey is attribution only; it grants no entitlement.
model CompanySignupRequest {
  id                     String             @id @default(cuid())
  source                 String             @default("official-site")
  externalSignupId       String             @unique
  payloadHash            String
  companyName            String
  taxId                  String?
  ownerDisplayName       String
  ownerFirstName         String?
  ownerLastName          String?
  // P10-L: nullable because a `line-oa` application never asks for an address. Flow B still
  // requires one at its own validator; the DB no longer pretends every source has a mailbox.
  contactEmail           String?
  intakePolicyVersion    String?
  emailProofVerifiedAt   DateTime?
  consentVersion         String
  referralCode           String?
  // Optional self-reported discovery; independent of the rail and influencer code.
  discoverySource        String?
  discoverySourceOther   String?            @db.VarChar(200)
  // D6: the sales code the applicant typed, and the ACTIVE agent it resolved to at submit.
  // An unresolvable code is refused at submit, so a stored code always had an owner.
  referralSalesCode      String?
  referralSalesUserId    String?
  requestedOfferKey      String?
  state                  CompanySignupState @default(RECEIVED)
  version                Int                @default(0)
  failureCode            String?
  businessType           String?
  phoneNumber            String?
  vatRegistered          Boolean?
  mxValid                Boolean?
  pendingPasswordHash    String?
  attachUserId           String?
  approvedAt             DateTime?
  approvedByUserId       String?
  // Review R09: when the CURRENT claim link's 30-day activation window started. Set at approve and
  // RESTARTED by an admin reissue; `approvedAt` stays the audit fact of when the decision was made,
  // so a reissued old approval is no longer expired again by the next sweep.
  claimWindowStartedAt   DateTime?
  claimEmailLastSentAt   DateTime?
  // SES MessageId of the last claim email. The only join key an SNS bounce/complaint event carries
  // back to this row (spec §4D); unique because SES never reuses a MessageId.
  latestClaimEmailAttemptId String?
  claimEmailSesMessageId String?            @unique
  claimReminderSentAt    DateTime?
  provisioningAttemptId  String?            @unique
  provisioningStartedAt  DateTime?
  companyId              String?
  ownerUserId            String?
  // ---- P10-L LINE-first signup (spec §5) ----
  // Identity of the LINE account that filled the LIFF form, proved by a server-verified ID token.
  // No picture column exists or may be added: DATA-MIN-01 stores the display name and nothing else.
  lineProviderUserId     String?
  lineChannelId          String?
  lineDisplayName        String?
  // Recovery/resolution: client intent and review outcome are durable facts. An existing-shop
  // target is deliberately separate from companyId, which only ever means "provisioned here".
  lineSignupIntent             String?
  contactEmailConflict         Boolean?
  reviewResolution             String?
  resolutionNote               String?
  resolvedExistingCompanyId    String?
  resolvedAt                   DateTime?
  resolvedByUserId             String?
  repeatTrialGrantedAt         DateTime?
  repeatTrialGrantedByUserId   String?
  repeatTrialGrantNote         String?
  sharedContactReviewedAt      DateTime?
  sharedContactReviewedByUserId String?
  sharedContactReviewNote      String?
  // Clickwrap evidence captured on LIFF and replayed into a LegalDocumentActionRecord at
  // provisioning (LEGAL-LIFF-01). Written once at submit; never edited afterwards.
  legalDocumentVersion          String?
  legalStatementSha256          String?
  legalReleaseFingerprintSha256 String?
  legalDisplayChallenge         String?
  legalLocale                   String?
  legalUserAgent                String?
  legalAcceptedAt               DateTime?
  // AUTO_FREE approved this with no admin in the loop; approvedByUserId stays null.
  autoApproved           Boolean            @default(false)
  adminReminderSentAt    DateTime?
  // P10-L §3.6: the one "กันหลุด" card is claimed by stamping this, so two sweeps queue one push.
  profileGuardNudgedAt   DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  company                Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner                  User?              @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  claimTokens AccountClaimToken[]

  @@index([state, updatedAt])
  @@index([contactEmail])
  @@index([taxId])
  @@index([companyId])
  @@index([ownerUserId])
  @@index([resolvedExistingCompanyId])
  @@index([lineChannelId, lineProviderUserId, state])
  // One open application per LINE account is enforced by a PARTIAL unique index that Prisma cannot
  // express; it lives in the migration SQL as
  // "CompanySignupRequest_line_open_key" ON ("lineChannelId","lineProviderUserId")
  //   WHERE "state" IN ('RECEIVED','VALIDATED','PENDING_REVIEW','PROVISIONING','PROVISIONING_FAILED','READY').
  // PROVISIONING_FAILED and READY are OPEN because a half-finished provisioning already owns the
  // identity; the list is mirrored in LINE_OPEN_APPLICATION_STATES and a spec asserts they agree.
}

/// P10-L §15.3 (H-01): a shop asking to move tier. Today an admin reads the row and changes the
/// tier through `PUT /system/partners/:id/plan-term` — the one place a tier may change. The payment
/// columns are the hook for P26/EasySlip: all nullable, none read by any code in this release.
model PackageChangeRequest {
  id                String    @id @default(cuid())
  companyId         String
  requestedByUserId String
  requestedTierKey  String
  status            String    @default("OPEN")
  note              String?
  decidedByUserId   String?
  decidedAt         DateTime?
  amountSatang      Int?
  offerSnapshotJson Json?
  paymentState      String    @default("NONE")
  paymentRef        String?
  slipAttachmentId  String?
  verifiedAt        DateTime?
  /// 'CUSTOMER_REQUEST' (the shop asking) | 'SALES_DEAL' (spec R3) | 'SPECIAL_INVOICE'.
  /// The default is what every row written before the sales console existed means.
  kind              String    @default("CUSTOMER_REQUEST")
  /// SALES_DEAL only: the agent who created it. Reports credit this user (§17.1).
  salesUserId       String?
  approvedByUserId  String?
  approvedAt        DateTime?
  /// approvedAt + SALES_DEAL_OFFER_DAYS. Past it the offer reads EXPIRED even before the sweep.
  offerExpiresAt    DateTime?
  rejectedReason    String?
  /// Team-visible note; never shown to the customer and never carries customer PII (S24).
  internalReason    String?
  /// Optimistic concurrency for every deal transition -> SALES_DEAL_STATE_CONFLICT.
  version           Int       @default(1)
  /// D2: a lead or SYSTEM_ADMIN approving their OWN deal. Recorded, not refused.
  selfApproved      Boolean   @default(false)
  /// D3/Phase 4: the APPLIED deal this renewal offer was cloned from. A renewal never writes
  /// attribution (§17.2 counts first activations only) and is what makes the sweep idempotent.
  renewalOfRequestId String?
  /// Phase 4: when the 7-days-left reminder went out, so it goes out exactly once.
  renewalRemindedAt DateTime?
  /// D-P5-3 (auto-renewing deals only): this shop's own recurring Stripe Price, created at
  /// approval and archived when the deal is cancelled, expires or returns to the catalog price.
  stripePriceId     String?
  stripePriceCreatedAt DateTime?
  /// 'PENDING' | 'READY' | 'FAILED'. Only READY may be quoted; the sales sweep retries the rest.
  priceState        String?
  /// D-P5-6: when the shop goes back to its base tier's catalog price. Set after the first cycle
  /// is applied (N-cycle deals) or when a lead ends an until-revoked deal.
  returnAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([kind, status])
  @@index([salesUserId])
  @@index([renewalOfRequestId])
  /// D-P5-3/D-P5-6: the two sweep queries — Prices still to create, and deals about to return.
  @@index([kind, priceState])
  @@index([returnAt])
  // One OPEN request per company, enforced by a PARTIAL unique index in the migration SQL:
  // "PackageChangeRequest_company_open_key" ON ("companyId") WHERE "status" = 'OPEN'.
  // Deal rows never take status 'OPEN', so they cannot consume that slot (S18). Their own
  // "one non-final deal per company" fence is a SECOND partial unique index in the same file:
  // "PackageChangeRequest_company_open_deal_key" ON ("companyId")
  //   WHERE "kind" = 'SALES_DEAL' AND "status" IN ('DRAFT','PENDING_APPROVAL','APPROVED').
}

/// Spec R12/S10 — what payroll needs to pay a มั่งมี sales agent and file a 50 ทวิ.
/// The three `*Encrypted` columns hold AES-256-GCM ciphertext (credential-cipher.logic.ts) and
/// are decrypted ONLY by the SYSTEM_ADMIN profile read and CSV export, both of which audit.
/// A team lead never sees them; no plaintext ever reaches a DTO, a log or audit metadata.
model SalesAgentProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  teamLeadUserId       String?
  /// 3–6 chars [A-Z0-9], what a customer types at signup. Stops resolving when SUSPENDED.
  salesCode            String    @unique
  /// Every payroll column is nullable: a team lead opens the account, the Owner fills the record.
  /// NULL means "not captured yet" — `hasProfile` on the DTO is exactly `legalName != null`.
  legalName            String?
  nationalIdEncrypted  String?
  taxIdEncrypted       String?
  address              String?
  bankName             String?
  bankAccountEncrypted String?
  whtRatePercent       Int       @default(3)
  /// 'ACTIVE' | 'SUSPENDED'. Suspending keeps the membership and the agent's deals readable.
  status               String    @default("ACTIVE")
  createdByUserId      String
  suspendedAt          DateTime?
  suspendReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([teamLeadUserId])
}

/// Who gets credited for a paid shop (spec §17.2, D-P3-10). ONE row per company, written the
/// first time a deal is applied; Phase 4 adds 'REFERRAL' rows and the report that reads them.
/// No Company relation on purpose: like every other billing record this row outlives the tenant
/// row it describes, and the report is financial history, not tenant data.
model SalesAttribution {
  id              String   @id @default(cuid())
  companyId       String   @unique
  salesUserId     String
  /// 'DEAL' (Phase 3) | 'REFERRAL' (Phase 4).
  source          String
  /// The credit, in satang: the package price the shop was charged, for a deal and a referral alike
  /// (owner 2026-10-02). REFERRAL rows written before that change hold the invoice total instead and
  /// are not rewritten.
  amountSatang    Int
  months          Int?
  interval        String?
  paidAt          DateTime
  /// Cumulative refund from before 2026-10-02, when a refund had no date of its own. The report
  /// still takes it off in the payment month, exactly as it did. Never written again: every later
  /// refund or lost dispute is a `SalesAttributionDeduction` row.
  refundedSatang  Int      @default(0)
  /// BillingInvoice.id of the paid one-time invoice that created this row.
  sourceInvoiceId String
  /// PackageChangeRequest.id of the deal, when `source` is 'DEAL'.
  dealRequestId   String?
  /// §17.1 anti-gaming: 'self_referral' | 'repeat_owner' | 'referral_anomaly'. A flagged row counts
  /// ZERO in every total until a SYSTEM_ADMIN reviews it; the row itself is never deleted.
  flags                String[] @default([])
  flaggedAt            DateTime?
  flagReviewedAt       DateTime?
  flagReviewedByUserId String?
  flagReviewNote       String?
  createdAt       DateTime @default(now())
  deductions      SalesAttributionDeduction[]

  @@index([salesUserId, paidAt])
  @@index([flaggedAt])
}

/// Sales credit taken back (spec §17.1, owner 2026-10-02): one row per refund that succeeded, or
/// per payment dispute that was lost, on the payment that opened the shop. The report shows each
/// as its own line in the Bangkok month of `createdAt`, so a month that is over never changes and
/// the payment month keeps its figure. CHECKs in the migration SQL (Prisma cannot model them, so do
/// NOT let a future `prisma migrate diff` drop them): kind IN ('REFUND','DISPUTE'), amountSatang > 0.
model SalesAttributionDeduction {
  id            String           @id @default(cuid())
  attributionId String
  /// 'REFUND' | 'DISPUTE'.
  kind          String
  /// The payment provider's own id of the refund or the dispute. Unique: seen twice, deducted once.
  providerRef   String           @unique
  /// Satang taken off the credit; never more than the credit that was left.
  amountSatang  Int
  /// The provider's time: when the refund was made, or when the dispute was opened. The 60 days
  /// run from the payment to this instant, never to the time this system noticed.
  occurredAt    DateTime
  /// When this system recorded it — the instant that decides the month it is deducted in.
  createdAt     DateTime         @default(now())
  attribution   SalesAttribution @relation(fields: [attributionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([attributionId])
}

// ── Executive report summary (executive backend spec §12.3). Written only by the report build
// (`executive-business` module): numbers, dates, dimension codes and internal ids. No person's
// name, e-mail, phone, search text or document content is ever stored here; a company's name and
// its owner's contact are read live when a report is answered. Every row can be rebuilt from the
// source tables, except the counters a rebuild keeps when source rows were deleted. No foreign key
// to Company on purpose: deleting a company must never delete what it paid.

/// One row per build round that wrote a data set. The newest row is the set every report answers from.
model ExecutiveReportBuild {
  id                 String    @id @default(cuid())
  /// 'HOURLY' (every profile, the current and the previous month) | 'FULL' (also every earlier month with data).
  kind               String
  definitionVersion  Int
  /// Version of the industry-group mapping used for the whole set.
  dimensionVersion   Int
  /// Every source was read up to this instant; a month still running ends here.
  asOf               DateTime
  startedAt          DateTime
  finishedAt         DateTime
  /// 'YYYY-MM' (Asia/Bangkok), the first and the last month this round wrote.
  firstMonth         String    @db.Char(7)
  lastMonth          String    @db.Char(7)
  companyCount       Int
  /// Companies with no report label at `asOf`, whatever month is asked for.
  unclassifiedCount  Int
  /// Where the latest time a successful provider balance scan covers ends; null = nothing was read yet.
  billingDataThrough DateTime?
  /// When the first billing account of the running mode was created: no online payment is older. Null = none yet.
  billingSince       DateTime?
  /// When each source began to keep rows in this database: its earliest row. Null = no row yet.
  aiUsageSince       DateTime?
  ocrUsageSince      DateTime?
  discoverySince     DateTime?

  @@index([asOf])
  @@index([definitionVersion, kind, asOf])
}

/// One row per month and definition version: what belongs to the month and to no single company.
model ExecutiveReportMonth {
  /// 'YYYY-MM', Asia/Bangkok.
  month                   String    @db.Char(7)
  definitionVersion       Int
  buildId                 String
  /// `asOf` of the build that wrote this row. Earlier than the month's end = the month was still running.
  asOf                    DateTime
  /// Where the unbroken cover of successful balance scans that starts at the month's first instant ends.
  /// Null, or earlier than the month's end = money of the month is not complete (BILLING_SCAN_NOT_COMPLETE).
  billingCoveredThrough   DateTime?
  /// Money not tied to a company (unmatched, or left for a manual check), dated in the month.
  untiedCount             Int       @default(0)
  untiedReceiptsSatang    Int       @default(0)
  untiedRefundsSatang     Int       @default(0)
  /// Signed sum of movements that are neither a charge nor a refund (a lost dispute, an adjustment).
  untiedOtherSatang       Int       @default(0)
  /// Refunds the scan read in a state other than succeeded: counted nowhere, kept as a number.
  unsuccessfulRefundCount Int       @default(0)
  /// The month began before the first build: its usage counters only hold rows that still existed then.
  beforeFirstBuild        Boolean   @default(false)
  /// Raised when a rebuild changes a figure of a month that had already ended.
  revision                Int       @default(0)
  revisedAt               DateTime?

  @@id([month, definitionVersion])
}

/// One row per company, month and definition version, for every company created before the month ended.
model ExecutiveCompanyMonth {
  companyId              String
  /// 'YYYY-MM', Asia/Bangkok.
  month                  String    @db.Char(7)
  definitionVersion      Int
  buildId                String
  /// The company's report label when this month was last built. The population of the month is CUSTOMER.
  reportClassification   String?
  // Money: movements the billing reader tied to this company, dated in the month by the provider.
  receiptsSatang         Int       @default(0)
  refundsSatang          Int       @default(0)
  feesSatang             Int       @default(0)
  taxSatang              Int       @default(0)
  /// { "<purchaseKind>": { receiptsSatang, refundsSatang, feesSatang, taxSatang } }, only kinds with money.
  moneyByPurchaseKind    Json
  /// Invoices paid in the month that are disputed at the provider right now.
  disputedInvoiceCount   Int       @default(0)
  /// AiUsageEvent.costSatang by `monthKey`, cost adjustments included.
  aiCostSatang           Int       @default(0)
  // Usage counters. A rebuild keeps the larger of the stored and the recounted value.
  activeDays             Int       @default(0)
  activeDaysLine         Int       @default(0)
  activeDaysWeb          Int       @default(0)
  activeUsers            Int       @default(0)
  activeUsersLine        Int       @default(0)
  activeUsersWeb         Int       @default(0)
  confirmedExpensesLine  Int       @default(0)
  confirmedExpensesWeb   Int       @default(0)
  issuedDocuments        Int       @default(0)
  aiRequests             Int       @default(0)
  expenseReceiptsLine    Int       @default(0)
  expenseReceiptsWeb     Int       @default(0)
  /// A stored counter was higher than the recount, so source rows are gone (SOURCE_ROWS_PURGED).
  countersHeld           Boolean   @default(false)
  /// Cumulative last counted action before this month’s cutoff; never today’s profile date for a past period.
  lastActivityAt         DateTime?
  activityHistorySince   DateTime?
  activitySnapshotReady  Boolean   @default(false)
  // Groups of the month (spec §13.2).
  /// 'YES' | 'NO' | 'UNKNOWN', as of the month's end.
  paidEver               String
  /// With UNKNOWN: BILLING_SOURCE_REVIEW | MANUAL_TERM_NO_RECEIPT | LEGACY_NO_TERM | BILLING_SCAN_NOT_COMPLETE.
  paidEverReason         String?
  fullyRefunded          Boolean   @default(false)
  /// 'NOT_STARTED' | 'INACTIVE' | 'ACTIVE' | 'NOT_PAID'; null = fully refunded, or not assessable.
  usageGroup             String?
  /// 'ACTIVITY_HISTORY_INCOMPLETE' | 'PAYMENT_HISTORY_INCOMPLETE' when the group cannot be assessed.
  usageUnassessedReason  String?
  // Sales credit of the month, by the sales module's own rules, as it stood at the build.
  salesCreditSatang      Int       @default(0)
  salesCreditActivations Int       @default(0)
  salesCreditWaiting     Int       @default(0)
  /// Raised when a rebuild changes a figure of this row after its month had ended.
  revision               Int       @default(0)
  revisedAt              DateTime?

  @@id([companyId, month, definitionVersion])
  @@index([month, definitionVersion, reportClassification])
}

/// One row per company: the dimensions as they are at the build, and the values of its whole life.
model ExecutiveCompanyProfile {
  companyId                   String    @id
  buildId                     String
  companyCreatedAt            DateTime
  companyStatus               String
  /// 'CUSTOMER' | 'TEST' | 'INTERNAL' | 'DEMO'; null = not classified. The platform company is always INTERNAL.
  reportClassification        String?
  /// Report industry group key; null = the shop has none (INDUSTRY_NOT_PROVIDED).
  industryGroup               String?
  /// 'ADMIN' (the admin's label) | 'MAPPING' (from the shop's business type).
  industryGroupSource         String?
  /// ThaiAddressMaster.provinceCode; null = the address names no known province.
  provinceCode                String?
  /// WEBSITE | IG | TIKTOK | FACEBOOK | SALES | OTHER | UNKNOWN | BEFORE_COLLECTION | ADMIN_CREATED.
  discovery                   String
  /// 'official-site' | 'line-oa' | 'ADMIN_CREATED' | 'UNKNOWN'.
  signupRail                  String
  /// 'KNOWN' | 'NONE' | 'UNKNOWN' | 'UNRESOLVED'.
  referrerKind                String
  referrerSalesUserId         String?
  /// 'SIGNUP_CODE' | 'ADMIN', only with a referrer.
  referralSource              String?
  creditedSalesUserId         String?
  /// 'COUNTED' | 'WAITING' | 'EXCLUDED', only with a credited seller.
  salesCreditState            String?
  salesCreditPaidAt           DateTime?
  /// 'ACTIVE' | 'TRIAL' | 'NO_PACKAGE' | 'EXPIRED' | 'ADMIN_HOLD' from planTermState().
  planState                   String
  planTierKey                 String?
  planEndsAt                  DateTime?
  /// 'YES' | 'NO' | 'UNKNOWN', as of the build.
  paidEver                    String
  paidEverReason              String?
  fullyRefunded               Boolean   @default(false)
  lifetimeReceiptsSatang      Int       @default(0)
  lifetimeRefundsSatang       Int       @default(0)
  /// Earliest and latest counted action ever found; a rebuild never moves them the wrong way.
  firstActivityAt             DateTime?
  lastActivityAt              DateTime?
  lastLineActivityAt          DateTime?
  lastWebEntryAt              DateTime?
  /// 'EVER' | 'NOT_ENTITLED' | 'UNKNOWN' | 'NEVER' (spec §13.4). EVER is never taken back.
  receiptAdoption             String
  /// Sum of the stored monthly receipt counts, not a recount.
  expenseReceiptCountLifetime Int       @default(0)
  /// Receipt dates, rolling windows and status counts as of build.asOf; null until a FULL build backfills.
  sheetFacts                  Json?
  businessTypeCode            String?
  businessTypeOther           String?
  activeMemberCount           Int       @default(0)
  branchCount                 Int       @default(0)

  @@index([reportClassification])
}

/// Sales-event discounts (docs/specs/sales-event-discounts-spec-th.md §6.1). A sales lead sets up a
/// batch; each assigned เซลล์ shows a 5-minute QR at the booth; whoever scans it through LINE gets one
/// ticket bound to that LINE identity. States are Strings (no Prisma enum, SD-T5) and every rule the
/// database can hold is a CHECK or a partial unique index in the migration SQL — Prisma cannot model
/// either, so do NOT let a future `prisma migrate diff` drop them. No switch: the batch itself is the
/// control (Owner 2026-09-29, spec SD-O10).
model SalesEventBatch {
  id                      String                 @id @default(cuid())
  /// "งาน": plain text that groups the report; there is no event record of its own.
  eventName               String
  batchName               String
  /// First-bill discount in satang, whole baht only. 0 = this batch gives no price discount.
  discountSatang          Int
  /// Credit for shops that already pay: AI credit in 0.01-credit units (add-on unitScale 100) and
  /// receipt images. Stored now, redeemed by SD-F. At least one of the three rewards is > 0 (CHECK).
  rewardChatCreditUnits   Int                    @default(0)
  rewardReceiptImageUnits Int                    @default(0)
  /// Counted over the batch's whole life: revoking, refunding or never using a ticket gives nothing back.
  issueCap                Int
  issuedCount             Int                    @default(0)
  /// Claim window [claimStartsAt, claimEndsAt), UTC. "ปิดรับแล้ว" is this window, not a state.
  claimStartsAt           DateTime
  claimEndsAt             DateTime
  /// { tiers: PaidTier[], intervals: ('month'|'year')[] } — which package cards the discount applies to.
  scopeJson               Json
  /// 'OPEN' | 'PAUSED' | 'SUSPENDED' (spec §6.2).
  state                   String                 @default("OPEN")
  /// +1 on every edit; a ticket freezes the revision it was issued under.
  revision                Int                    @default(1)
  /// Optimistic fence for every console command -> SALES_EVENT_BATCH_STALE. Claims never bump it.
  version                 Int                    @default(1)
  createdByUserId         String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  agents                  SalesEventBatchAgent[]
  qrTokens                SalesEventQrToken[]
  tickets                 SalesEventTicket[]

  @@index([state, claimEndsAt])
}

/// Who may show this batch's QR. Removing a เซลล์ keeps the row (`active = false`) so the tickets they
/// already handed out still count for them, and their QR stops working at once.
model SalesEventBatchAgent {
  batchId       String
  salesUserId   String
  active        Boolean         @default(true)
  addedByUserId String
  addedAt       DateTime        @default(now())
  removedAt     DateTime?
  batch         SalesEventBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([batchId, salesUserId])
  @@index([salesUserId, active])
}

/// One "แสดง QR" press. Only the SHA-256 of the 32-byte token is stored; the token itself lives in
/// the QR image and nowhere else. Valid until min(created + 5 minutes, claimEndsAt).
model SalesEventQrToken {
  id            String          @id @default(cuid())
  tokenHash     String          @unique
  batchId       String
  salesUserId   String
  batchRevision Int
  expiresAt     DateTime
  createdAt     DateTime        @default(now())
  batch         SalesEventBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, expiresAt])
}

/// "ส่วนลดจากงาน" — one per LINE identity per batch. Amounts, rewards, scope, expiry and the เซลล์ are
/// frozen at issue. Used once and one way only: `redeemedAs` DISCOUNT (a package payment) or CREDIT.
/// The LINE identity is kept for matching only and never leaves the API.
/// Partial unique in the migration SQL (Prisma cannot express it):
///   "SalesEventTicket_batch_company_key" ("batchId", "companyId") WHERE state IN ('RESERVED','USED')
/// One ticket per shop per event (SD-O12, any batch with the same eventName) is checked in the checkout transaction;
/// the lifetime "SalesEventTicket_company_discount_key" was dropped by 20260929190000_sales_event_discount_per_event.
model SalesEventTicket {
  id                      String          @id @default(cuid())
  /// 8 characters from an alphabet with no 0/O or 1/I — the number people quote.
  serial                  String          @unique
  batchId                 String
  batchRevision           Int
  salesUserId             String
  holderProvider          String          @default("LINE")
  holderChannelId         String
  holderProviderUserId    String
  discountSatang          Int
  rewardChatCreditUnits   Int
  rewardReceiptImageUnits Int
  scopeJson               Json
  expiresAt               DateTime
  /// 'ISSUED' | 'RESERVED' | 'USED' | 'REVOKED' (spec §6.3). Expired = ISSUED and expiresAt <= now.
  state                   String          @default("ISSUED")
  /// 'DISCOUNT' | 'CREDIT', null until the ticket starts being used.
  redeemedAs              String?
  companyId               String?
  attemptId               String?         @unique
  invoiceId               String?         @unique
  appliedDiscountSatang   Int?
  claimRequestKey         String
  redeemRequestKey        String?
  reservedAt              DateTime?
  usedAt                  DateTime?
  revokedAt               DateTime?
  revokedByUserId         String?
  revokeReason            String?
  version                 Int             @default(1)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  batch                   SalesEventBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, holderChannelId, holderProviderUserId])
  @@index([holderChannelId, holderProviderUserId, state])
  @@index([companyId, state])
}

model AccountClaimToken {
  id              String               @id @default(cuid())
  signupRequestId String
  tokenHash       String               @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime             @default(now())
  signupRequest   CompanySignupRequest @relation(fields: [signupRequestId], references: [id], onDelete: Cascade)

  @@index([signupRequestId])
  @@index([expiresAt])
}

// P29 — admin-managed plan limits and usage term (docs/specs/mangmee-company-plan-term-spec-th.md).
// A company WITHOUT a row is legacy/grandfathered: no expiry, no limits, until an admin sets one.
model CompanyPlanTerm {
  id                String    @id @default(cuid())
  companyId         String    @unique
  tierKey           String
  branchLimit       Int
  employeeLimit     Int
  monthlySlipLimit  Int
  /// Current approved temporary capacity only. Expiry derives the latest purchased baseline.
  capacityOverride Json?
  /// Null preserves legacy/trial monthly quota. Set only by verified billing apply.
  billingReceiptAccountId String?
  billingReceiptAccount BillingAccount? @relation(fields: [billingReceiptAccountId, companyId], references: [id, companyId], onDelete: Restrict)
  termStartAt       DateTime
  termEndsAt        DateTime
  warningDays       Int       @default(7)
  renewCount        Int       @default(0)
  lastRenewedAt     DateTime?
  termDisabledAt    DateTime?
  warn7SentAt       DateTime?
  warn3SentAt       DateTime?
  warn1SentAt       DateTime?
  expiredNotifiedAt DateTime?
  // P10-L §9: a LINE trial shop is capped harder for its first week than its tier allows, until an
  // admin marks it checked or the window passes. The effective cap is
  // min(monthlySlipLimit, warmupSlipLimit when now < warmupUntil) — enforced by the counter (L-A2).
  warmupUntil       DateTime?
  warmupSlipLimit   Int?
  /// 'YYYY-MM' (Asia/Bangkok) of the month whose quota notice already went out — exactly-once.
  quotaNoticeSentMonthKey String?
  /// Free source notice is separate from paid/trial notices.
  freeQuotaNoticeSentMonthKey String?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([termEndsAt])
}

// ---- Item 10A: Partner Management ----

enum CompanyCredentialKind {
  LINE_MESSAGING_API
  LINE_LOGIN
  LINE_LIFF
}

enum CompanyCredentialHealth {
  OK
  ERROR
  UNKNOWN
}

model CompanyFeatureEntitlement {
  id                         String   @id @default(cuid())
  companyId                  String
  featureKey                 String
  enabled                    Boolean  @default(false)
  updatedBySystemAdminUserId String?
  // Feature-decoupling spec CC1 (spec:51): this canonical entitlement row stores the
  // current epoch / last seq. `epoch` increments exactly once per real non-ON->ON
  // transition; `lastSeq` is the highest EntitlementTransition.seq for this key.
  // Both are CAS fences — `updatedAt` is NOT a fence (re-stamped by any toggle).
  epoch                      Int      @default(0)
  lastSeq                    Int      @default(0)
  // CC7 (spec:235-236): durable grandfather-cohort marker, value 'LEGACY', written by
  // the SYSTEM bootstrap command. Null = not a legacy-normalized grant. No expiry.
  grantOrigin                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureKey])
  @@index([companyId, enabled])
}

model CompanyAiConfiguration {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  modelId                    String? // null = inherit the platform default model (metering spec §6.8)
  monthlyBudgetSatang        Int? // null = inherit AI_MONTHLY_BUDGET_SATANG (metering spec §7.3)
  ocrEnabled                 Boolean  @default(true)
  ocrMonthlyLimit            Int? // null = unlimited; Platform Admin only (OCR governance spec §4)
  receiptQuotaEnforced       Boolean? // trial/manual plan override; null inherits startup; paid grants always enforce
  ocrConfigVersion           Int      @default(0) // monotonic CAS fence; increment only on real OCR config change
  // ── Split CHAT/OCR budget policy (remediation spec §12.4, ADR 0013 §3). Every existing company
  // stays SHARED. Old split columns remain informational there; the separate CHAT default is
  // enforced by the admission path. `budgetConfigVersion` is a CAS fence of its OWN, separate from
  // `ocrConfigVersion`, so an OCR count edit never invalidates an open budget page (and vice versa).
  budgetMode                 String   @default("SHARED") // 'SHARED' | 'SPLIT' (CHECK in the migration)
  chatMonthlyBudgetSatang    Int? // >= 0; 0 closes the CHAT bucket. null = not set
  ocrMonthlyBudgetSatang     Int? // >= 0; 0 closes the OCR bucket. null = not set
  salesDealChatCreditSatang  Int? // new sales-deal CHAT override; null = 80-credit default; never replaces admin settings
  salesDealChatCreditEndsAt  DateTime? // one-time deal expiry; null for auto-renew deals
  budgetConfigVersion        Int      @default(0)
  // `{ mode, chatMonthlyBudgetSatang, ocrMonthlyBudgetSatang, effectiveMonthKey }` for a policy
  // that starts in a FUTURE Bangkok month. It never replaces the active columns until its month
  // arrives — the resolver compares month keys, so no cron is involved.
  pendingBudgetPolicy        Json?
  /// Add-on spec §11: from this instant the company's AI credit runs on paid package cycles and lots
  /// (`AiCreditGrant`) instead of the calendar-month CHAT cap. Null = legacy. Written by the cutover
  /// tool (plan PR G) only; `aiCreditCutoverSource` says which cohort rule moved it.
  aiCreditCutoverAt          DateTime?
  aiCreditCutoverSource      String?
  updatedBySystemAdminUserId String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Per-company screen settings for web entrances (manual-expense-web-entry-flag spec §5.1).
// NOT an entitlement: nothing here grants or removes a permission, and no guard, LINE or billing
// code reads it. A row exists only once the system admin has set a value (or a seed wrote one);
// what a company WITHOUT a row reads as is decided in one place,
// `MANUAL_EXPENSE_WEB_ENTRY_WITHOUT_ROW`, so the flag has no database default on purpose.
model CompanyWebEntrySetting {
  id                         String   @id @default(cuid())
  companyId                  String   @unique
  manualExpenseEntryEnabled  Boolean
  disbursementVoucherEntryEnabled Boolean?
  version                    Int      @default(0) // monotonic CAS fence; increments only on a real change
  updatedBySystemAdminUserId String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// AI spend ledger (metering spec §7.3). One row per model call the gateway reported;
// `costSatang` is priced and satang-rounded at write time (§19d posture) so price/FX
// changes never rewrite history. Tokens stay the durable truth for re-auditing a row.
model AiUsageEvent {
  id                    String   @id @default(cuid())
  companyId             String
  monthKey              String // 'YYYY-MM', Asia/Bangkok
  sourceRoute           String // 'line-turn' | 'line-intake-route' | 'receipt-ocr'
  //                            | 'bank-statement-extract' | 'crm-<name>' | 'draft-generate'
  usageTag              String
  modelId               String
  ok                    Boolean
  inputTokens           Int
  outputTokens          Int
  cacheReadInputTokens  Int
  cacheWriteInputTokens Int
  costSatang            Int
  thbPerUsd             Decimal  @db.Decimal(10, 4) // the rate this row was priced at (spec §6.4)
  thbPerUsdSource       String // 'live-cache'|'fetched'|'stored'|'env-fallback' (spec §6.4 addendum)
  requestId             String?
  // ── D1 usage metadata (remediation spec §11.2). Plain strings like the columns above; all
  // nullable so legacy rows and an older API writer report UNKNOWN instead of being guessed at.
  // Deliberately NO execution/invocation unique fence here: attempt vs invocation vs transport
  // identity is defined in Phase E (§12.6), and a unique fence added now would turn a metering
  // REPLAY into a LOST usage write rather than a deduplicated one.
  requestKind           String? // 'TEXT' | 'IMAGE' | 'OTHER'; null = legacy/unknown
  budgetBucket          String? // 'CHAT' | 'OCR'; null = legacy/unknown
  // 'PROVIDER_REPORTED' | 'CONSERVATIVE_ESTIMATE' | 'OPERATOR_CHARGED_AT_BOUND' | 'COMPANY_ABSORBED'.
  // COMPANY_ABSORBED preserves internal cost, excluded from customer month/bucket aggregates.
  // The third is written ONLY by the operator hold-reconciliation path (hold spec §4.2); the
  // gateway's wire guard still accepts the two provider values only.
  usageBasis            String?
  eventKind             String   @default("MODEL_CALL") // 'MODEL_CALL' | 'COST_ADJUSTMENT'
  /** Unit rates/FX this row was priced at plus per-component satang incl. a `rounding` term, so
   *  the components sum EXACTLY to costSatang. Null on legacy rows: component cost is then
   *  UNAVAILABLE, never 0. History is never re-priced at today's rates. */
  pricingSnapshot       Json?
  /** COST_ADJUSTMENT only: the MODEL_CALL row whose evidence changed. */
  adjustsEventId        String?
  /** COST_ADJUSTMENT only: replay fence, so a re-sent correction cannot double-apply. */
  correctionKey         String?  @unique
  /** Phase E1b settlement fence: the provider invocation this row settles. NULL on every legacy
   *  and SHARED row, and NULLs never collide, so the unique index costs them nothing. */
  invocationKey         String?  @unique
  createdAt             DateTime @default(now())
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, monthKey])
  @@index([companyId, createdAt])
}

// Operational cache of the live THB/USD rate (spec §6.4) — a single row, id 'THB_USD'.
// It is not the audit trail: every `AiUsageEvent` carries the rate it was priced at, so this
// row only lets restarts and sibling instances converge without re-fetching.
model AiFxRate {
  id        String   @id // 'THB_USD'
  rate      Decimal  @db.Decimal(10, 4)
  source    String // the fetch URL host
  fetchedAt DateTime
}

// Platform-wide AI budget settings (spec §7.4). A single row, id 'platform'; when it is
// absent the AI_MONTHLY_BUDGET_SATANG* env values apply unchanged.
// One platform-wide presentation selection; only the public homepage consumes it.
model PublicHomeThemeSetting {
  id                         String   @id // 'homepage'
  event                      String
  version                    Int
  updatedBySystemAdminUserId String
  updatedAt                  DateTime @updatedAt
}

model PlatformAiBudgetConfig {
  id                         String   @id // 'platform'
  monthlyBudgetSatang        Int
  ceilingSatang              Int
  updatedBySystemAdminUserId String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// Running per-company monthly totals. The unique [companyId, monthKey] row serializes
// concurrent increments, so the upsert's post-increment values detect a threshold
// crossing exactly once. Int satang caps at ~฿21M/company/month — no BigInt needed.
model CompanyAiMonthlyUsage {
  id                    String   @id @default(cuid())
  companyId             String
  monthKey              String
  costSatang            Int      @default(0)
  callCount             Int      @default(0)
  inputTokens           Int      @default(0)
  outputTokens          Int      @default(0)
  cacheReadInputTokens  Int      @default(0)
  cacheWriteInputTokens Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, monthKey])
}

// Per-bucket slice of the month aggregate above (remediation spec §12.4, ADR 0013 §3). Written in
// the SAME transaction as `AiUsageEvent` + `CompanyAiMonthlyUsage` whenever the bucket is known —
// SHARED companies included — so a later SPLIT activation and the admin console read one aggregate
// instead of re-deriving bucket spend by scanning the event table.
model CompanyAiMonthlyBucketUsage {
  id         String   @id @default(cuid())
  companyId  String
  monthKey   String // 'YYYY-MM', Asia/Bangkok
  bucket     String // 'CHAT' | 'OCR'
  costSatang Int      @default(0)
  callCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, monthKey, bucket])
}

// One durable money hold per provider invocation a SPLIT company is about to make (spec §12.3/§12.6,
// ADR 0013 §3). `reserved` is always the live SUM of `upperBoundSatang` over the non-terminal rows
// of a company-month, read under the `ai-budget:<company>:<month>` advisory lock — there is no
// second counter that could drift away from these rows.
model AiBudgetReservation {
  id             String @id @default(cuid())
  companyId      String
  /** PINNED at reserve time. A chain that crosses Bangkok midnight still settles into this month. */
  monthKey       String
  bucket         String // 'CHAT' | 'OCR'
  /** The `resolveAiBudgetPolicy` revision this hold was admitted under, for reconciliation. */
  policyRevision String
  sourceRoute    String
  stepKind       String
  /** Stable per logical user attempt; never a transport request id, never a raw LINE id. */
  attemptKey     String
  /** `<attemptKey>#<stepKind>#<ordinal>` — the one execution identity money is charged against. */
  invocationKey  String @unique
  /** Priced from the declared bound, rounded UP to a whole satang for THIS invocation. */
  upperBoundSatang Int
  /** Model id, unit rates, FX + source, token bounds and attempts the bound was priced with. */
  pricingSnapshot  Json
  /** Server-derived D1 metadata pinned at reserve time ('TEXT'|'IMAGE'|'OTHER'), so a settlement
   *  driven by the gateway — which never classifies a request — is not recorded as UNKNOWN. */
  requestKind      String?
  status           String    @default("RESERVED") // RESERVED|DISPATCHED|SETTLED|UNRESOLVED|CANCELLED
  /** Fencing token: only the holder may cancel, so a stale owner's late compensation is a no-op. */
  ownerToken       String
  settledCostSatang Int?
  usageBasis        String? // 'PROVIDER_REPORTED' | 'CONSERVATIVE_ESTIMATE'
  evidenceJson      Json?
  /** Actual above hold: historical overrun alert; never an admission lock (owner 2026-10-19). */
  breach            Boolean   @default(false)
  /** The operator's acknowledgement of that breach (hold spec §4.2). `breach` keeps the historical
   *  fact; acknowledgement clears the operator alert only, with AuditLog recording who. No
   *  FK to User on purpose: nothing about an account may cascade into money history. */
  breachAcknowledgedAt       DateTime?
  breachAcknowledgedByUserId String?
  createdAt         DateTime  @default(now())
  dispatchedAt      DateTime?
  settledAt         DateTime?
  updatedAt         DateTime  @updatedAt
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, monthKey, status])
  @@index([companyId, monthKey, bucket, status])
}

/// One AI credit lot (add-on spec §5.1–§5.2, §6.1, §8.2). `units` counts 0.01 credit = 1 satang of
/// CHAT cost. A package cycle is an INCLUDED_CYCLE lot; added credit is ADD_ON_PAID / ADD_ON_ADMIN /
/// SALES_EVENT. Not a wallet: the balance is always `units + SUM(entries)` with a hold counting only
/// while its `AiBudgetReservation` is live, so there is no second counter to drift.
model AiCreditGrant {
  id               String    @id @default(cuid())
  companyId        String
  billingAccountId String?
  /// INCLUDED_CYCLE | ADD_ON_PAID | ADD_ON_ADMIN | SALES_EVENT (String, not a Prisma enum).
  sourceKind       String
  /// Idempotency of the source: `cycle:<cycleKey>`, or the seam's key for an added lot.
  sourceKey        String    @unique
  sourceHash       String
  units            Int
  availableAt      DateTime
  expiresAt        DateTime
  /// INCLUDED_CYCLE only: `<billingAccountId>:<cycleStart ISO UTC>` and PAID | RENEWAL_PENDING | CLOSED.
  cycleKey         String?
  cycleState       String?
  /// INCLUDED_CYCLE only: where the allowance came from (DEFAULT | SALES_DEAL | TOTAL_OVERRIDE | SPLIT_CHAT_CAP).
  allowanceSource  String?
  invoiceId        String?
  operationId      String?
  revokedAt        DateTime?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries          AiCreditEntry[]

  @@index([companyId, sourceKind, expiresAt])
}

/// Append-only AI credit ledger (add-on spec §8.2). `units` is the signed change to the lot's
/// available balance: RESERVE −hold (counts only while its reservation is live), CONSUME −used,
/// CORRECTION ±, FREEZE −, UNFREEZE +, REVOKE −. `reservationId` is a soft reference to
/// `AiBudgetReservation.id` (no FK: money history never cascades from a hold row).
model AiCreditEntry {
  id            String        @id @default(cuid())
  companyId     String
  grantId       String
  kind          String
  units         Int
  reservationId String?
  operationKey  String        @unique
  createdAt     DateTime      @default(now())
  grant         AiCreditGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, kind])
  @@index([reservationId])
}

// One row per OCR action admitted immediately before a provider call. The unique request fence
// makes a transport retry with the same request id unable to consume quota or call the provider twice.
model CompanyOcrUsageEvent {
  id          String   @id @default(cuid())
  companyId   String
  monthKey    String // 'YYYY-MM', Asia/Bangkok
  sourceRoute String // 'receipt-ocr-web' | 'receipt-ocr-line' | 'bank-statement-extract'
  requestId   String
  /// Null is the existing paid/trial/gift admission. Frozen for the life of this operation.
  quotaSource String?
  /// Only a usable result persisted by the owning route consumes the free monthly allowance.
  succeededAt DateTime?
  billingReceiptGrantId String?
  billingReceiptGrant BillingReceiptGrant? @relation(fields: [billingReceiptGrantId, companyId], references: [id, companyId], onDelete: Restrict)
  /// Add-on plan PR B: the `ReceiptUnitEntry.generation` this admission reserved. Null = no lot, or an
  /// admission from before the ledger, which still counts as used exactly as it always did.
  receiptUnitGeneration Int?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sourceRoute, requestId])
  @@index([companyId, monthKey, sourceRoute])
  @@index([companyId, monthKey, quotaSource, succeededAt])
  @@index([companyId, createdAt])
  @@index([billingReceiptGrantId])
}

// Serialized by the per-company/month advisory lock in the admission helper. This aggregate is
// the quota truth; OCR/model usage rows are deliberately not reused because one read can call models many times.
model CompanyOcrMonthlyUsage {
  id        String   @id @default(cuid())
  companyId String
  monthKey  String // 'YYYY-MM', Asia/Bangkok
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, monthKey])
}

model CompanyIntegrationCredential {
  id                         String                  @id @default(cuid())
  companyId                  String
  provider                   String                  @default("LINE")
  credentialKind             CompanyCredentialKind
  encryptedSecretJson        String
  secretVersion              Int                     @default(1)
  health                     CompanyCredentialHealth @default(UNKNOWN)
  lastValidatedAt            DateTime?
  rotatedAt                  DateTime?
  updatedBySystemAdminUserId String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  company                    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, credentialKind])
  @@index([companyId])
}

// Item 10A: WatchDog shared LINE OA platform-level credential (no company scope)
model PlatformLineCredential {
  id                   String                  @id @default(cuid())
  credentialKind       CompanyCredentialKind
  encryptedSecretJson  String
  secretVersion        Int                     @default(1)
  health               CompanyCredentialHealth @default(UNKNOWN)
  lastValidatedAt      DateTime?
  rotatedAt            DateTime?
  runtimePublishedAt   DateTime?
  inboundVerifiedAt    DateTime?
  updatedByAdminUserId String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([credentialKind])
}

// Item 10A: LINE user selected-company context for shared OA multi-company resolution
model LineCompanyContext {
  id         String   @id @default(cuid())
  lineUserId String
  companyId  String
  selectedAt DateTime @default(now())
  // P10-L §8: set by "ติดต่อเจ้าหน้าที่" so the assistant stays out of a thread a human is handling.
  // A timestamp rather than a flag, so it expires by itself and nobody has to remember to clear it.
  aiPausedUntil DateTime?
  updatedAt  DateTime @updatedAt

  @@unique([lineUserId])
  @@index([lineUserId])
}

enum LineSupportRequestStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// P10-L §8 delta (line-support-request-spec-th §2.1.3). "รับเรื่องแล้วค่ะ" used to be a sentence
/// with nothing behind it: the notice went to whoever happened to have LINE linked (in UAT and
/// production, nobody) and the outbox row still finished PUBLISHED. This row is the fact — who
/// asked, which shop they are in NOW (re-derived from the ACTIVE identity, never from the stale
/// `LineCompanyContext`), how many admins were actually reached, and whether anyone answered.
model LineSupportRequest {
  id                 String                   @id @default(cuid())
  /// Null only when the asker has no company at all: no ACTIVE membership anywhere, no LOCKED one
  /// either, and no signup travelling — the unlinked prospect who is exactly the person most likely
  /// to need a human. A LOCKED shop (no package, or disabled) still fills this in with that shop's
  /// id (review 2026-09-29, `resolveSupportAsker`/`lockedCompanyFor`): the ticket must name the shop
  /// an operator has to call, not read as though nobody had ever opened one.
  companyId          String?
  /// Raw, like `LineCompanyContext.lineUserId`: clearing that row's pause from /system needs the
  /// real id. The web contract never returns it — §3 PDPA — only `lineUserIdHash`.
  lineUserId         String
  /// `shortLineIdHash` / `hashMessagePreview` (sha256 hex, 16 chars) — the same fingerprint the
  /// audit rail and the support-notice outbox already carry, so /system can name a person safely.
  lineUserIdHash     String
  /// The pending application this asker is travelling on, when there is one: the queue is then the
  /// page an operator can actually act on.
  signupRequestId    String?
  /// Where the ask started (R-E5): 'attempt' | 'invoice'. Strings like `closedReason`; staff-only — never returned to LINE.
  referenceKind      String?
  referenceId        String?
  requestedAt        DateTime                 @default(now())
  /// ≤200 chars of the question that was on the screen when they tapped (§3). IMMUTABLE: it is the
  /// thing an operator is answering, and a nudge ("มีอัปเดตไหมคะ") or an unrelated receipt photo
  /// used to overwrite it. Dropped with the row.
  requestText        String?
  /// ≤200 chars of the newest customer TEXT, when the assistant kept it (§3). Rewritten every time
  /// they write again while the request is live. A photo never lands here — it stamps
  /// `lastMediaAt` instead — and this is dropped with the row.
  lastMessageText    String?
  /// When that newest customer message arrived. Named as on `CrmConversation`, and NOT nullable
  /// here: the tap itself is a message, so every row has one and the inbox can order by it without
  /// a nulls-first surprise. `requestedAt` still says when they FIRST asked; `updatedAt` cannot
  /// serve, because the notify drain and both admin buttons move it too.
  lastMessageAt      DateTime                 @default(now())
  /// When a photo or a document last arrived on this thread. §3 keeps the bytes out of the table
  /// entirely, so the operator gets the FACT ("📷 ส่งรูปมา") and nothing else — and the words the
  /// customer typed are not destroyed by a picture that may just be an ordinary receipt.
  lastMediaAt        DateTime?
  /// How many times an ANSWERED request came back because the customer wrote again (UAT
  /// 2026-09-06). `answeredAt`/`answeredByUserId` stay as the history of the last answer; this is
  /// what lets the inbox say "ตอบแล้ว N ครั้ง · ลูกค้าตอบกลับ".
  reopenedCount      Int                      @default(0)
  /// Successful LINE pushes to admins, counted at delivery. Owner 2026-09-05: admins are NOT
  /// LINE-linked, so `0` is the expected reading — the /system inbox is the primary channel and
  /// this row exists whether or not any push landed.
  lineNotifiedCount  Int                      @default(0)
  /// The support-mailbox letter went out. Best effort: an unconfigured mailer leaves this false
  /// and blocks nothing.
  emailSent          Boolean                  @default(false)
  /// When the outbox drain finished trying every channel. NULL means it has not run yet, which is
  /// the difference between "nobody could be told" and "we have not tried yet" — without it the
  /// inbox showed a red "แจ้งไม่สำเร็จ" for the seconds between the tap and the drain.
  notifiedAt         DateTime?
  status             LineSupportRequestStatus @default(OPEN)
  answeredAt         DateTime?
  answeredByUserId   String?
  /// The system operator currently responsible for this case. Kept as an id without a relation so
  /// deleting/deactivating an operator cannot delete or rewrite the support record.
  assignedToUserId   String?
  assignedAt         DateTime?
  assignmentNote     String?
  /// One logical LINE reply operation. The UUID is reused with LINE while the same payload is retried.
  replyOperationId   String?
  replyTextHash      String?
  replyFirstAttemptAt DateTime?
  /// Latest bounded staff reply, so an unknown delivery can retry the exact payload after reload.
  /// This is case data with the same retention as the customer's bounded support text.
  lastReplyText      String?
  /// Snapshot used to reconstruct the exact signed body when another operator retries the attempt.
  lastReplySenderName String?
  /// `PENDING` | `SENT` | `FAILED`; kept as a string so the existing request-status enum stays stable.
  lastReplyDeliveryStatus String?
  lastReplyError     String?
  closedAt           DateTime?
  /// `admin` | `customer_resumed` | `expired` | `resolved`
  closedReason       String?
  resolvedByUserId   String?
  resolutionNote     String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  /// v3 (Owner 2026-09-20): everything said on this case, in order — the chat the inbox shows.
  messages           LineSupportMessage[]

  @@index([status, requestedAt])
  /// The inbox reads and the expiry sweep both moved to `lastMessageAt` (UAT 2026-09-06), so the
  /// index on `requestedAt` no longer serves either — it stays for the 90-day purge's ordering.
  @@index([status, lastMessageAt])
  @@index([status, lastMessageAt, id])
  @@index([lineUserId, status])
}

/// v3 (Owner 2026-09-20, line-support-request-spec-th สัญญา v3 ข้อ 9). The conversation behind one
/// support request, from the tap that opened it to the resolve that closed it. One row per thing
/// somebody said — a customer sentence, a customer photo/document, or a staff reply — so the inbox
/// can show the case as a chat instead of two 200-character summaries. Dropped WITH the request
/// (cascade), so the 90-day purge of a CLOSED case still deletes everything the customer sent,
/// bytes included, without a second sweep.
model LineSupportMessage {
  id             String                  @id @default(cuid())
  requestId      String
  /// `CUSTOMER` | `STAFF`. Strings, like `closedReason`: the request-status enum stays stable.
  direction      String
  /// `TEXT` | `IMAGE` | `FILE`
  kind           String
  /// ≤2000 chars. A customer's FULL sentence (the request row keeps its 200-char summary); for
  /// staff, the bounded reply exactly as the LINE push carried it.
  text           String?
  /// STAFF only: the display name the push was signed with, snapshotted at send time.
  senderName     String?
  senderUserId   String?
  /// The LINE message this row came from, so a redelivered webhook cannot append it twice. Never
  /// crosses the web contract (§3).
  lineMessageId  String?
  /// STAFF only: the reply operation, so a same-key retry updates THIS row instead of adding one.
  operationId    String?
  /// STAFF only: `PENDING` | `SENT` | `FAILED`, mirrored from the request's reply operation.
  deliveryStatus String?
  mediaMimeType  String?
  mediaByteSize  Int?
  mediaFileName  String?
  /// IMAGE/FILE whose bytes could not be kept: `media_fetch_failed` (LINE content gone, too large,
  /// no token), `media_security_rejected`, `media_scan_failed`. The bubble says so instead of
  /// showing nothing.
  mediaError     String?
  createdAt      DateTime                @default(now())
  request        LineSupportRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  blob           LineSupportMessageBlob?

  @@unique([requestId, lineMessageId])
  @@unique([requestId, operationId])
  @@index([requestId, createdAt])
}

/// The bytes of one customer photo/document, split off so a thread read never drags them along.
/// Postgres rather than an object store for the same reason `AttachmentBlob` is: the only store
/// that survives redeploys today. Writers cap rows at UPLOAD_MAX_BYTES through the media lane's
/// existing download limit.
model LineSupportMessageBlob {
  messageId String             @id
  data      Bytes
  createdAt DateTime           @default(now())
  message   LineSupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

