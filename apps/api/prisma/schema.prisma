model AttachmentObject {
  id                                 String                            @id @default(cuid())
  companyId                          String
  branchId                           String?
  storageProvider                    String
  bucket                             String
  objectKey                          String
  objectVersionId                    String?
  originalFileName                   String
  mimeType                           String
  byteSize                           Int
  checksumSha256                     String?
  perceptualHash                     String?
  visibility                         AttachmentVisibility              @default(INTERNAL)
  status                             AttachmentStatus                  @default(PENDING_UPLOAD)
  uploadedByUserId                   String
  uploadedAt                         DateTime?
  deletedAt                          DateTime?
  metadataJson                       Json?
  createdAt                          DateTime                          @default(now())
  updatedAt                          DateTime                          @updatedAt
  company                            Company                           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  links                              AttachmentLink[]
  // Array on purpose: `ExpenseCaptureFile.attachmentId @unique` already limits this to one row,
