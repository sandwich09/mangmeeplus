// Typed audit actor (CUST-01): automated/customer flows must never write a literal
// 'system' or a CrmCustomer id into the User FK. actorUserId is only set for USER;
// customer/service actors carry a stable non-PII reference in actorRefId.
enum AuditActorType {
  USER
  SYSTEM
  CRM_CUSTOMER
  SERVICE
}

model AuditLog {
  id           String         @id @default(cuid())
  companyId    String?
  actorType    AuditActorType @default(USER)
  actorUserId  String?
  actorRefId   String?
  action       String
  targetType   String
  targetId     String?
  requestId    String
  result       AuditResult
  riskLevel    AuditRiskLevel @default(LOW)
  metadataJson Json?
  createdAt    DateTime       @default(now())
  company      Company?       @relation(fields: [companyId], references: [id])
  actor        User?          @relation(fields: [actorUserId], references: [id])

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([companyId, actorUserId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([requestId])
}

// One platform-wide customer access switch. Missing/unreadable state fails CLOSED in production;
// maintenance_only also overrides this row CLOSED so an operator cannot open a partial runtime.
model PlatformAccessControl {
  id                         String              @id
  state                      PlatformAccessState @default(CLOSED)
  updatedBySystemAdminUserId String?
  reason                     String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
}

model OutboxEvent {
  id            String              @id @default(cuid())
  companyId     String?
  eventType     String
  aggregateType String
  aggregateId   String
