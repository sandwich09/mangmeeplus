model User {
  id                      String                   @id @default(cuid())
  displayName             String
  username                String?                  @unique
  email                   String?                  @unique
  emailVerifiedAt         DateTime?
  emailRevision           Int                      @default(0)
  emailLoginEnabledAt     DateTime?
  phoneNumber             String?
  status                  UserStatus               @default(ACTIVE)
  isSystemProtected       Boolean                  @default(false)
  // PDPA objection route (M-05 register §3.1): set = this user opted out of the LINE
  // AI assistant; the webhook use-case refuses before any model/gateway involvement.
  aiAssistantOptOutAt     DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  credential              UserCredential?
  externalIdentities      ExternalIdentity[]
  lineReadEvidence        LineReadEvidence[]
  lineLedgerDeliveries    LineLedgerDelivery[]
  lineDocumentQaJobs      LineDocumentQaJob[]
  salesDemoLinks          SalesDemoLink[]
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  memberships             CompanyMembership[]
  auditLogs               AuditLog[]
  // Item 10A
  ownedOnboardingRuns     CompanyOnboardingRun[]   @relation("OwnedOnboardingRuns")
  createdOnboardingRuns   CompanyOnboardingRun[]   @relation("CreatedOnboardingRuns")
  signupRequestsOwned     CompanySignupRequest[]
  // Item 10C
  employeeAccessProfiles  EmployeeAccessProfile[]
  reimbursementDraftActions ReimbursementDraftAction[]
  // Spec §4F account merge (both sides of one ticket).
  mergeTicketsAsNew       AccountMergeTicket[]     @relation("AccountMergeTicketNewUser")
  mergeTicketsAsExisting  AccountMergeTicket[]     @relation("AccountMergeTicketExistingUser")

  // `username @unique` above is a plain B-tree and therefore case-sensitive. Both username
  // uniqueness reads (AccountProfileUseCase, CreateEmployeeUseCase) compare
  // `lower("username")`, which that index cannot serve, so an EXPRESSION index Prisma cannot
  // express lives in the migration SQL as
  // "User_username_lower_idx" ON "User" (lower("username")).
  // It is deliberately NOT unique yet — see docs/runbooks/username-case-uniqueness-followup.md.
}

model UserCredential {
  id                    String           @id @default(cuid())
  userId                String           @unique
  passwordHash          String
  status                CredentialStatus @default(ACTIVE)
  mustChangePassword    Boolean          @default(false)
  // Encrypted copy (AES-256-GCM) of the current system-generated temporary password,
  // revealable by system admins until the user changes the password themselves.
  tempPasswordEncrypted String?
  expiresAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

model AuthSession {
  id              String            @id @default(cuid())
  emailReauthenticatedAt DateTime?
  emailReauthBindingHash String?
  emailReauthNonceHash String?
  emailReauthExpiresAt DateTime?
  billingReauthenticatedAt DateTime?
  billingCredentialVersion DateTime?
  // Snapshot of the credential that a password login just verified. It may complete a forced
  // password change without asking for the same temporary password again.
  passwordCredentialVersion DateTime?
  userId          String
  tokenId         String            @unique
  // L-01: the immediately-previous refresh token id and the instant it was rotated out.
  // Unique so a replayed token can be resolved to its family in one lookup; the pair is
  // what distinguishes a benign concurrent refresh from refresh-token reuse.
  previousTokenId String?           @unique
  // L-01: the token family. Minted with the session, carried unchanged through every rotation,
  // and echoed as the refresh token's `fid` claim — so a token several generations stale still
  // resolves to its family and is caught as reuse. NULL on sessions issued before this column;
  // that is an *unknown* family and must never match, which the nullable unique index gives us.
  familyId        String?           @unique
  rotatedAt       DateTime?
  status          AuthSessionStatus @default(ACTIVE)
  issuedAt        DateTime          @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

// Append-only clickwrap evidence. User/company/membership ids are immutable snapshots rather than
// cascading relations so an account offboarding cannot silently erase evidence needed for a legal
// claim. Any future erasure workflow must explicitly decide whether to retain, pseudonymize or
// delete these rows under the applicable legal basis.
model LegalDocumentActionRecord {
  id                       String                  @id @default(cuid())
  batchId                  String
  documentType             LegalDocumentType
  action                   LegalDocumentAction
  scopeRef                 String
  documentVersion          String
  artifactUrl              String
  releaseFingerprintSha256 String
  statementVersion         String
  statementText            String
  statementSha256          String
  acceptedByUserId         String
  companyId                String
  membershipId             String
  actorCapacity            LegalAcceptanceCapacity
  rolesJson                Json
  authProvider             String
  // P10-L: null when the acceptance happened before any session existed — the LIFF signup clickwrap
  // is replayed into this table during provisioning, when nobody has logged in yet.
  sessionTokenId           String?
  requestId                String
  locale                   String
  displayChallenge         String
  surface                  LegalAcceptanceSurface
  userAgent                String?
  acceptedAt               DateTime                @default(now())
  createdAt                DateTime                @default(now())

  @@unique([scopeRef, documentType, documentVersion, action])
  @@index([acceptedByUserId, acceptedAt])
  @@index([companyId, acceptedAt])
  @@index([membershipId, acceptedAt])
  @@index([batchId])
}

// Operator-controlled PDPA/offboarding case. Target identifiers are immutable scalar snapshots
// rather than cascading relations: the case must survive the deletion it evidences. The record is
// deliberately orchestration-only; it never performs a hard delete by itself.
model DataRightsCase {
  id                          String                       @id @default(cuid())
  requestKey                  String                       @unique
  caseType                    DataRightsCaseType
  status                      DataRightsCaseStatus         @default(RECEIVED)
  requestSource               DataRightsRequestSource
  requesterContactHash        String?
  targetUserId                String?
  companyId                   String?
  membershipId                String?
  receivedAt                  DateTime                     @default(now())
  dueAt                       DateTime
  createdByUserId             String
  identityVerifiedAt          DateTime?
  identityVerifiedByUserId    String?
  authorityVerifiedAt         DateTime?
  authorityVerifiedByUserId   String?
  approvedAt                  DateTime?
  approvedByUserId            String?
  executionStartedAt          DateTime?
  executionStartedByUserId    String?
  verificationStartedAt       DateTime?
  verificationStartedByUserId String?
  completedAt                 DateTime?
  completedByUserId           String?
  outcomeSummary              String?
  // P31 §8 single-admin mode: each pair marks a step that the person who took the previous step
  // took again, as an explicit self-step with a reason, while the platform had one active System
  // Admin. Two CHECK constraints keep the marker equal to "same person" and tied to its reason;
  // the transition trigger refuses a same-person step without them.
  approvalSingleAdmin         Boolean                      @default(false)
  approvalSingleAdminReason   String?
  executionSingleAdmin        Boolean                      @default(false)
  executionSingleAdminReason  String?
  verificationSingleAdmin     Boolean                      @default(false)
  verificationSingleAdminReason String?
  completionSingleAdmin       Boolean                      @default(false)
  completionSingleAdminReason String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  decisions                   DataRightsDecisionRecord[]
  evidence                    DataRightsEvidenceRecord[]
  actions                     DataRightsCaseActionRecord[]

  @@index([status, dueAt])
  @@index([targetUserId, createdAt])
  @@index([companyId, createdAt])
  @@index([membershipId, createdAt])
}

// Append-only decision revisions. A correction creates the next revision; it never rewrites the
// historical legal/retention decision that an operator previously saw or approved.
model DataRightsDecisionRecord {
  id                String                     @id @default(cuid())
  caseId            String
  revision          Int
  category          DataRightsDecisionCategory
  disposition       DataRightsDisposition
  legalBasisCode    String
  rationale         String
  retentionUntil    DateTime?
  accessRestriction String?
  recordedByUserId  String
  recordedAt        DateTime                   @default(now())
  case              DataRightsCase             @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, category, revision])
  @@index([caseId, category, recordedAt])
}

// References only — never store passwords, OTPs, identity-document images or raw export bytes in
// this table. `reference` points to a restricted evidence store/run output and `sha256` binds it.
model DataRightsEvidenceRecord {
  id               String                      @id @default(cuid())
  caseId           String
  evidenceType     DataRightsEvidenceType
  category         DataRightsDecisionCategory?
  reference        String
  sha256           String?
  note             String?
  recordedByUserId String
  recordedAt       DateTime                    @default(now())
  // P31 §8: independent verification recorded by the executor as an explicit self-step.
  singleAdmin      Boolean                     @default(false)
  singleAdminReason String?
  case             DataRightsCase              @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, evidenceType, recordedAt])
}

// Append-only command journal. commandId is the idempotency boundary for every state transition.
model DataRightsCaseActionRecord {
  id           String                @id @default(cuid())
  caseId       String
  commandId    String                @unique
  action       String
  fromStatus   DataRightsCaseStatus?
  toStatus     DataRightsCaseStatus?
  actorUserId  String
  requestId    String
  metadataJson Json?
  createdAt    DateTime              @default(now())
  case         DataRightsCase        @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([actorUserId, createdAt])
}

model EmailVerificationToken {
  id        String                  @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String                  @unique
  status    VerificationTokenStatus @default(PENDING)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                @default(now())
  proofKind String                  @default("LINK")
  failedAttempts Int                @default(0)
  emailRevision Int?
  securityBindingHash String?
  sessionId String?
  keyVersion String?
  sendAttemptId String?
  requestKey String?
  requestFingerprint String?
  /// Set only for proofKind BILLING_RECIPIENT: the company whose document recipient this code changes (R-A8).
  companyId String?
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@unique([userId, requestKey])
  @@index([newEmail, createdAt])
  @@index([companyId, proofKind, status])
}

model PasswordResetToken {
  id        String                  @id @default(cuid())
