// มั่งมี Flow A (spec D8): online booking / appointment calendar.
// customerId is the canonical CRM identity for every confirmed booking. customerName
// remains a display snapshot. staffUserId/sourceConversationId stay scalar references.
// staffUserId is canonically a User id (CompanyMembership.userId), NOT an
// EmployeeAccessProfile id — reminder notifications, membership branch lookups, and
// channel defaultBookingStaffUserId all key on the User space (backfill:
// 20260712120000_crm_booking_staff_user_id_backfill).
enum CrmBookingStatus {
  BOOKED
  CANCELLED
  DONE
  NO_SHOW
}

