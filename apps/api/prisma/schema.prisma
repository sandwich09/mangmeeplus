  importId              String?
  sourceType            BankStatementLineSource         @default(IMPORT)
  rowNumber             Int?
  lineHash              String
  postedDate            DateTime
  valueDate             DateTime?
  description           String
  normalizedDescription String?
  counterpartyName      String?
  bankReference         String?
  chequeNumber          String?
  direction             BankStatementLineDirection
  signedAmount          Decimal                         @db.Decimal(18, 4)
  debitAmount           Decimal?                        @db.Decimal(18, 4)
  creditAmount          Decimal?                        @db.Decimal(18, 4)
