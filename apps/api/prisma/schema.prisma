/// Income-side category master (income-expense-ledger spec F-LED-2). Deliberately
/// COMPANY-SCOPED ONLY — no global (NULL companyId) rows: the expense-side union of global +
/// per-company defaults produced near-duplicate pickers, and `@@unique([companyId, name])`
/// cannot fence NULL rows (Postgres NULL-distinct; LED-FIN-03). With companyId NOT NULL the
/// unique below is a real fence, which also makes bootstrap idempotent via skipDuplicates.
model RevenueCategory {
  id                            String                   @id @default(cuid())
  companyId                     String
  name                          String
  accountHintKey                String
  /// Reviewed ledger account code this category credits when its revenue posts. Null = nothing
  /// bound and posting keeps using the default revenue account; `accountHintKey` above is a
  /// suggestion and deliberately NOT posting authority — same seam as ExpenseCategory.
  ledgerAccountCode             String?
  ledgerAccountReviewedByUserId String?
  ledgerAccountReviewedAt       DateTime?
  /// Suggested OUTPUT Tax Code as its stable external code (e.g. "O7"), never a
  /// TaxCodeDefinition id — that row is one dated version and an FK would pin it.
  defaultOutputTaxCode          String?
  status                        RevenueCategoryStatus    @default(ACTIVE)
  sortOrder                     Int                      @default(0)
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  company                       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentLines                 AccountingDocumentLine[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

/// Per-shop accountant codes; independent of the internal ledger chart.
model ExpenseCategoryAccountantAccount {
  id                String          @id @default(cuid())
  companyId         String
  expenseCategoryId String
  accountCode       String          @db.VarChar(20)
  accountName       String          @db.VarChar(120)
  updatedByUserId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)

  @@unique([companyId, expenseCategoryId])
  @@index([companyId])
}

model ExpenseCategory {
  accountantAccounts ExpenseCategoryAccountantAccount[]
  id                            String                @id @default(cuid())
  companyId                     String?
  name                          String
  accountHintKey                String
  /// Reviewed ledger account code this category debits when its expense accrues (audit CR-2,
  /// bootstrap spec §9.2). Null means nothing is bound and posting reports
  /// `expense_account_unmapped` rather than falling back to a guessed account — `accountHintKey`
  /// above is a suggestion and is deliberately NOT used as posting authority. Held as a code, not
  /// an FK, because posting resolves accounts by code at journal-creation time.
  /// Null no longer implies "unreviewed": onboarding binds from the chart template, so
  /// `ledgerAccountReviewedByUserId` below is what says whether a person chose this.
  ledgerAccountCode             String?
  /// Who attested the `ledgerAccountCode` above. Onboarding seeds the binding from the chart
  /// template's mapping and stamps `EXPENSE_CATEGORY_BOOTSTRAP_ACTOR_USER_ID` here, the same
  /// attestation seam `tax-config-bootstrap` uses: the row is postable on day one, and still
  /// names a non-human reviewer so an operator can tell a seeded default from a decision someone
  /// actually made. Not an FK — the value is a `system:` sentinel as often as a user id.
  ledgerAccountReviewedByUserId String?
  ledgerAccountReviewedAt       DateTime?
  /// Suggested input Tax Code as its stable external code (e.g. "O7"), never a
  /// TaxCodeDefinition id — that row is one dated version and an FK would pin it.
  defaultInputTaxCode           String?
  status                        ExpenseCategoryStatus @default(ACTIVE)
  sortOrder                     Int                   @default(0)
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  company                       Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenseLines                  ExpenseLine[]
  expenseRecords                ExpenseRecord[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

enum WhtRemittance {
  PAYER_FILES
  E_WHT
}

model ExpenseRecord {
  inputVatDecisions ExpenseInputVatDecision[]
  id                                 String                             @id @default(cuid())
  companyId                          String
  branchId                           String?
  expenseNumber                      String?
  draftIdempotencyKey                 String?
  draftPayloadHash                   String?
  // GAP-02: set when this expense record was materialized from a reimbursement
  // claim; drives the employee-payable (2130-01) accrual path in the posting engine.
  sourceReimbursementRequestId       String?
  // CC2: exact claim-line identity. The compound unique index is the durable
  // idempotency fence for projection retries and deploy-owned backfill.
  sourceReimbursementLineId          String?
  status                             ExpenseStatus                      @default(DRAFT)
  captureSource                      ExpenseCaptureSource               @default(WEB_MANUAL)
  requestedReviewerUserId             String?
  submittedByUserId                   String?
  submittedAt                         DateTime?
  vendorCounterpartyId               String?
  vendorSnapshotJson                 Json?
  vendorNameSnapshot                 String?
  vendorTaxIdSnapshot                String?
  vendorBranchCodeSnapshot           String?
  /// The seller address exactly as printed on the document we received (vendor-address spec §6).
  /// One free-text block, postcode included — the RD compares it with the paper, so it is never
  /// split into fields here. Empty never blocks anything (§8): it is a review hint, not a gate.
  vendorAddressSnapshot              String?                            @db.VarChar(500)
  /// Slice 2 (vendor-address spec §5 row 2, §6): the buyer block a full tax invoice printed — our own
  /// company as the seller typed it — plus how it compared with the company registry
  /// (`ExpenseBuyerAsPrinted`). Warn-only: never changes taxEvidenceStatus or inputVatClaimStatus.
  buyerAsPrintedJson                 Json?
  // RA-18: the payee's taxpayer class decides ภ.ง.ด.3 (INDIVIDUAL) vs ภ.ง.ด.53 (JURISTIC) when
  // this expense withholds tax. Captured at review; null means not yet classified, never "juristic".
  vendorEntityKindSnapshot           BuyerEntityKind?
  vendorDocumentNumber               String?
  expenseDate                        DateTime
  receivedAt                         DateTime?
  dueDate                            DateTime?
  currency                           String                             @default("THB")
  vatMode                            ExpenseVatMode                     @default(NO_VAT)
  inputVatClaimStatus                InputVatClaimStatus                @default(NON_CLAIMABLE)
  subtotalAmount                     Decimal                            @default(0) @db.Decimal(18, 4)
  discountAmount                     Decimal                            @default(0) @db.Decimal(18, 4)
  taxableAmount                      Decimal                            @default(0) @db.Decimal(18, 4)
  vatAmount                          Decimal                            @default(0) @db.Decimal(18, 4)
  whtAmount                          Decimal                            @default(0) @db.Decimal(18, 4)
  whtRemittance                      WhtRemittance?
  // The withholding DECISION behind whtAmount, mirroring SupplierPayment.whtCategoryCode/whtRate —
  // without these a 50 ทวิ certificate from Expenses had no income category to print and no rate to
  // report. Rate is a PERCENT ('3.0000' = 3%), matching WhtIncomeCategory.defaultRate.
  whtCategoryCode                    String?
  whtRate                            Decimal?                           @db.Decimal(8, 4)
  grandTotalAmount                   Decimal                            @default(0) @db.Decimal(18, 4)
  netPayableAmount                   Decimal                            @default(0) @db.Decimal(18, 4)
  paidAmount                         Decimal                            @default(0) @db.Decimal(18, 4)
  outstandingAmount                  Decimal                            @default(0) @db.Decimal(18, 4)
  paymentStatus                      ExpensePaymentStatus               @default(UNPAID)
  paymentMethod                      ExpensePaymentMethod?
  paidAt                             DateTime?
  bankAccountRef                     String?
  expenseCategoryId                  String?
  accountHintKey                     String?
  taxCategory                        String?
  duplicateStatus                    DuplicateStatus                    @default(NOT_CHECKED)
  duplicateOfExpenseId               String?
  duplicateOverrideReason            String?
  primaryAttachmentId                String?
  extractionId                       String?
  aiVerificationStatus               AiVerificationStatus               @default(NOT_VERIFIED)
  aiVerifiedFieldsJson               Json?
  aiVerificationSummaryJson          Json?
  vatCaptureSnapshotJson             Json?
  // Explicit whole-bill WHT input; amount mode never derives a rate. Null preserves legacy line rates.
  whtInputJson                       Json?
  aiVerificationConfidence           Float?
  aiVerifiedAt                       DateTime?
  lineMessageId                      String?
  lineEventId                        String?
  lineReplyTokenHash                 String?
  missingReceiptReason               String?
  sourceDocumentType                 SourceDocumentType                 @default(NEEDS_REVIEW)
  sourceDocumentLanguage             String?
  taxEvidenceStatus                  TaxEvidenceStatus                  @default(NEEDS_REVIEW)
  taxEvidenceReasonCode              String?
  uploadedAt                         DateTime                           @default(now())
  sourceChannelMetadataJson          Json?
  substituteReceiptGeneratedAt       DateTime?
  substituteReceiptGeneratedByUserId String?
  postingStatus                      ExpensePostingStatus               @default(not_required)
  journalEntryId                     String?
  postingError                       String?
  // Capture lineage (appendix §2.3). All four are null on every legacy row and on every
  // ordinary single-receipt expense; null means "not a capture-derived source", never a guess.
  // Deliberately plain columns, not relations: a Restrict foreign key to a capture table that
  // Company also cascades into fails a company delete depending on the order Postgres picks.
  captureGroupId                     String?
  captureAllocationId                String?
  // Plain reservation pointer, like capture lineage above: deliberately no foreign key.
  reservedByDisbursementVoucherId     String?
  /// Issuer scope this expense is the derived source OF, inside its group.
  captureScopeKey                    String?
  /// Who actually paid. Server-set only (from the group at handoff, or an `expense.review`
  /// decision) and audited; the reimbursement resolver reads it after the certificate (§5).
  payerUserId                        String?
  note                               String?
  internalMemo                       String?
  createdByUserId                    String
  updatedByUserId                    String?
  reviewedByUserId                   String?
  reviewedAt                         DateTime?
  confirmedByUserId                  String?
  confirmedAt                        DateTime?
  rejectedByUserId                   String?
  rejectedAt                         DateTime?
  rejectReason                       String?
  voidedByUserId                     String?
  voidedAt                           DateTime?
  voidReason                         String?
  createdAt                          DateTime                           @default(now())
  updatedAt                          DateTime                           @updatedAt
  company                            Company                            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceReimbursementRequest         ReimbursementRequest?              @relation("ExpenseSourceReimbursementRequest", fields: [companyId, sourceReimbursementRequestId], references: [companyId, id], onDelete: Restrict)
  sourceReimbursementLine            ReimbursementLine?                 @relation("ExpenseSourceReimbursementLine", fields: [companyId, sourceReimbursementRequestId, sourceReimbursementLineId], references: [companyId, reimbursementRequestId, id], onDelete: Restrict, map: "ExpenseRecord_reimbursement_source_line_fkey")
  expenseCategory                    ExpenseCategory?                   @relation(fields: [expenseCategoryId], references: [id])
  lines                              ExpenseLine[]
  receiptExtractions                 ReceiptExtraction[]
  aiVerifications                    ReceiptAiVerification[]
  duplicateCandidates                ExpenseDuplicateCandidate[]        @relation("DuplicateExpense")
  duplicateOf                        ExpenseDuplicateCandidate[]        @relation("CandidateExpense")
  substituteReceiptEvidences         ExpenseSubstituteReceiptEvidence[]
  payments                           ExpensePayment[]
  disbursementVoucherLines           DisbursementVoucherLine[]

  @@unique([companyId, expenseNumber])
  @@unique([companyId, draftIdempotencyKey])
  @@unique([companyId, id])
  // RECEIPT-02: hard idempotency for LINE media intake — one expense per LINE message.
  // Postgres treats NULL lineMessageId as distinct, so web-created expenses are unaffected.
  @@unique([companyId, lineMessageId])
  @@unique([companyId, sourceReimbursementLineId])
  @@unique([companyId, sourceReimbursementRequestId, sourceReimbursementLineId])
  // One derived source per issuer scope per capture group (appendix §2.3/§9): two tabs or two
  // users cannot hand the same group off twice. Postgres treats NULL as distinct, so this is
  // the partial `WHERE "captureGroupId" IS NOT NULL` index in effect — every legacy row and
  // every ordinary expense keeps a NULL here and is never constrained.
  @@unique([companyId, captureGroupId, captureScopeKey])
  @@index([companyId, status, expenseDate])
  @@index([companyId, branchId, expenseDate])
  @@index([companyId, vendorCounterpartyId])
  @@index([companyId, sourceReimbursementRequestId])
  @@index([companyId, paymentStatus])
  @@index([companyId, paymentStatus, dueDate])
  @@index([companyId, primaryAttachmentId, missingReceiptReason])
  @@index([companyId, postingStatus])
  @@index([companyId, duplicateStatus])
  @@index([companyId, lineMessageId])
  @@index([companyId, captureSource])
  @@index([companyId, uploadedAt])
  @@index([companyId, taxEvidenceStatus])
  @@index([companyId, createdByUserId])
  @@index([companyId, updatedByUserId])
  @@index([companyId, reviewedByUserId])
  @@index([companyId, confirmedByUserId])
  @@index([companyId, rejectedByUserId])
  @@index([companyId, voidedByUserId])
  @@index([companyId, payerUserId])
  @@index([companyId, substituteReceiptGeneratedByUserId], map: "ExpenseRecord_company_substitute_generator_idx")
}

