  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerChannelId, providerUserId])
  @@index([userId, provider, status])
}

/// Spec §4F account merge. Minted only when a web link attempt has already proved control of a LINE
/// account that an ACTIVE identity gives to a *different* user, so holding one is proof of that one
/// conflict and nothing else — the spend re-checks the session owner, the target's status and the
/// membership set from scratch. Hash-only at rest like every other auth token in this module, so a
/// database reader cannot merge anything. `consumedAt` is the CAS: it moves off null exactly once,
/// inside the merge transaction, which is what makes a double-clicked confirm idempotent rather
/// than a second merge.
model AccountMergeTicket {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique
  /// Signed-in caller: the account whose companies move out and which is DISABLED at the end.
  newUserId          String
  /// Owner of the ACTIVE LINE identity: the account everything moves into.
  existingUserId     String
  lineProviderUserId String
  requestId          String
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())
  newUser            User      @relation("AccountMergeTicketNewUser", fields: [newUserId], references: [id], onDelete: Cascade)
  existingUser       User      @relation("AccountMergeTicketExistingUser", fields: [existingUserId], references: [id], onDelete: Cascade)

  @@index([newUserId, consumedAt])
  @@index([expiresAt])
}

enum LineWebLoginTransactionStatus {
  PENDING
  APPROVED
  CONSUMED
}

/// P12-3a desktop QR login. Both halves of the transaction are bearer credentials, so only their
/// sha256 hashes live here: the public code the phone presents when approving, and the browser-bound
/// desktop secret the polling BFF presents when redeeming. Short TTL, single use — CONSUMED is
/// terminal, so a replayed secret can never mint a second session.
model LineWebLoginTransaction {
  id                String                        @id @default(cuid())
  publicCodeHash    String                        @unique
  desktopSecretHash String                        @unique
  status            LineWebLoginTransactionStatus @default(PENDING)
  userId            String?
  returnTo          String?
  expiresAt         DateTime
  approvedAt        DateTime?
  consumedAt        DateTime?
  createdAt         DateTime                      @default(now())

  @@index([expiresAt])
}

enum LineWebHandoffTokenStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

/// P12-3b LINE → web deep-link session handoff. The row proves WHO a LINE message was sent to, never
/// what they may do: every permission is re-resolved at page load. Only the sha256 of the 24-byte
/// secret is stored, so a database reader cannot open the link. Single use — the exchange claims
/// PENDING → USED atomically before it issues a session, so a second tap can never mint a second one.
/// `targetPath` is server-stored, not read from the URL at exchange time, and it is bound to
/// `companyId`: a token minted for company A cannot open company B.
/// No FK, for the same reason LineWebLoginTransaction has none — this is a pre-session artifact whose
/// lifetime is minutes and whose deletion must never cascade into user or company rows.
model LineWebHandoffToken {
  id         String                    @id @default(cuid())
  tokenHash  String                    @unique
  userId     String
  companyId  String
  lineUserId String
  targetPath String
  surface    String
  status     LineWebHandoffTokenStatus @default(PENDING)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime                  @default(now())

  @@index([userId, status])
  @@index([companyId, status])
  @@index([expiresAt])
}

