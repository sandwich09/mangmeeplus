  @@unique([companyId, id])
  @@unique([bucket, objectKey])
  @@index([companyId, status, createdAt])
  @@index([companyId, status, uploadedAt])
  @@index([companyId, checksumSha256])
  @@index([uploadedByUserId, createdAt])
}

// Durable bytes for attachments with storageProvider "db". Postgres is the only
// store that survives redeploys today (LocalStorageAdapter is a URL stub and no
// S3 client is wired), so inbound CRM media lands here. Writers cap rows at
// UPLOAD_MAX_BYTES; when a real object store ships, migrate rows out and drop.
model AttachmentBlob {
  attachmentId String           @id
  companyId    String
  data         Bytes
  createdAt    DateTime         @default(now())
  attachment   AttachmentObject @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

