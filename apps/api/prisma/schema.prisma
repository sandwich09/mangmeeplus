model StockMovement {
  id                 String                 @id @default(cuid())
  companyId          String
  movementNumber     String?
  productId          String
  locationId         String
  movementType       StockMovementType
  direction          StockMovementDirection
  quantity           Decimal
  reason             String?
  referenceType      String?
  referenceId        String?
  transferGroupId    String?
  // A movement may be reversed at most once, enforced by the database rather than
  // by the reversal query alone — the same guarantee the vendor-bill reversal gets
  // from @@unique([companyId, sourceType, sourceId, entryType]) on JournalEntry.
  // NULL is not compared by a Postgres unique index, so ordinary movements are
  // unaffected; only rows that actually carry a reversesMovementId are constrained.
  reversesMovementId String?                @unique
  actorUserId        String
  occurredAt         DateTime               @default(now())
  createdAt          DateTime               @default(now())
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product            Product                @relation(fields: [productId], references: [id])
  location           InventoryLocation      @relation(fields: [locationId], references: [id])

  @@unique([companyId, movementNumber])
  @@index([companyId, productId, locationId, occurredAt])
  @@index([companyId, productId, occurredAt])
  @@index([companyId, locationId, occurredAt])
  @@index([companyId, movementType, occurredAt])
  @@index([companyId, transferGroupId])
  @@index([companyId, referenceType, referenceId])
}

