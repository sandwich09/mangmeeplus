  @@unique([companyId, provider, lineChannelId])
  @@unique([companyId, id])
  @@unique([companyId, id, provider])
  @@index([companyId, status])
  // NOTE: migration 20260705010000 also adds a PARTIAL unique index
  // "CompanyMessagingChannel_lineChannelId_active_key" ON (lineChannelId)
  // WHERE status <> 'DISABLED' (spec 15A section 11). Prisma cannot model
  // partial indexes — do NOT let a future `prisma migrate diff` drop it.
  @@index([lineChannelId])
}

model CrmChannelIdentity {
