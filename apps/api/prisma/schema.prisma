// ─────────────────────────────────────────────────────────────────────────────
// Item 14: Reimbursement Approval and Review
// ─────────────────────────────────────────────────────────────────────────────

enum ReimbursementRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  FINANCE_REVIEW
  READY_FOR_PAYMENT
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum ReimbursementApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  SKIPPED
  EXPIRED
}

enum ReimbursementFinanceReviewStatus {
  NOT_REQUIRED
  PENDING
  NEEDS_INFO
  APPROVED_FOR_PAYMENT
  BLOCKED
}

enum ReimbursementPaymentStatus {
  NOT_PAYABLE
  UNPAID
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum ReimbursementDuplicateStatus {
  NOT_CHECKED
  NO_MATCH
  POSSIBLE_DUPLICATE
  CONFIRMED_DUPLICATE
  OVERRIDDEN
}

enum ReimbursementReceiptRequirementStatus {
  REQUIRED
  ATTACHED
  MISSING_WITH_REASON
  WAIVED_BY_POLICY
}

enum ReimbursementPostingStatus {
  not_required
  pending
  posted
  posting_error
  reversed
}

enum ReimbursementPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum ReimbursementApproverMode {
  DIRECT_MANAGER
  MANAGER_ROLE
  OWNER_ROLE
  CUSTOM_USER
  CUSTOM_ROLE
}

enum ReimbursementDuplicatePolicy {
  WARN
  BLOCK_SUBMIT
  BLOCK_PAYMENT
}

enum ReimbursementPolicyStatus {
  ACTIVE
  INACTIVE
}

enum ReimbursementPaymentRecordStatus {
  RECORDED
  VOIDED
}

enum ReimbursementDuplicateCandidateType {
  ATTACHMENT_CHECKSUM
  EXPENSE_LINK
  AMOUNT_DATE_VENDOR
  MANUAL
}

enum ReimbursementDuplicateCandidateStatus {
  OPEN
  DISMISSED
  CONFIRMED
  OVERRIDDEN
}

/// Who signed a claim form. Each role maps to the real actor of that step, so a
/// role can only ever be signed by one person — hence the per-request unique.
enum ReimbursementClaimSignatureRole {
  REQUESTER
  APPROVER
  FINANCE_REVIEW
  PAYER
}

model ReimbursementPolicy {
  id                            String                       @id @default(cuid())
  companyId                     String
  branchId                      String?
  currency                      String                       @default("THB")
  approvalThresholdAmount       Decimal                      @default(1.00) @db.Decimal(18, 4)
  approvalRequiredFromAmount    Decimal                      @default(1.00) @db.Decimal(18, 4)
  approverMode                  ReimbursementApproverMode    @default(MANAGER_ROLE)
  defaultApproverUserId         String?
  defaultApproverRole           String?                      @default("MANAGER")
  /// Every role whose holders may approve (any one decides). `defaultApproverRole` keeps the first.
  defaultApproverRoles          String[]                     @default([])
  allowSelfApproval             Boolean                      @default(false)
  requireReceipt                Boolean                      @default(true)
  allowMissingReceiptWithReason Boolean                      @default(false)
  duplicatePolicy               ReimbursementDuplicatePolicy @default(BLOCK_PAYMENT)
  financeReviewRequired         Boolean                      @default(false)
  slaHours                      Int?
  status                        ReimbursementPolicyStatus    @default(ACTIVE)
  createdByUserId               String
  updatedByUserId               String?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  company                       Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId])
  @@index([companyId, status])
}

model ReimbursementRequest {
  id                           String                                @id @default(cuid())
  companyId                    String
  branchId                     String?
  requestNo                    String?
  requesterUserId              String
  requesterDisplayNameSnapshot String
  title                        String?
  reason                       String
  categoryKey                  String
  categoryLabelSnapshot        String?
  amount                       Decimal                               @db.Decimal(18, 4)
  currency                     String                                @default("THB")
  incurredDate                 DateTime
  submittedAt                  DateTime?
  submittedByUserId            String?
  currentApproverUserId        String?
  currentApprovalStepId        String?
  approvedAt                   DateTime?
  rejectedAt                   DateTime?
  rejectionReason              String?
  cancelledAt                  DateTime?
  cancellationPendingAt        DateTime?
  cancellationPendingByUserId  String?
  cancellationPendingReason    String?
  cancellationCertificateAttestedAt DateTime?
  financeReviewStatus          ReimbursementFinanceReviewStatus      @default(NOT_REQUIRED)
  financeReviewedByUserId      String?
  financeReviewedAt            DateTime?
  financeReviewNote            String?
  status                       ReimbursementRequestStatus            @default(DRAFT)
  paymentStatus                ReimbursementPaymentStatus            @default(NOT_PAYABLE)
  duplicateStatus              ReimbursementDuplicateStatus          @default(NOT_CHECKED)
  receiptRequirementStatus     ReimbursementReceiptRequirementStatus @default(REQUIRED)
  postingStatus                ReimbursementPostingStatus            @default(not_required)
  linkedExpenseId              String?
  primaryAttachmentId          String?
  missingReceiptReason         String?
  approvalSnapshotHash         String?
  approvalPolicySnapshotJson   Json?
  /// How the requester is paid back. NULL on a draft = follow the requester's default payout account
  /// until submit; NULL on a submitted claim = a claim sent before this field existed (legacy).
  payoutMethod                 ReimbursementPaymentMethod?
  /// The claim's own account snapshot (ReimbursementPayoutDestination.version); NULL for cash.
  payoutDestinationVersion     Int?
  payoutFingerprint            String?
  /// A payout account correction round (payout spec §14): a claim sent back from the pay step waits,
  /// as PENDING_APPROVAL, for its requester to give the account and for its approvers to approve it.
  /// These five are set while it does and NULL again once it is ready for payment.
  payoutCorrectionRequestedAt       DateTime?
  payoutCorrectionRequestedByUserId String?
  payoutCorrectionReasonCode        String?
  payoutCorrectionNote              String?
  /// When the account was given again. NULL while the claim still waits for its requester.
  payoutCorrectionSubmittedAt       DateTime?
  /// What happened in every correction round of the claim, oldest first (sent back by whom and why,
  /// account given, approved again). Kept when the five columns above are cleared.
  payoutCorrectionLogJson           Json?
  paymentTotalAmount           Decimal                               @default(0) @db.Decimal(18, 4)
  outstandingAmount            Decimal                               @default(0) @db.Decimal(18, 4)
  idempotencyKey               String?
  createdByUserId              String
  updatedByUserId              String?
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt
  company                      Company                               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                       Branch?                               @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  approvalSteps                ReimbursementApprovalStep[]
  payments                     ReimbursementPayment[]
  duplicateCandidates          ReimbursementDuplicateCandidate[]
  lines                        ReimbursementLine[]
  claimSignatures              ReimbursementClaimSignature[]
  internalNotes                ReimbursementInternalNote[]
  sourceExpenses               ExpenseRecord[]                       @relation("ExpenseSourceReimbursementRequest")
  draftActions                 ReimbursementDraftAction[]
  payoutDestinations           ReimbursementPayoutDestination[]

  @@unique([companyId, requestNo])
  @@unique([companyId, id])
  @@index([companyId, requesterUserId, status])
  @@index([companyId, currentApproverUserId, status])
  @@index([companyId, status, paymentStatus])
  @@index([companyId, createdByUserId])
  @@index([companyId, updatedByUserId])
  @@index([companyId, submittedByUserId])
  @@index([companyId, financeReviewedByUserId], map: "ReimbursementRequest_company_finance_reviewer_idx")
  @@index([companyId, cancellationPendingByUserId], map: "ReimbursementRequest_company_cancel_actor_idx")
}

model ReimbursementDraftAction {
  id                       String   @id @default(uuid()) @db.Uuid
  companyId                String
  actorUserId              String
  membershipId             String
  messagingChannelId       String
  channel                  String   @db.VarChar(16)
  channelKind              String   @db.VarChar(16)
  chatKeyHash              String   @db.VarChar(64)
  ownerEpoch               Int
  taskId                    String   @db.Uuid
  actionOrdinal            Int
  intentKeyHash            String   @db.Char(64)
  operation                String   @db.VarChar(16)
  status                   String   @default("COLLECTING") @db.VarChar(16)
  previewRevision          Int      @default(0)
  requestId                String?
  expectedRequestUpdatedAt DateTime?
  commandJson              Json?
  previewJson              Json?
  sourceProofJson          Json?
  confirmationDigest       String?  @db.Char(64)
  resultJson               Json?
  appliedRequestUpdatedAt  DateTime?
  previewDeliveryId        String?
  expiresAt                DateTime
  appliedAt                DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor                    User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  membership               CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  request                  ReimbursementRequest? @relation(fields: [companyId, requestId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, intentKeyHash])
  @@index([companyId, actorUserId, status, expiresAt])
  @@index([companyId, membershipId, createdAt])
  @@index([companyId, requestId])
  @@index([status, expiresAt])
}

model ReimbursementInternalNote {
  id                     String               @id @default(cuid())
  companyId              String
  reimbursementRequestId String
  authorUserId           String
  body                   String               @db.VarChar(2000)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  request                ReimbursementRequest @relation(fields: [companyId, reimbursementRequestId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, reimbursementRequestId, createdAt])
}

/// One expense row of a claim (1 ใบเบิก หลายรายการ). Header `amount` is the
/// server-computed rollup of these; currency lives on the header only.
model ReimbursementLine {
  id                     String               @id @default(cuid())
  companyId              String
  reimbursementRequestId String
  lineNo                 Int
  incurredDate           DateTime
  description            String
  purpose                String?
  categoryKey            String
  categoryLabelSnapshot  String?
  amount                 Decimal              @db.Decimal(18, 4)
  attachmentId           String?
  linkedExpenseId        String?
  sourceExpenseSnapshotJson Json?
  attachmentSnapshotJson Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  company                Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request                ReimbursementRequest @relation(fields: [companyId, reimbursementRequestId], references: [companyId, id], onDelete: Cascade)
  sourceExpense          ExpenseRecord?       @relation("ExpenseSourceReimbursementLine")

  @@unique([reimbursementRequestId, lineNo])
  @@unique([companyId, id])
  @@unique([companyId, reimbursementRequestId, id])
  @@index([companyId, linkedExpenseId])
  @@index([companyId, attachmentId])
}

/// Digital signature drawn on the printable ใบเบิกค่าใช้จ่าย. One row per role per
/// claim: re-signing replaces the signer's own row. The form is rendered on
/// demand from these rows — the immutable record is the uploaded signed scan.
model ReimbursementClaimSignature {
  id                     String                          @id @default(cuid())
  companyId              String
  reimbursementRequestId String
  role                   ReimbursementClaimSignatureRole
  signatureAttachmentId  String
  signedByUserId         String
  signedAt               DateTime                        @default(now())
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  company                Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request                ReimbursementRequest            @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)

  @@unique([reimbursementRequestId, role])
  @@index([companyId, reimbursementRequestId])
  @@index([companyId, signedByUserId])
}

model ReimbursementApprovalStep {
  id                          String                          @id @default(cuid())
  companyId                   String
  reimbursementRequestId      String
  sequenceNo                  Int
  approverUserId              String?
  approverRoleSnapshot        String?
  assignedApproverUserIdsJson Json?
  status                      ReimbursementApprovalStepStatus @default(PENDING)
  assignedAt                  DateTime                        @default(now())
  decidedAt                   DateTime?
  decisionByUserId            String?
  comment                     String?
  rejectionReason             String?
  requestSnapshotHash         String
  invalidatedAt               DateTime?
  invalidatedReason           String?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt
  company                     Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request                     ReimbursementRequest            @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)

  @@index([companyId, approverUserId, status])
  @@index([companyId, decisionByUserId])
  @@index([reimbursementRequestId, sequenceNo])
}

model ReimbursementPayment {
  id                     String                           @id @default(cuid())
  companyId              String
  reimbursementRequestId String
  idempotencyKey         String
  paymentNo              String?
  paidAmount             Decimal                          @db.Decimal(18, 4)
  currency               String                           @default("THB")
  paymentMethod          ReimbursementPaymentMethod
  paidAt                 DateTime
  paymentReference       String?
  bankAccountId          String?
  /// The slip this payment was recorded with (an AttachmentObject id) and its checksum then.
  /// Every slip, this one included, is an AttachmentLink row on the payment.
  slipAttachmentId       String?
  slipChecksumSha256     String?
  /// The account this transfer was confirmed into: a version of the claim's own
  /// ReimbursementPayoutDestination rows (on a legacy claim, the copy of the requester's default
  /// account made at payment). NULL when no account was confirmed. Never changes once recorded.
  payoutDestinationVersion Int?
  payoutConfirmedAt      DateTime?
  /// Why the payer paid by another method than the requester asked for; NULL when it was the same.
  methodMismatchReason   String?
  sourcePaymentRef       String
  status                 ReimbursementPaymentRecordStatus @default(RECORDED)
  voidedAt               DateTime?
  voidReason             String?
  paidByUserId           String
  voidedByUserId         String?
  postingStatus          ReimbursementPostingStatus       @default(not_required)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  company                Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request                ReimbursementRequest             @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, reimbursementRequestId, status])
  @@index([companyId, paidAt, paymentMethod])
  @@index([companyId, paidByUserId])
  @@index([companyId, voidedByUserId])
}

model ReimbursementDuplicateCandidate {
  id                     String                                @id @default(cuid())
  companyId              String
  reimbursementRequestId String
  candidateType          ReimbursementDuplicateCandidateType
  candidateRequestId     String?
  candidateExpenseId     String?
  candidateAttachmentId  String?
  score                  Int
  status                 ReimbursementDuplicateCandidateStatus @default(OPEN)
  reason                 String?
  resolvedByUserId       String?
  resolvedAt             DateTime?
  createdAt              DateTime                              @default(now())
  company                Company                               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request                ReimbursementRequest                  @relation(fields: [reimbursementRequestId], references: [id], onDelete: Cascade)

  @@index([companyId, reimbursementRequestId, status])
}

/// A company member's default account for getting reimbursements back (payout spec §8). One row per
/// membership, so an owner without an employee profile has one too and two companies never share it.
/// The number is AES-256-GCM ciphertext; `accountLast4` is the only part any list or detail shows.
model MemberPayoutAccount {
  id                     String                     @id @default(cuid())
  companyId              String
  userId                 String
  /// BANK_TRANSFER or CASH only (CHECK in the migration); a cash default carries no account.
  payoutMethod           ReimbursementPaymentMethod
  /// BANK_ACCOUNT | PROMPTPAY_PHONE, NULL for a cash default.
  payoutKind             String?
  bankName               String?
  accountName            String?
  accountNumberEncrypted String?
  accountLast4           String?
  /// HMAC of the destination, stable across re-encryption: tells "changed" from "same account".
  fingerprint            String?
  version                Int                        @default(1)
  updatedByUserId        String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  membership             CompanyMembership          @relation(fields: [companyId, userId], references: [companyId, userId], onDelete: Cascade)

  @@unique([companyId, userId])
}

/// A member's other saved accounts, private to that membership (multi-payout spec §4, §7). Never
/// selected automatically and never cash; only the requester can choose one for a claim.
/// The number is AES-256-GCM ciphertext; the v1 account fingerprint deduplicates independently of
/// holder facts, while the claim's fingerprint also binds those facts for a third-party account.
model MemberSavedPayoutAccount {
  id                     String            @id @default(cuid())
  companyId              String
  userId                 String
  label                  String?
  /// SELF | THIRD_PARTY; a third-party account requires a holder note (CHECKs in the migration).
  holderType             String
  holderNote             String?
  /// BANK_ACCOUNT | PROMPTPAY_PHONE only; a saved row always carries a complete account.
  payoutKind             String
  bankName               String?
  accountName            String
  accountNumberEncrypted String
  accountLast4           String
  fingerprint            String
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  membership             CompanyMembership @relation(fields: [companyId, userId], references: [companyId, userId], onDelete: Cascade)

  @@unique([companyId, userId, fingerprint])
}

/// The claim's own copy of the account it is paid into, one row per version (payout spec §9). A row
/// with `frozenAt` set is what the approver attests and the payer pays; the migrations' triggers let
/// only the verification columns change after that, and refuse deleting it while its claim exists.
model ReimbursementPayoutDestination {
  id                     String               @id @default(cuid())
  companyId              String
  reimbursementRequestId String
  version                Int
  /// SELF for existing rows and older writers; THIRD_PARTY binds its note into the fingerprint.
  holderType             String               @default("SELF")
  holderNote             String?
  payoutKind             String
  bankName               String?
  accountName            String
  accountNumberEncrypted String
  accountLast4           String
  fingerprint            String
  /// DEFAULT_ACCOUNT | SAVED_ACCOUNT | REQUESTER | PREPARER: where the claim's account came from. LEGACY_PAYMENT: a
  /// copy of the requester's default made when a legacy claim was paid into it (the claim never points at it).
  source                 String
  /// Who entered the account: whoever typed it, or — for a copy of the default — whoever last set that default.
  createdByUserId        String
  frozenAt               DateTime?
  verifiedByUserId       String?
  verifiedAt             DateTime?
  /// APPROVAL, or PAYMENT when the payer was the first person other than the requester to check it.
  verifiedVia            String?
  approvalStepId         String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
