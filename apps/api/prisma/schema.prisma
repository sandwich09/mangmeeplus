  quantity                   Decimal                  @db.Decimal(18, 4)
  unitPrice                  Decimal                  @db.Decimal(18, 4)
  discountAmount             Decimal                  @default(0) @db.Decimal(18, 4)
  taxableAmount              Decimal                  @default(0) @db.Decimal(18, 4)
  vatRate                    Decimal?                 @db.Decimal(8, 4)
  // ZERO_RATED / EXEMPT / NON_VAT; null means no explicit zero-treatment evidence.
  vatTreatment               String?
  vatAmount                  Decimal                  @default(0) @db.Decimal(18, 4)
  whtCategoryCode String?
  whtRate                    Decimal?                 @db.Decimal(8, 4)
  whtAmount                  Decimal                  @default(0) @db.Decimal(18, 4)
  lineSubtotalAmount         Decimal                  @default(0) @db.Decimal(18, 4)
