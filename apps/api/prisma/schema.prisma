// Tax year configuration: effective dates, status
model TaxYearConfig {
  id            String        @id @default(cuid())
  companyId     String?
  year          Int
  status        TaxRuleStatus @default(DRAFT)
  effectiveFrom DateTime
  effectiveTo   DateTime
  sourceRuleId  String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company               Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceRule            TaxRuleSource?             @relation(fields: [sourceRuleId], references: [id])
  rateConfigs           TaxRateConfig[]
  calendarRules         TaxCalendarRule[]
  verificationChecklist TaxVerificationChecklist[]

  @@unique([companyId, year])
  @@index([companyId, status])
}

// VAT rates, WHT rates — config-driven, not hard-coded
model TaxRateConfig {
  id              String        @id @default(cuid())
  taxYearConfigId String
  taxType         TaxType
  code            String
  description     String
  rate            Decimal       @db.Decimal(8, 4)
  cap             Decimal?      @db.Decimal(18, 4)
  conditionJson   Json?
  status          TaxRuleStatus @default(DRAFT)
  sourceRuleId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  taxYearConfig TaxYearConfig       @relation(fields: [taxYearConfigId], references: [id])
  sourceRule    TaxRuleSource?      @relation(fields: [sourceRuleId], references: [id])
  whtCategories WhtIncomeCategory[]

  @@unique([taxYearConfigId, taxType, code])
  @@index([taxYearConfigId, taxType, status])
}

// WHT income categories (service, rent, etc.) — seeded DRAFT/NEEDS_REVIEW
model WhtIncomeCategory {
  filingRoute     String        @default("SYSTEM_FILLS")
  id              String        @id @default(cuid())
  code            String
  nameTh          String
  nameEn          String?
  formType        TaxFormType
  defaultRate     Decimal       @db.Decimal(8, 4)
  status          TaxRuleStatus @default(DRAFT)
  conditionNote   String?
  taxRateConfigId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  taxRateConfig TaxRateConfig? @relation(fields: [taxRateConfigId], references: [id])

  @@unique([code])
  @@index([formType, status])
}

// Due date and online extension rules per form type — config-driven
model TaxCalendarRule {
  id                  String        @id @default(cuid())
  taxYearConfigId     String
  formType            TaxFormType
  periodType          String        @default("MONTHLY")
  dueRuleJson         Json
  onlineExtensionJson Json?
  status              TaxRuleStatus @default(DRAFT)
  sourceRuleId        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  taxYearConfig TaxYearConfig  @relation(fields: [taxYearConfigId], references: [id])
  sourceRule    TaxRuleSource? @relation(fields: [sourceRuleId], references: [id])

  @@unique([taxYearConfigId, formType])
  @@index([taxYearConfigId, status])
}

// Tax period: one row per company + form + period key
model TaxPeriod {
  id         String          @id @default(cuid())
  companyId  String
  taxType    TaxType
  formType   TaxFormType
  periodKey  String
  status     TaxPeriodStatus @default(OPEN)
  dueDate    DateTime?
  filedAt    DateTime?
  paidAt     DateTime?
  reviewNote String?
  closedAt   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxEvents       TaxEvent[]
  reportSnapshots TaxReportSnapshot[]
  filingPackages  TaxFilingPackage[]
  whtFilings      WhtFiling[]
  reviewIssues    TaxReviewIssue[]
  whtCertificates WhtCertificate[]
  adjustments     TaxAdjustment[]
  citSummaries    CitLedgerSummary[]

  @@unique([companyId, formType, periodKey])
  @@index([companyId, taxType, status])
  @@index([companyId, formType, periodKey])
}

// Source-derived tax events: VAT output/input, WHT
model TaxEvent {
  id                         String                   @id @default(cuid())
  companyId                  String
  branchId                   String?
  taxPeriodId                String
  idempotencyKey             String
  eventType                  TaxEventType
  status                     TaxEventStatus           @default(ACTIVE)
  sourceType                 String
  sourceId                   String
  sourceLineId               String?
  sourceLineKey              String                   @default("__HEADER__")
  sourceEventType            String?
  sourceHash                 String?
  periodKey                  String
  eventDate                  DateTime
  taxableBase                Decimal                  @db.Decimal(18, 4)
  taxAmount                  Decimal                  @db.Decimal(18, 4)
  currency                   String                   @default("THB")
  vatMode                    String?
  outputTaxCode              AccountingOutputTaxCode?
  componentKey               TaxComponentKey?
  taxCodeDefinitionId        String?
  externalTaxCodeSnapshot    String?
  taxProfileKeySnapshot      String?
  taxProfileVersionSnapshot  Int?
  roundingModeSnapshot       String?
  roundingScaleSnapshot      Int?
  taxAmountToleranceSnapshot Decimal?                 @db.Decimal(20, 6)
  taxRegimeSnapshot          TransactionTaxRegime?
  taxDirectionSnapshot       TransactionTaxDirection?
  taxTreatmentSnapshot       TransactionTaxTreatment?
  taxContextSnapshot         TransactionTaxContext?
  taxRateSnapshot            Decimal?                 @db.Decimal(8, 4)
  sourceCurrencySnapshot     String?
  taxCurrencySnapshot        String?
  exchangeRateSnapshot       Decimal?                 @db.Decimal(18, 8)
  exchangeRateSourceSnapshot String?
  exchangeRateDateSnapshot   DateTime?                @db.Date
  claimabilitySnapshot       TaxClaimability?
  accountRuleVersionSnapshot Int?
  reportRuleVersionSnapshot  Int?
  taxEvidenceReviewStatus    TaxEvidenceReviewStatus?
  reportContributionsJson    Json?
  accountAssignmentsJson     Json?
  whtFormType                TaxFormType?
  // Step 0 §6.5 (RA-17, sell side). `payeeSnapshotJson.branchCode` is the BUYER's establishment
  // and stays that way; this is the seller's, read from the document's frozen seller snapshot.
  sellerBranchCode           String?
  payeeSnapshotJson          Json?
  incomeCategoryCode         String?
  whtRate                    Decimal?                 @db.Decimal(8, 4)
  grossAmount                Decimal?                 @db.Decimal(18, 4)
  withheldAmount             Decimal?                 @db.Decimal(18, 4)
  netPaidAmount              Decimal?                 @db.Decimal(18, 4)
  taxInvoiceNumber           String?
  reviewNote                 String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch              Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  taxPeriod           TaxPeriod               @relation(fields: [taxPeriodId], references: [id])
  taxCodeDefinition   TaxCodeDefinition?      @relation(fields: [taxCodeDefinitionId], references: [id], onDelete: SetNull)
  reviewIssues        TaxReviewIssue[]
  reconciliationLines TaxReconciliationLine[]

  @@unique([idempotencyKey])
  @@index([companyId, taxPeriodId, status])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, branchId, sourceType, sourceId, sourceLineId])
  @@index([companyId, periodKey, eventType])
  @@index([companyId, taxCodeDefinitionId, status])
}

// Review issues: blocking/warning/info facts missing from source
model TaxReviewIssue {
  id               String              @id @default(cuid())
  companyId        String
  taxPeriodId      String
  taxEventId       String?
  severity         ReviewIssueSeverity
  status           ReviewIssueStatus   @default(OPEN)
  issueCode        String
  description      String
  sourceType       String?
  sourceId         String?
  resolvedAt       DateTime?
  resolvedNote     String?
  resolvedByUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id])
  taxEvent  TaxEvent? @relation(fields: [taxEventId], references: [id])

  @@index([companyId, taxPeriodId, status])
  @@index([companyId, issueCode])
}

// Snapshot of computed VAT/WHT/CIT report at review/export time
model TaxReportSnapshot {
  id              String      @id @default(cuid())
  companyId       String
  taxPeriodId     String
  formType        TaxFormType
  periodKey       String
  reportJson      Json
  checksum        String
  snapshotAt      DateTime    @default(now())
  createdByUserId String?
  createdAt       DateTime    @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id])

  @@index([companyId, taxPeriodId])
  @@index([companyId, formType, periodKey])
}

// Filing export package: one per form/period/format export action
model WhtFiling {
  id                    String          @id @default(cuid())
  companyId             String
  taxPeriodId           String
  formType              TaxFormType
  periodKey             String
  establishmentCode     String
  establishmentBranchId String?
  sequence              Int             @default(0)
  status                TaxPeriodStatus @default(OPEN)
  preparedBy            String
  payerSnapshotJson     Json
  rowsChecksum          String
  filingPackageId       String?         @unique
  downloadedAt          DateTime?
  filedAt               DateTime?
  filedByUserId         String?
  filedNote             String?
  rowsCertain           Boolean         @default(true)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  taxPeriod TaxPeriod          @relation(fields: [taxPeriodId], references: [id], onDelete: Restrict)
  lines     WhtFilingLine[]
  packages  TaxFilingPackage[]  @relation("WhtFilingPackages")
  latestPackage TaxFilingPackage? @relation("WhtLatestPackage", fields: [filingPackageId], references: [id], onDelete: Restrict)

  @@unique([companyId, formType, periodKey, establishmentCode, sequence], map: "WhtFiling_paper_key")
  @@index([companyId, taxPeriodId])
}

model WhtFilingLine {
  id          String @id @default(cuid())
  whtFilingId String
  rowNumber   Int
  taxEventId  String
  sourceType  String
  sourceId    String
  lineJson    Json
  filing WhtFiling @relation(fields: [whtFilingId], references: [id], onDelete: Restrict)

  @@unique([whtFilingId, rowNumber])
  @@index([sourceType, sourceId])
  @@index([taxEventId])
}

model TaxFilingPackage {
  id                String              @id @default(cuid())
  companyId         String
  taxPeriodId       String
  formType          TaxFormType
  periodKey         String
  exportNumber      String
  whtFilingId       String?
  status            FilingPackageStatus @default(GENERATED)
  exportFormat      String
  attachmentId      String?
  checksum          String?
  generatedAt       DateTime            @default(now())
  downloadedAt      DateTime?
  voidedAt          DateTime?
  filedManuallyAt   DateTime?
  filedManuallyNote String?
  generatedByUserId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id])

  whtFiling WhtFiling? @relation("WhtFilingPackages", fields: [whtFilingId], references: [id], onDelete: Restrict)
  latestOfWhtFiling WhtFiling? @relation("WhtLatestPackage")

  @@index([whtFilingId])
  @@index([companyId, taxPeriodId])
  @@index([companyId, formType, periodKey, status])
}

// 50 ทวิ WHT certificates
model WhtCertificate {
  id                 String               @id @default(cuid())
  companyId          String
  certificateNumber  String
  status             WhtCertificateStatus @default(DRAFT)
  taxPeriodId        String
  periodKey          String
  payeeSnapshotJson  Json
  payerSnapshotJson  Json
  incomeCategoryCode String
  incomeCategoryName String
  whtRate            Decimal              @db.Decimal(8, 4)
  grossAmount        Decimal              @db.Decimal(18, 4)
  withheldAmount     Decimal              @db.Decimal(18, 4)
  paymentDate        DateTime
  taxEventIdsJson    Json                 @default("[]")
  pdfAttachmentId    String?
  issuedAt           DateTime?
  issuedByUserId     String?
  voidedAt           DateTime?
  voidedByUserId     String?
  voidReason         String?
  // Correction & replacement plan §1.1/§5.2 — additive, single-supersede self-relation kept as
  // plain strings (mirrors WhtCertificateHandoff.certificateId), no Prisma `@relation`: Prisma
  // does not support two unnamed fields pointing at each other on the same self-relation.
  supersededByCertificateId   String?   @unique
  supersedesCertificateId     String?   @unique
  correctionReason            String?
  // Replacement copy counter — a plain count instead of a per-copy ledger table (§3 non-goal).
  replacementCopyCount        Int       @default(0)
  lastReplacementCopyAt       DateTime?
  lastReplacementCopyByUserId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id])

  @@unique([companyId, certificateNumber])
  @@index([companyId, taxPeriodId, status])
}

enum WhtHandoffStatus {
  REQUIRED
  EXTERNAL_LINKED
  SYSTEM_ISSUED
  CANCELLED
}

// Durable EXTERNAL_CERTIFICATE_REQUIRED handoff. Created when the system cannot issue the
// 50 ทวิ itself (cap.wht50bis/SYSTEM_INITIAL_ISSUE CLOSED) so the operator can have it issued
// externally and link it back. Never holds certificate state — CC5 owns WhtCertificate.
// Spec: feature-entitlement-decoupling-spec.md:205, tax-thailand-2026-spec.md:1324-1343.
model WhtCertificateHandoff {
  id     String           @id @default(cuid())
  status WhtHandoffStatus @default(REQUIRED)

  companyId         String
  // Spec identity (tax-spec:1327-1329). Settlement-created rows populate it; endpoint-seam rows
  // leave it null and rely on the creationCommandId fence instead (coordinator ruling OQ-1).
  sourcePaymentType String?
  sourcePaymentId   String?
  payeeId           String?
  // The PAYEE's tax branch code (certificate prefill) — distinct from the internal source branch.
  branchCode        String?
  // The internal branch that made the payment. Attribution only: no AP surface enforces a branch
  // authorization boundary today, and H4 does not invent one (see task memory).
  sourceBranchId    String?
  sourceFeatureKey  String

  // Nullable provenance per spec:204 / tax-spec:1220-1221 — never a prerequisite.
  taxPeriodId     String?
  taxEventIdsJson Json    @default("[]")

  // Deliberate addition beyond the spec's field list (coordinator ruling OQ-4): the spec
  // re-derives prefill from a settled-payment row that does not exist yet, and the artifact
  // must stay readable after the source feature is OFF (tax-spec:1835).
  prefillSnapshotJson Json
  prefillSnapshotHash String

  // Vendor-address spec §10: the payee address the operator types on the handoff screen when the
  // frozen prefill has none. Columns BESIDE the snapshot, never inside it — `prefillSnapshotHash`
  // exists so the operator's copy of the statutory facts cannot drift, and editing the JSON would
  // either break that hash or force it to be recomputed, which destroys the guarantee.
  payeeAddress         String?   @db.VarChar(500)
  payeeAddressByUserId String?
  payeeAddressAt       DateTime?

  availabilityVectorJson Json

  // Legal evidence about the externally issued RD document — real columns, not audit metadata.
  externalCertificateNumber String?
  externalEvidenceRef       String?
  externalIssuedDate        DateTime?
  linkNote                  String?
  linkedAt                  DateTime?
  linkedByUserId            String?

  creationCommandId      String
  payloadFingerprint     String
  // The link command's own identity. Without it a replay had to compare the CREATION command id,
  // which cannot distinguish a retry from a different second link.
  linkCommandId          String?
  linkPayloadFingerprint String?
  certificateId          String?
  certificateRound       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, creationCommandId])
  // The link fence: NULL-distinct, so unlinked rows coexist while two link attempts sharing a
  // command id collide on exactly one winner.
  @@unique([companyId, linkCommandId])
  // Explicit map: the derived name exceeds Postgres' 63-char identifier limit.
  @@unique([companyId, sourcePaymentType, sourcePaymentId, payeeId], map: "WhtCertificateHandoff_source_identity_key")
  @@index([companyId, status])
  @@index([companyId, taxPeriodId])
  @@index([companyId, sourceBranchId])
}

// Append-only certificate events, independent of reusable handoff pointers.
model WhtCertificateHistory {
  id                       String   @id @default(cuid())
  companyId                String
  expenseId                String?
  handoffId                String
  eventType                String
  certificateId            String?
  certificateNumber        String?
  isExternal               Boolean
  certificateDate          DateTime?
  relatedCertificateId     String?
  relatedCertificateNumber String?
  reason                   String?
  detailsJson              Json?
  taxFilingAttested         Boolean  @default(false)
  actorUserId              String
  occurredAt               DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expenseId, occurredAt])
  @@index([companyId, handoffId])
}

// CIT ledger-backed supporting summary
model CitLedgerSummary {
  id                 String    @id @default(cuid())
  companyId          String
  taxPeriodId        String
  accountingPeriodId String?
  revenueTotal       Decimal   @db.Decimal(18, 4)
  expenseTotal       Decimal   @db.Decimal(18, 4)
  profitLoss         Decimal   @db.Decimal(18, 4)
  taxExpenseTotal    Decimal   @db.Decimal(18, 4)
  ledgerReportRef    String?
  sourceRefsJson     Json      @default("[]")
  checksum           String?
  snapshotAt         DateTime?
  missingLedger      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id])

  @@unique([companyId, taxPeriodId])
  @@index([companyId, taxPeriodId])
}

// Tax period adjustments: correction, reversal, amended
model TaxAdjustment {
  id               String            @id @default(cuid())
  companyId        String
  taxPeriodId      String
  adjustmentType   TaxAdjustmentType
  reason           String
  adjustedByUserId String
  metadataJson     Json?
  adjustedAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxPeriod TaxPeriod @relation(fields: [taxPeriodId], references: [id])

  @@index([companyId, taxPeriodId])
}

// Accountant verification checklist per tax year
model TaxVerificationChecklist {
  id              String    @id @default(cuid())
  companyId       String?
  taxYearConfigId String
  item            String
  status          String    @default("PENDING")
  reviewer        String?
  reviewedAt      DateTime?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxYearConfig TaxYearConfig @relation(fields: [taxYearConfigId], references: [id])

  @@index([companyId, taxYearConfigId])
}

// ─── Item 12: Procurement, Supplier, and Accounts Payable ────────────────────

enum SupplierStatus {
  ACTIVE
  ON_HOLD
  ARCHIVED
}

enum SupplierType {
  JURISTIC_PERSON
  INDIVIDUAL
  FOREIGN
  GOVERNMENT
  OTHER
}

enum SupplierBankAccountStatus {
  ACTIVE
  ARCHIVED
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_BILLED
  BILLED
  CLOSED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  VOIDED
}

enum VendorBillStatus {
  DRAFT
  NEEDS_REVIEW
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_PAID
  PAID
  VOIDED
  CREDITED
}

enum SupplierPaymentStatus {
  DRAFT
  RECORDED
  VOIDED
}

enum PurchaseLineType {
  STOCK
  SERVICE
  NON_STOCK
  ASSET_CANDIDATE
  OTHER
}

enum PurchaseMatchingMode {
  NONE
  TWO_WAY_PO_BILL
  THREE_WAY_PO_RECEIPT_BILL
}

enum PurchaseMatchingStatus {
  NOT_REQUIRED
  NOT_MATCHED
  MATCHED
  MATCHED_WITH_VARIANCE
  BLOCKED
  OVERRIDDEN
}

enum PurchaseApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  OVERRIDDEN
}

enum PurchaseApprovalSourceType {
  PURCHASE_REQUEST
  PURCHASE_ORDER
  VENDOR_BILL
}

enum ProcurementTaxSyncStatus {
  not_required
  pending
  synced
  sync_error
  reversed
}

model SupplierProfile {
  id                         String                 @id @default(cuid())
  companyId                  String
  counterpartyId             String                 @unique
  supplierCode               String?
  supplierType               SupplierType           @default(JURISTIC_PERSON)
  displayNameSnapshot        String
  legalNameSnapshot          String?
  taxId                      String?
  branchCode                 String?
  vatRegistered              Boolean?
  defaultVatMode             AccountingVatMode?
  defaultInputVatClaimStatus InputVatClaimStatus?
  defaultWhtCategoryCode     String?
  defaultPaymentTermsDays    Int?
  defaultExpenseCategoryKey  String?
  defaultAccountHint         String?
  defaultCurrency            String                 @default("THB")
  contactName                String?
  email                      String?
  phone                      String?
  addressJson                Json?
  status                     SupplierStatus         @default(ACTIVE)
  onHoldReason               String?
  createdByUserId            String
  updatedByUserId            String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  company                    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  counterparty               AccountingCounterparty @relation(fields: [counterpartyId], references: [id])
  bankAccounts               SupplierBankAccount[]
  purchaseRequests           PurchaseRequest[]
  purchaseOrders             PurchaseOrder[]
  goodsReceipts              GoodsReceipt[]
  vendorBills                VendorBill[]
  supplierPayments           SupplierPayment[]

  @@unique([companyId, counterpartyId])
  @@unique([companyId, supplierCode])
  @@index([companyId, status])
  @@index([companyId, taxId])
}

model SupplierBankAccount {
  id                 String                    @id @default(cuid())
  companyId          String
  supplierId         String
  bankName           String
  bankCode           String?
  accountName        String
  accountNumberLast4 String
  branchName         String?
  isDefault          Boolean                   @default(false)
  status             SupplierBankAccountStatus @default(ACTIVE)
  createdByUserId    String
  updatedByUserId    String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  company            Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier           SupplierProfile           @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId, supplierId, status])
}

model PurchaseRequest {
  id                       String                @id @default(cuid())
  companyId                String
  branchId                 String?
  requestNumber            String?
  status                   PurchaseRequestStatus @default(DRAFT)
  requesterUserId          String
  neededByDate             DateTime?
  supplierId               String?
  supplierSnapshotJson     Json?
  reason                   String?
  budgetCode               String?
  currency                 String                @default("THB")
  subtotalAmount           Decimal               @default(0) @db.Decimal(18, 4)
  discountAmount           Decimal               @default(0) @db.Decimal(18, 4)
  taxableAmount            Decimal               @default(0) @db.Decimal(18, 4)
  vatAmount                Decimal               @default(0) @db.Decimal(18, 4)
  whtEstimateAmount        Decimal?              @db.Decimal(18, 4)
  grandTotalAmount         Decimal               @default(0) @db.Decimal(18, 4)
  submittedAt              DateTime?
  approvedByUserId         String?
  approvedAt               DateTime?
  rejectedByUserId         String?
  rejectedAt               DateTime?
  approvalNote             String?
  convertedPurchaseOrderId String?
  createdByUserId          String
  updatedByUserId          String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  company                  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier                 SupplierProfile?      @relation(fields: [supplierId], references: [id])
  lines                    PurchaseRequestLine[]

  @@unique([companyId, requestNumber])
  @@index([companyId, status])
  @@index([companyId, branchId, status])
  @@index([companyId, requesterUserId])
  @@index([companyId, createdByUserId])
  @@index([companyId, updatedByUserId])
  @@index([companyId, approvedByUserId])
  @@index([companyId, rejectedByUserId])
  @@index([companyId, convertedPurchaseOrderId])
}

model PurchaseRequestLine {
  id                         String                   @id @default(cuid())
  companyId                  String
  purchaseRequestId          String
  lineNumber                 Int
  lineType                   PurchaseLineType         @default(STOCK)
  productId                  String?
  skuSnapshot                String?
  description                String
  unitName                   String?
  requestedQuantity          Decimal                  @db.Decimal(18, 4)
  estimatedUnitPrice         Decimal                  @db.Decimal(18, 4)
  discountAmount             Decimal                  @default(0) @db.Decimal(18, 4)
  vatMode                    AccountingVatMode        @default(NO_VAT)
  vatRate                    Decimal?                 @db.Decimal(6, 4)
  vatAmount                  Decimal                  @default(0) @db.Decimal(18, 4)
  lineSubtotalAmount         Decimal                  @db.Decimal(18, 4)
  lineTotalAmount            Decimal                  @db.Decimal(18, 4)
  accountHint                String?
  inventoryLocationId        String?
