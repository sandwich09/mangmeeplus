  customer           CrmCustomer             @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  channelIdentity    CrmChannelIdentity      @relation(fields: [companyId, channelId, customerId, channelIdentityId], references: [companyId, channelId, customerId, id], onDelete: Restrict, map: "CrmConversation_identity_customer_fkey")
  messages           CrmMessage[]
  autonomyJobs       CrmAutonomyJob[]
  aiAssistFeedback   CrmAiAssistFeedback[]

  @@unique([companyId, id])
  @@index([companyId, status, lastMessageAt])
  @@index([companyId, assignedToUserId, status])
  @@index([companyId, customerId])
  @@index([companyId, firstResponseDueAt])
  @@index([channelIdentityId])
}

model CrmMessage {
  id                    String                   @id @default(cuid())
  companyId             String
  conversationId        String
  direction             CrmMessageDirection
  visibility            CrmMessageVisibility     @default(CUSTOMER)
  authorType            CrmMessageAuthorType
  authorUserId          String?
  messageType           CrmMessageType
  contentText           String?
  contentJson           Json?
  attachmentId          String?
  accountingDocumentRef String?
  aiDraftUsed           Boolean                  @default(false)
  providerMessageId     String?
  webhookEventId        String?
  deliveryStatus        CrmMessageDeliveryStatus @default(PENDING)
  deliveryError         String?
  // A5 reply-send retry: attempts made + when the next retry is due. A PENDING
  // outbound CUSTOMER message with deliveryNextAttemptAt in the past is picked up
  // by the reply-retry scanner and re-pushed (429/5xx/unreachable only).
  deliveryAttemptCount  Int                      @default(0)
  deliveryNextAttemptAt DateTime?
  sentAt                DateTime?
  createdAt             DateTime                 @default(now())
  company               Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation          CrmConversation          @relation(fields: [companyId, conversationId], references: [companyId, id], onDelete: Cascade)
  autonomyJob           CrmAutonomyJob?

  // Company-scoped so a redelivery that resolves to a DIFFERENT conversation
  // (creation race) still collides instead of double-inserting.
  @@unique([companyId, providerMessageId])
  @@unique([companyId, conversationId, id])
  @@index([companyId, conversationId, createdAt])
  // A5: reply-retry sweep (PENDING outbound due for re-push) + media/pending scan.
  @@index([deliveryStatus, deliveryNextAttemptAt])
}

model CrmAutonomyJob {
  id             String               @id @default(cuid())
  companyId      String
  conversationId String
  messageId      String               @unique
  replyToken     String?
  replyTokenAt   DateTime?
  status         CrmAutonomyJobStatus @default(PENDING)
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   CrmConversation      @relation(fields: [companyId, conversationId], references: [companyId, id], onDelete: Cascade)
  message        CrmMessage           @relation(fields: [companyId, conversationId, messageId], references: [companyId, conversationId, id], onDelete: Cascade)

  @@unique([companyId, conversationId, messageId])
  @@index([status, nextAttemptAt])
  @@index([companyId])
}

