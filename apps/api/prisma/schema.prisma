  chartOfAccountsTemplateChecksum   String?
  chartOfAccountsTemplateAppliedAt  DateTime?
  // ── Step 0 company tax identity (company-tax-identity-setup-spec §4.1) ──
  // CAS token for every identity write, and the version the revision table keys on.
  legalIdentityVersion              Int                                       @default(0)
  // Set once when the wizard is confirmed (or when the first LEGAL_CHANGE / first tax document
  // makes the point moot). While NULL the company is still capturing, so INITIAL_CAPTURE is
  // allowed and no legal-date fence exists yet. Bound to this column and NOT to version 0:
  // the wizard saves per step, so the version has already moved by step 2.
  legalIdentityCaptureCompletedAt   DateTime?
  lastLegalChangeEffectiveDate      DateTime?                                 @db.Date
  // Write-once. The first moment real evidence exists that these values are the company's legal
  // identity. Never cleared — not by a tax id change, not by a verification reset, not by a
  // rollback — because the evidence happened regardless of what the row says today.
  legalIdentityAuthoritativeAt      DateTime?
  legalIdentityAuthoritativeReason  LegalIdentityAuthorityReason?
  legalIdentityAuthoritativeRef     String?
  // RD TIN existence check: proves the number exists, carries no name or address (§2 item 6).
  tinExistsStatus                   TinExistenceStatus?
  tinExistsAt                       DateTime?
  // Keyed HMAC of the verified number plus its key version, so rotating the key marks old
  // results "needs re-check" instead of deleting the evidence. The number itself is not stored twice.
  tinSubjectHmac                    String?
  tinSubjectHmacKeyVersion          Int?
  // RD VAT detail check: name and address per establishment, registered companies only.
  vatDetailStatus                   VatDetailStatus?
  vatDetailAt                       DateTime?
  vatDetailSelectedBranchCode       String?
