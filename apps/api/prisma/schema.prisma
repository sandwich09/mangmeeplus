model CrmBooking {
  id                    String           @id @default(cuid())
  companyId             String
  branchId              String
  customerId            String
  customerName          String?
  serviceName           String
  staffUserId           String?
  startAt               DateTime
  endAt                 DateTime
  status                CrmBookingStatus @default(BOOKED)
  source                CrmBookingSource @default(STAFF)
  sourceConversationId  String?
  // Snapshot amounts entered at booking time (บาท) — outstanding = totalAmount - depositAmount.
  depositAmount         Decimal?         @db.Decimal(12, 2)
  totalAmount           Decimal?         @db.Decimal(12, 2)
  // A7 appointment reminder: set once the pre-appointment reminder has been sent so
  // the reminder scanner never double-sends. Null = not yet reminded.
  reminderSentAt        DateTime?
  // Durable reminder delivery lease/backoff. A stale claim is safely retried with
  // the same LINE retry key; success clears the lease and sets reminderSentAt.
  reminderClaimedAt     DateTime?
  reminderAttemptCount  Int              @default(0)
  reminderNextAttemptAt DateTime?
  reminderLastError     String?
  createdByUserId       String
  updatedByUserId       String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  company               Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer              CrmCustomer      @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)

  @@index([companyId, branchId, startAt])
  @@index([status, reminderSentAt, reminderNextAttemptAt, startAt], map: "CrmBooking_reminder_delivery_due_idx")
  @@index([companyId, staffUserId, startAt])
  @@index([companyId, customerId])
  // A7: global reminder sweep (BOOKED, upcoming, not yet reminded).
  @@index([status, startAt])
}

