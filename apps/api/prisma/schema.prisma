  claimToken    String? // P0-4 fencing token minted per claimed row; completion CASes on it
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  company       Company?            @relation(fields: [companyId], references: [id])

  @@index([status, availableAt, priority])
  @@index([companyId, createdAt])
  @@index([aggregateType, aggregateId])
  deliveryPlan LineDeliveryPlan?

}

model Branch {
  id                           String                  @id @default(cuid())
  companyId                    String
  code                         String
  name                         String
  type                         BranchType              @default(BRANCH)
  // Whether this location is a ภ.พ.20 establishment. Independent of `type` in both directions
  // (spec §6.1): a WAREHOUSE can be a registered establishment, and a BRANCH need not be one.
  // Coupled to taxBranchCode instead — true requires a code, false requires none.
  isVatEstablishment           Boolean                 @default(false)
  taxBranchCode                String?
  addressJson                  Json?
  phone                        String?
  email                        String?
  status                       BranchStatus            @default(ACTIVE)
  createdByUserId              String?
  updatedByUserId              String?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  company                      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxEvents                    TaxEvent[]
  tradeTaxEvidences            TradeTaxEvidence[]
  taxReconciliationRuns        TaxReconciliationRun[]
  taxReconciliationLines       TaxReconciliationLine[]
  journalLines                 JournalLine[]
  accountingDocuments          AccountingDocument[]
  // Documents that name this branch as the SELLING establishment. Separate from
  // `accountingDocuments` (the operational branch) — a document can have one, both or neither.
  sellerEstablishmentDocuments AccountingDocument[]    @relation("DocumentSellerEstablishment")
  accountingPayments           AccountingPayment[]
  bankAccounts                 BankAccount[]
  reimbursementRequests        ReimbursementRequest[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, status])
  @@index([companyId, taxBranchCode])
}

