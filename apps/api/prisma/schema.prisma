model AccountingCounterparty {
  id                  String                       @id @default(cuid())
  companyId           String
  type                AccountingCounterpartyType
  displayName         String
  legalName           String?
  taxId               String?
  branchCode          String?
  // Step 0 §7.1: the two buyer dimensions a tax invoice needs and the master never carried.
  // Both nullable — an existing counterparty has neither answered, and UNKNOWN is a real
  // stored answer (it blocks issuance) distinct from "never asked".
  entityKind          BuyerEntityKind?
  vatStatus           BuyerVatStatus?
  email               String?
  phone               String?
  billingAddressJson  Json?
  shippingAddressJson Json?
  status              AccountingCounterpartyStatus @default(ACTIVE)
  createdByUserId     String
  /// Uploader of the receipt that first auto-created this counterparty.
  receiptUploaderUserId String?
  updatedByUserId     String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  company             Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents           AccountingDocument[]
  payments            AccountingPayment[]
  supplierProfile     SupplierProfile?

  @@unique([companyId, id])
  @@index([companyId, type, status])
  @@index([companyId, displayName])
}

model AccountingDocument {
  id                          String                                    @id @default(cuid())
  companyId                   String
  branchId                    String?
  documentType                AccountingDocumentType
  documentNumber              String?
  status                      AccountingDocumentStatus                  @default(DRAFT)
  documentDate                DateTime
  dueDate                     DateTime?
  counterpartyId              String?
  counterpartySnapshotJson    Json?
  // Step 0: buyer identity entered on this document, ahead of the counterparty master when
  // both exist. Draft-only — after issue the frozen counterpartySnapshotJson is what counts.
  buyerTaxIdentityDraftJson   Json?
  // The ภ.พ.20 establishment doing the selling. NOT the same as branchId, which stays purely
  // operational: a null-branch document is still company-central and its numbering is unchanged.
  sellerEstablishmentBranchId String?
  // Seller identity frozen at issue, as-of documentDate (§8.3). Existing schema froze only the
  // counterparty, so a reprint after a legal name change used to show today's name.
  sellerSnapshotJson          Json?
  sourceDocumentId            String?
  sourceDocumentType          String?
  convertedFromDocumentId     String?
  // Optional client retry fence for the generic invoice-draft command. The fingerprint is
  // server-computed; both remain private persistence metadata and are never serialized.
  createIdempotencyKey        String?
  createPayloadFingerprint    String?
  currency                    String                                    @default("THB")
  vatMode                     AccountingVatMode                         @default(NO_VAT)
  outputTaxCode               AccountingOutputTaxCode?
  subtotalAmount              Decimal                                   @default(0) @db.Decimal(18, 4)
  discountAmount              Decimal                                   @default(0) @db.Decimal(18, 4)
  taxableAmount               Decimal                                   @default(0) @db.Decimal(18, 4)
  vatAmount                   Decimal                                   @default(0) @db.Decimal(18, 4)
  whtAmount                   Decimal                                   @default(0) @db.Decimal(18, 4)
  grandTotalAmount            Decimal                                   @default(0) @db.Decimal(18, 4)
  paidAmount                  Decimal                                   @default(0) @db.Decimal(18, 4)
  outstandingAmount           Decimal                                   @default(0) @db.Decimal(18, 4)
  unappliedCreditAmount       Decimal?                                  @db.Decimal(18, 4)
  paymentStatus               AccountingPaymentStatus?
  taxStatus                   String?
  taxInvoiceType              AccountingTaxInvoiceType?
  taxInvoiceId                String?
  postingStatus               AccountingPostingStatus                   @default(not_required)
  journalEntryId              String?
  postingError                String?
  note                        String?
  internalMemo                String?
  // Required by application validation for CREDIT_NOTE/DEBIT_NOTE; nullable keeps the migration additive.
  adjustmentReasonCode        String?
  adjustmentReasonText        String?
  // Issue metadata
  issuedByUserId              String?
  issuedAt                    DateTime?
  voidedByUserId              String?
  voidedAt                    DateTime?
  voidReason                  String?
  // Quotation approval metadata
  approvalStatus              AccountingQuotationApprovalStatus?
  submittedByUserId           String?
  submittedAt                 DateTime?
  approvedByUserId            String?
  approvedAt                  DateTime?
  rejectedByUserId            String?
  rejectedAt                  DateTime?
  approvalNote                String?
  // Audit
  createdByUserId             String
  updatedByUserId             String?
  createdAt                   DateTime                                  @default(now())
  updatedAt                   DateTime                                  @updatedAt
  company                     Company                                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  counterparty                AccountingCounterparty?                   @relation(fields: [companyId, counterpartyId], references: [companyId, id])
  branch                      Branch?                                   @relation(fields: [companyId, branchId], references: [companyId, id])
  // Composite FK like `branch` above, not a bare id: the database, not application code, is
  // what keeps a document from pointing at another tenant's establishment.
  sellerEstablishmentBranch   Branch?                                   @relation("DocumentSellerEstablishment", fields: [companyId, sellerEstablishmentBranchId], references: [companyId, id])
  lines                       AccountingDocumentLine[]
  paymentAllocations          AccountingPaymentAllocation[]
  issueCommands               AccountingDocumentIssueCommand[]
  buyerEvidenceRevisions      AccountingDocumentBuyerEvidenceRevision[]
  simpleIncomeInvoiceCommands AccountingSimpleIncomeCommand[]           @relation("SimpleIncomeInvoice")
  simpleIncomeReceiptCommands AccountingSimpleIncomeCommand[]           @relation("SimpleIncomeReceipt")

  @@unique([companyId, documentType, documentNumber])
  @@unique([companyId, createIdempotencyKey])
  @@unique([companyId, id])
  @@index([companyId, documentType, status])
  @@index([companyId, branchId, documentDate])
  @@index([companyId, counterpartyId])
  @@index([companyId, sourceDocumentId])
  @@index([companyId, convertedFromDocumentId])
  @@index([companyId, paymentStatus])
  @@index([companyId, postingStatus])
  @@index([companyId, outputTaxCode, status])
}

