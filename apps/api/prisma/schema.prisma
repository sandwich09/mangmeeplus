model AccountingPaymentAllocation {
  id              String             @id @default(cuid())
  companyId       String
  paymentId       String
  documentId      String
  // `amount` is the cash share, `whtAmount` the withheld share. A void restores the document by
  // amount + whtAmount, so both must be recorded per allocation, not only on the payment header.
  amount          Decimal            @db.Decimal(18, 4)
  whtAmount       Decimal?           @db.Decimal(18, 4)
  currency        String             @default("THB")
  allocatedAt     DateTime           @default(now())
  createdByUserId String
  createdAt       DateTime           @default(now())
  payment         AccountingPayment  @relation(fields: [companyId, paymentId], references: [companyId, id], onDelete: Cascade)
  document        AccountingDocument @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Cascade)
