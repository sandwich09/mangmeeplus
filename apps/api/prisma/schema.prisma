  createdAt                  DateTime                 @default(now())
  company                    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntry               JournalEntry             @relation(fields: [companyId, journalEntryId], references: [companyId, id], onDelete: Cascade)
  account                    ChartOfAccount           @relation("AccountJournalLines", fields: [accountId], references: [id])
