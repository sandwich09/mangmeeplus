# Shared local defaults. Copy to .env for local development only.
NODE_ENV=development
APP_ENV=local
# Authoritative deployment identity for the launch control plane (local|uat|production).
# APP_ENV still decides runtime/security mode; this one is recorded on every gate transition, and
# the launch guard admits a route only while the running build/environment match the OPEN that
# authorized it. Under APP_ENV=production, a missing/`local` value here — or a build id that falls
# back to "unknown-build" — FAILS THE BOOT rather than recording an unattributable transition.
DEPLOY_ENVIRONMENT=local
SERVICE_NAME=api
SERVICE_VERSION=local
# Immutable build id: GIT_SHA or IMAGE_DIGEST (either is accepted; falls back to "unknown-build").
# Production injects the FULL commit sha, matching what the release task records (infra scripts).
GIT_SHA=local

POSTGRES_DB=watchdog_bms
POSTGRES_USER=watchdog
POSTGRES_PASSWORD=watchdog_local_password
POSTGRES_PORT=15432
DATABASE_URL=postgresql://watchdog:watchdog_local_password@localhost:15432/watchdog_bms?schema=public

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

S3_ENDPOINT=http://localhost:19000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_REGION=local
S3_BUCKET=watchdog-bms-local
S3_ACCESS_KEY_ID=watchdog
S3_SECRET_ACCESS_KEY=watchdog_local_secret
S3_FORCE_PATH_STYLE=true

AWS_REGION=ap-southeast-1

# Auth
AUTH_PROVIDER=dev
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=local-dev-secret-change-me
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LIFF_ID=
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
WEB_BASE_URL=http://localhost:3000
# Public origin of the API service (tunnel/prod URL). Used to build the
# company LINE OA webhook URL shown in Settings > LINE OA (item 15A).
PUBLIC_BASE_URL=http://localhost:3001
# Production-only: custom domain in front of the ECS endpoint (Cloudflare proxy).
# Read by infra/prod-ecs-express/deploy.sh to override public URLs at deploy. Empty for local.
PUBLIC_DOMAIN_URL=
# Secret inventory and rotation (L-03). Every value below is a LOCAL placeholder and is
# rejected at production boot (min length + committed-value denylist + entropy).
#   repo-generated (>=32 chars, `openssl rand -base64 32`): WORKER_INTERNAL_TOKEN,
#     AI_GATEWAY_INTERNAL_SECRET, WATCHDOG_JWT_SECRET_ARN
#   hex keys (`openssl rand -hex 32`): AI_ACTOR_DELEGATION_SIGNING_KEY,
#     CREDENTIAL_ENCRYPTION_KEY, PDPA_PSEUDONYMIZATION_KEY (retain old PDPA keys in
#     PDPA_PSEUDONYMIZATION_PREVIOUS_KEYS for the suppression window)
#   third-party (>=16 chars, rotate in the vendor console): LINE_* secrets/tokens,
#     OPENAI_API_KEY, S3_SECRET_ACCESS_KEY
# Production values live in AWS Secrets Manager. Before deploying, preflight the environment you
# are about to ship: `pnpm config:validate <env-file> [--service api|ai-gateway|workers]`, or
# `pnpm config:validate --process-env` from inside it. That runs the service's own boot schema plus
# the production rules and exits non-zero on any failure, naming keys only — never a value. With no
# arguments the same command only self-tests the rules against fixtures, which validates nothing
# about your deploy.
WORKER_INTERNAL_TOKEN=local-worker-token
AI_GATEWAY_INTERNAL_URL=http://localhost:3002/v1
AI_GATEWAY_INTERNAL_SECRET=local-ai-internal-secret
AI_ACTOR_DELEGATION_SIGNING_KEY=3456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef012
ERP_CORE_INTERNAL_URL=http://localhost:3001/v1
# Item 17 AI Draft/Suggestion generation provider (API side):
#   gateway  -> author suggestions with the model via the AI Gateway (set MODEL_PROVIDER=bedrock there) — production/AI
#   fake     -> deterministic content for local/CI demos (no model credentials)
#   disabled -> provider-unavailable (no suggestions generated)
AI_DRAFT_PROVIDER=gateway
# Server-side ERP API base for the web BFF (auth cookie routes, /auth/me session fetch)
# and the Next /api/* rewrite. Browser auth uses httpOnly cookies via same-origin /api/*;
# no NEXT_PUBLIC_* token/env is involved in browser auth anymore.
INTERNAL_API_URL=http://localhost:3001/v1
WATCHDOG_JWT_ISSUER=http://localhost:3001
WATCHDOG_JWT_AUDIENCE=watchdog-bms-local
WATCHDOG_JWT_SECRET_ARN=local-jwt-secret-change-me
# Local development: disabled (default), local-console, ses, or postmark.
# Normal UAT/Production releases require Postmark through infra/postmark/config.json.
EMAIL_PROVIDER=disabled
# Optional local Postmark transport settings; never commit real credentials.
# POSTMARK_SERVER_TOKEN=<server token>
# POSTMARK_SERVER_ID=<expected positive server ID>
# POSTMARK_MESSAGE_STREAM=outbound
# POSTMARK_FROM_ADDRESS=developer@mangmeeplus.com
# POSTMARK_FROM_NAME=Mangmee Plus (UAT)
# POSTMARK_WEBHOOK_USERNAME=<environment-specific username>
# POSTMARK_WEBHOOK_PASSWORD=<environment-specific password, at least 24 characters>
# POSTMARK_UAT_ALLOWED_RECIPIENTS=<comma-separated exact tester email addresses>
# Cloud UAT uses developer@mangmeeplus.com and https://uat.mangmeeplus.com.
# Production uses contact@mangmeeplus.com and https://mangmeeplus.com with separate secrets.
SES_REGION=ap-southeast-1
SES_FROM_ADDRESS=
PASSWORD_RESET_REQUEST_MAX_PER_IDENTIFIER=3
PASSWORD_RESET_REQUEST_MAX_PER_IP=10
PASSWORD_RESET_REQUEST_WINDOW_SECONDS=900
PASSWORD_RESET_CONFIRM_MAX_PER_IP=10
PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=900
# Fixed minimum duration of a forgot-password response, so the unknown-vs-eligible
# identifier round-trip difference is not observable. 0 disables the floor.
PASSWORD_RESET_RESPONSE_MIN_MS=300
EMAIL_VERIFICATION_REQUEST_MAX_PER_USER=3
EMAIL_VERIFICATION_REQUEST_WINDOW_SECONDS=900
EMAIL_VERIFICATION_CONFIRM_MAX_PER_IP=10
EMAIL_VERIFICATION_CONFIRM_WINDOW_SECONDS=900
SESSION_REFRESH_MAX_PER_SESSION=30
SESSION_REFRESH_WINDOW_SECONDS=60
# Grace window in which a rotated refresh token counts as a benign concurrent refresh
# (one BFF cookie shared by every browser tab) instead of token reuse. 0 = strict.
SESSION_REFRESH_REUSE_GRACE_SECONDS=30
AI_LLM_MAX_PER_COMPANY=60
AI_OCR_MAX_PER_COMPANY=20
AI_RATE_LIMIT_WINDOW_SECONDS=60
# THB per USD used to price AI usage rows in satang at record time. Operator-owned and
# static: money is computed once when the row is written, never re-derived later.
AI_THB_PER_USD=33
# Platform default monthly AI cap per company, in satang (200000 = ฿2,000). A company at or over
# it is refused at every AI seam until the next Bangkok month or a budget raise.
AI_MONTHLY_BUDGET_SATANG=200000
# Highest per-company override the partner console may set, in satang (1000000 = ฿10,000).
# Production refuses a ceiling below AI_MONTHLY_BUDGET_SATANG.
AI_MONTHLY_BUDGET_SATANG_CEILING=1000000
# Empty is local-only: production requires a reachable scanner, and attachment uploads fail
# closed (CLAMAV_NOT_CONFIGURED) without one. There is no safe placeholder value.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text
LOG_REDACTION_ENABLED=true
REQUEST_LOG_ENABLED=true
SQL_LOG_ENABLED=false

# Audit
AUDIT_ENABLED=true
AUDIT_SINK=database

# RBAC / tenant
REQUIRE_COMPANY_CONTEXT=true
COMPANY_CONTEXT_HEADER=X-Company-Id

# AI Gateway
# Local AI works once ANTHROPIC_API_KEY is set: MODEL_PROVIDER stays `bedrock`, and the key sends
# the same models through the Anthropic API instead of AWS (APP_ENV=local only). Without a key
# and without AWS credentials every AI call fails; set MODEL_PROVIDER=disabled to switch AI off.
# ANTHROPIC_API_KEY=
MODEL_PROVIDER=bedrock
APPROVED_AI_PROVIDERS=bedrock,openai
# LOCAL ONLY. The allowlist is enforced at call time in every environment, so this
# must contain whatever BEDROCK_MODEL_ID/DOCUMENT_AI_MODEL_ID you run locally.
# This value never reaches production: infra/prod-ecs-express/deploy.sh sets the
# production model and allowlist itself (and refuses to deploy without an approval
# reference), so a workstation .env cannot select what production runs. The
# `global.`-free baseline lives in packages/config (DEFAULT_APPROVED_AI_MODEL_IDS)
# and applies to anything that does not override it.
APPROVED_AI_MODEL_IDS=global.anthropic.claude-sonnet-4-6,global.anthropic.claude-haiku-5-5,global.anthropic.claude-haiku-4-5-20251001-v1:0,apac.anthropic.claude-3-haiku-20240307-v1:0
APPROVED_AI_REGIONS=ap-southeast-1
# Recorded exception for running a `global.` inference profile in production, which is
# how you run a model newer than the newest APAC-published profile. Both keys are
# required together: the flag alone is refused, because an approval with no reference
# has no owner. Setting these accepts that a turn may be processed outside
# APPROVED_AI_REGIONS, so the reference must point at the data-protection approval
# recorded in the processor register (M-05 / G-02), and the Bedrock IAM policy for the
# workload must actually permit the `global.anthropic.*` inference profile.
# Leave both unset to keep the geographic-profile-only default.
# LOCAL ONLY values below: BEDROCK_MODEL_ID here is a `global.` profile, and without this pair
# the gateway reports the LINE/demo chat path not ready and every message is refused.
AI_GLOBAL_INFERENCE_PROFILE_APPROVED=true
AI_GLOBAL_INFERENCE_PROFILE_APPROVAL_REF=local-dev
# OpenAI remains optional fallback only; Bedrock is the primary paid provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PROCESSING_REGION=
# Issue EXP on saved/date-reviewed drafts. Unset defaults to true; false pauses new draft issuance.
EXPENSE_DRAFT_NUMBERING_ENABLED=true
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Item 10B: agent orchestration, on as in production so local chat answers the same way.
LINE_AI_AGENT_ORCHESTRATION_ENABLED=true
LINE_AI_TOOLUSE_LOOP_ENABLED=true
LINE_AI_COVERAGE_CRITIC_ENABLED=true
LINE_EXPENSE_DRAFT_CONVERSATION_ENABLED=false
# S-4: edit a captured expense draft over LINE (preview card + confirm postback). Default on.
LINE_AI_DRAFT_EDIT_ENABLED=true
# Built-in LINE AI reliability features default on; no extra environment settings are needed.
# Public lookup remains off by default.
LINE_AI_LEDGER_ENABLED=false
AI_DATA_RETENTION_DAYS=90
LINE_AI_AGENT_RUNTIME=strands-local
AWS_PROFILE=
AWS_SDK_LOAD_CONFIG=false
# AgentCore runtime invoke (used when LINE_AI_AGENT_RUNTIME=agentcore; leave empty for local)
AGENTCORE_REGION=ap-southeast-1
AGENTCORE_RUNTIME_ARN=
AGENTCORE_RUNTIME_QUALIFIER=DEFAULT
AGENTCORE_INVOKE_TIMEOUT_MS=20000
# AgentCore invocation bounds. The byte cap is enforced while the body streams in
# (oversize -> 413); over-cap concurrent invocations answer 429.
AGENTCORE_MAX_BODY_BYTES=1048576
AGENTCORE_MAX_MESSAGE_CHARS=8000
AGENTCORE_MAX_ATTACHMENTS=10
AGENTCORE_MAX_CONCURRENT_INVOCATIONS=16
AI_GATEWAY_ENABLED=true
AI_AGENT_REGISTRY_ENABLED=true
AI_TOOL_POLICY_ENFORCED=true
AI_TOOL_AUDIT_ENABLED=true
# Read by BOTH the AI Gateway and the ERP API (the ERP executor is authoritative).
# Must stay false in production; production boot refuses true without ADR approval.
AI_FINAL_MUTATION_ENABLED=false
AI_PROMPT_LOGGING_ENABLED=false
AI_MAX_TOOL_CALLS=8
AI_TOOL_TIMEOUT_MS=10000

# Rate limit / uploads
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
UPLOAD_MAX_BYTES=10485760
UPLOAD_PENDING_MAX_BYTES_PER_COMPANY=104857600
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg
SIGNED_URL_TTL_SECONDS=300

# Item 10A partner management
CREDENTIAL_ENCRYPTION_KEY=
# Dedicated stable HMAC root. Keep independent from CREDENTIAL_ENCRYPTION_KEY.
PDPA_PSEUDONYMIZATION_KEY=
# Comma-separated prior PDPA_PSEUDONYMIZATION_KEY values. Retain for at least
# the longest erased-identity suppression/retention window before retiring.
PDPA_PSEUDONYMIZATION_PREVIOUS_KEYS=
# Local only — see the APPROVED_AI_MODEL_IDS note in the AI Gateway section above.
APPROVED_AI_MODEL_IDS=global.anthropic.claude-sonnet-4-6,global.anthropic.claude-haiku-5-5,global.anthropic.claude-haiku-4-5-20251001-v1:0,apac.anthropic.claude-3-haiku-20240307-v1:0

HOST=127.0.0.1
API_PORT=3001
AI_GATEWAY_PORT=3002
WEB_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HTTP_BODY_LIMIT=1mb
# Docs are now gated on this flag in EVERY environment, not just production, so a
# non-production deployment no longer publishes the full route/DTO surface by default.
# Local developers keep /docs by opting in here; UAT and staging must leave it false.
SWAGGER_ENABLED=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
NEXT_PUBLIC_AI_GATEWAY_BASE_URL=http://localhost:3002/v1
LINE_OA_ADD_URL=
LINE_OA_QR_IMAGE_URL=
LINE_ACCOUNT_LINK_URL=
LINE_ACCOUNT_LINK_QR_IMAGE_URL=
# Local-dev only. Empty falls back to the local seed password; production boot REFUSES this
# key and a production seed run throws instead of using the fallback.
SEED_SYSTEM_ADMIN_PASSWORD=
CRM_AUTO_REPLY_ENABLED=
CRM_AI_OUTBOUND_ALLOWED_DOMAINS=
# Exact hosts or explicit *.subdomain patterns; empty denies every workflow webhook.
# Production requires a stated decision rather than an empty value, so that a task definition
# which lost the key fails to boot instead of silently becoming deny-all. Deploy real hosts, or
# `none` to deny every webhook — never a placeholder host, which would be weaker than `none`.
WORKFLOW_WEBHOOK_ALLOWED_HOSTS=

# Account email OTP (local development only). Normal UAT/Production releases use
# infra/postmark/config.json and environment-scoped secret references.
# Set a private random 32-byte hex key; never commit its value.
# EMAIL_OTP_HMAC_KEY=<private-random-64-hex-characters>
EMAIL_OTP_HMAC_KEY_VERSION=local-email-otp-v1
