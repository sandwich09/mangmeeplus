{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullExactMigrationTool",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": "arn:aws:ecr:ap-southeast-1:311414082667:repository/watchdog-bms-migration-tool"
    },
    {"Sid": "AuthenticateToEcr", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
    {
      "Sid": "WriteOnlyReaderTaskLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-1:311414082667:log-group:/ecs/watchdog-bms-production-a5-readonly:log-stream:*"
    },
    {
      "Sid": "ReadOnlyExactProductionA5ReaderSecret",
      "Effect": "Allow",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/production/a5-readonly-database-url-*"
    },
    {
      "Sid": "DecryptReaderSecretThroughSecretsManagerOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ap-southeast-1:311414082667:key/b2e68e7f-e098-4b88-a92a-5a0f4fe2924a",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "311414082667",
          "kms:ViaService": "secretsmanager.ap-southeast-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyOutsideReaderTaskBootstrap",
      "Effect": "Deny",
      "NotAction": [
        "ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetAuthorizationToken", "ecr:GetDownloadUrlForLayer",
        "kms:Decrypt", "logs:CreateLogStream", "logs:PutLogEvents", "secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue"
      ],
      "Resource": "*"
    }
  ]
}
