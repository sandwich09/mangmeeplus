{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExactBootstrapAndReaderSecrets",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/production/a5-readonly-database-url-*",
        "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/production/database-url-*"
      ],
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": [
            "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-bootstrap-execution",
            "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly-execution"
          ]
        }
      }
    },
    {
      "Sid": "ReadExactApplyWriterSecret",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/production/database-url-*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-apply-execution"
        }
      }
    },
    {
      "Sid": "ReadOnlyRdsManagedCloneSecret",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:rds!db-*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone-execution"
        },
        "StringLike": {
          "secretsmanager:ResourceTag/aws:rds:primaryDBInstanceArn": "arn:aws:rds:ap-southeast-1:311414082667:db:watchdog-a5-clone-*"
        }
      }
    },
    {
      "Sid": "ReadUatRuntimeSecretsOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/uat/*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::311414082667:role/watchdog-bms-uat-ecs-execution-role"
        }
      }
    },
    {
      "Sid": "ReadProductionRuntimeSecretsOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/production/*",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::311414082667:role/ecsTaskExecutionRole"
        }
      }
    },
    {
      "Sid": "ReadExactSupportArmSecret",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/production/database-url-b7MStR",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::311414082667:role/watchdog-bms-ssm-bastion-role"
        }
      }
    }
  ]
}
