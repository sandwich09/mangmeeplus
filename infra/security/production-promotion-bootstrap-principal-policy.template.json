{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExactPromotionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies"
      ],
      "Resource": [
        "arn:aws:iam::311414082667:role/ecsInfrastructureRoleForExpressServices",
        "arn:aws:iam::311414082667:role/ecsTaskExecutionRole",
        "arn:aws:iam::311414082667:role/watchdog-bms-agentcore-execution-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-deploy-production",
        "arn:aws:iam::311414082667:role/watchdog-bms-deploy-uat",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-ai-gateway-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-api-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-workers-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-release-task-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-apply-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-bootstrap-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-reader-bootstrap",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-security-readonly",
        "arn:aws:iam::311414082667:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
        "arn:aws:iam::311414082667:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService",
        "arn:aws:iam::311414082667:role/aws-service-role/elasticloadbalancing.amazonaws.com/AWSServiceRoleForElasticLoadBalancing",
        "arn:aws:iam::311414082667:role/aws-service-role/rds.amazonaws.com/AWSServiceRoleForRDS",
        "arn:aws:iam::311414082667:role/aws-service-role/elasticache.amazonaws.com/AWSServiceRoleForElastiCache"
      ]
    },
    {
      "Sid": "WriteExactPromotionPolicies",
      "Effect": "Allow",
      "Action": "iam:PutRolePolicy",
      "Resource": [
        "arn:aws:iam::311414082667:role/ecsTaskExecutionRole",
        "arn:aws:iam::311414082667:role/watchdog-bms-agentcore-execution-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-deploy-production",
        "arn:aws:iam::311414082667:role/watchdog-bms-deploy-uat",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-ai-gateway-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-api-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-workers-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-release-task-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-apply-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-bootstrap-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-reader-bootstrap",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-security-readonly"
      ]
    },
    {
      "Sid": "ConfigureExactPromotionTrust",
      "Effect": "Allow",
      "Action": "iam:UpdateAssumeRolePolicy",
      "Resource": [
        "arn:aws:iam::311414082667:role/ecsInfrastructureRoleForExpressServices",
        "arn:aws:iam::311414082667:role/ecsTaskExecutionRole",
        "arn:aws:iam::311414082667:role/watchdog-bms-agentcore-execution-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-deploy-production",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-ai-gateway-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-api-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-ecs-express-workers-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-release-task-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-apply-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-bootstrap-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-reader-bootstrap",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-security-readonly"
      ]
    },
    {
      "Sid": "AttachExactAwsManagedRuntimePolicies",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": [
        "arn:aws:iam::311414082667:role/ecsInfrastructureRoleForExpressServices",
        "arn:aws:iam::311414082667:role/ecsTaskExecutionRole"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/service-role/AmazonECSInfrastructureRoleforExpressGatewayServices",
            "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          ]
        }
      }
    },
    {
      "Sid": "ConfigureExactPromotionDuration",
      "Effect": "Allow",
      "Action": "iam:UpdateRole",
      "Resource": [
        "arn:aws:iam::311414082667:role/watchdog-bms-agentcore-execution-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-deploy-production",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-apply-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-bootstrap-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-reader-bootstrap",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-security-readonly"
      ]
    },
    {
      "Sid": "CreateOnlyMissingA5Roles",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-apply-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-bootstrap-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone-execution",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-reader-bootstrap",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-readonly-execution"
      ]
    },
    {
      "Sid": "ReadExactAgentCorePolicySecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/production/ai-gateway-internal-secret-*",
        "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/production/watchdog-jwt-secret-*"
      ]
    },
    {
      "Sid": "RepairExactProductionBucketLifecycle",
      "Effect": "Allow",
      "Action": [
        "s3:GetLifecycleConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::watchdog-bms-prod-311414082667"
    },
    {
      "Sid": "ReadExactProductionDatabaseConfiguration",
      "Effect": "Allow",
      "Action": "rds:DescribeDBInstances",
      "Resource": "*"
    },
    {
      "Sid": "RepairExactCloneDatabaseConfigurationPointers",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters",
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:ap-southeast-1:311414082667:parameter/watchdog-bms/production/a5-clone/db-subnet-group-name",
        "arn:aws:ssm:ap-southeast-1:311414082667:parameter/watchdog-bms/production/a5-clone/db-parameter-group-name",
        "arn:aws:ssm:ap-southeast-1:311414082667:parameter/watchdog-bms/production/a5-clone/option-group-name"
      ]
    }
  ]
}
