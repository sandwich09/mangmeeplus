{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExactUatRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies"
      ],
      "Resource": [
        "arn:aws:iam::311414082667:role/watchdog-bms-deploy-uat",
        "arn:aws:iam::311414082667:role/watchdog-bms-uat-agentcore-execution-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-uat-ecs-ai-gateway-role"
      ]
    },
    {
      "Sid": "WriteExactUatRuntimePolicies",
      "Effect": "Allow",
      "Action": "iam:PutRolePolicy",
      "Resource": [
        "arn:aws:iam::311414082667:role/watchdog-bms-deploy-uat",
        "arn:aws:iam::311414082667:role/watchdog-bms-uat-agentcore-execution-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-uat-ecs-ai-gateway-role"
      ]
    },
    {
      "Sid": "ConfigureExactUatRuntimeRoles",
      "Effect": "Allow",
      "Action": [
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole"
      ],
      "Resource": [
        "arn:aws:iam::311414082667:role/watchdog-bms-uat-agentcore-execution-role",
        "arn:aws:iam::311414082667:role/watchdog-bms-uat-ecs-ai-gateway-role"
      ]
    },
    {
      "Sid": "CreateOnlyMissingUatAgentCoreRole",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::311414082667:role/watchdog-bms-uat-agentcore-execution-role"
    },
    {
      "Sid": "ReadUatAgentCoreCandidate",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:ListAgentRuntimes",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "ReadExactUatAgentCoreSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/uat/ai-gateway-internal-secret-*",
        "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:watchdog-bms/uat/watchdog-jwt-secret-*"
      ]
    },
    {
      "Sid": "RepairExactAgentCoreArtifactVersioning",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::watchdog-bms-agentcore-artifacts-311414082667"
    }
  ]
}
