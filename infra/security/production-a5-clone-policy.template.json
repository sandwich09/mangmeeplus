{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "AllowSelfInspection",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:GetRolePolicy", "iam:ListAttachedRolePolicies", "iam:ListRolePolicies"],
      "Resource": [
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone",
        "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone-execution"
      ]
    },
    {
      "Sid": "AllowExactCloneConfigurationRead",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:ap-southeast-1:311414082667:parameter/watchdog-bms/production/a5-clone/*",
        "arn:aws:ssm:ap-southeast-1:311414082667:parameter/watchdog-bms/production/a5-network/*"
      ]
    },
    {
      "Sid": "AllowRdsDiscovery",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances", "rds:DescribeDBSnapshots", "rds:DescribeDBSubnetGroups",
        "rds:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowTaggedCloneRestore",
      "Effect": "Allow",
      "Action": "rds:RestoreDBInstanceFromDBSnapshot",
      "Resource": [
        "arn:aws:rds:ap-southeast-1:311414082667:db:watchdog-a5-clone-*",
        "arn:aws:rds:ap-southeast-1:311414082667:snapshot:rds:watchdog-bms-prod-db-*",
        "arn:aws:rds:ap-southeast-1:311414082667:subgrp:watchdog-bms-prod-db-subnets",
        "arn:aws:rds:ap-southeast-1:311414082667:pg:watchdog-bms-prod-pg18",
        "arn:aws:rds:ap-southeast-1:311414082667:og:default:postgres-18"
      ],
      "Condition": {
        "StringEquals": {"aws:RequestTag/purpose": "production-a5-clone"},
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["parentRunAttempt", "parentRunId", "producerRunAttempt", "producerRunId", "purpose", "sourceCommit"]
        },
        "Null": {
          "aws:RequestTag/parentRunAttempt": "false",
          "aws:RequestTag/parentRunId": "false",
          "aws:RequestTag/producerRunAttempt": "false",
          "aws:RequestTag/producerRunId": "false",
          "aws:RequestTag/purpose": "false",
          "aws:RequestTag/sourceCommit": "false"
        }
      }
    },
    {
      "Sid": "AllowTaggedCloneInitialTags",
      "Effect": "Allow",
      "Action": "rds:AddTagsToResource",
      "Resource": "arn:aws:rds:ap-southeast-1:311414082667:db:watchdog-a5-clone-*",
      "Condition": {
        "StringEquals": {"aws:RequestTag/purpose": "production-a5-clone"},
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["parentRunAttempt", "parentRunId", "producerRunAttempt", "producerRunId", "purpose", "sourceCommit"]
        },
        "Null": {
          "aws:RequestTag/parentRunAttempt": "false",
          "aws:RequestTag/parentRunId": "false",
          "aws:RequestTag/producerRunAttempt": "false",
          "aws:RequestTag/producerRunId": "false",
          "aws:RequestTag/purpose": "false",
          "aws:RequestTag/sourceCommit": "false"
        }
      }
    },
    {
      "Sid": "AllowTaggedCloneDelete",
      "Effect": "Allow",
      "Action": "rds:DeleteDBInstance",
      "Resource": "arn:aws:rds:ap-southeast-1:311414082667:db:watchdog-a5-clone-*",
      "Condition": {"StringEquals": {"rds:db-tag/purpose": "production-a5-clone"}}
    },
    {
      "Sid": "AllowTaggedCloneManagedPassword",
      "Effect": "Allow",
      "Action": "rds:ModifyDBInstance",
      "Resource": "arn:aws:rds:ap-southeast-1:311414082667:db:watchdog-a5-clone-*",
      "Condition": {
        "StringEquals": {"rds:db-tag/purpose": "production-a5-clone"},
        "Bool": {"rds:ManageMasterUserPassword": "true"}
      }
    },
    {
      "Sid": "DenyProductionDatabaseMutation",
      "Effect": "Deny",
      "Action": [
        "rds:DeleteDBInstance", "rds:ModifyDBInstance", "rds:RebootDBInstance",
        "rds:StartDBInstance", "rds:StopDBInstance"
      ],
      "Resource": "arn:aws:rds:ap-southeast-1:311414082667:db:watchdog-bms-prod-*"
    },
    {
      "Sid": "AllowCloneManagedSecretMetadata",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:rds!db-*",
      "Condition": {
        "StringLike": {
          "secretsmanager:ResourceTag/aws:rds:primaryDBInstanceArn": "arn:aws:rds:ap-southeast-1:311414082667:db:watchdog-a5-clone-*"
        }
      }
    },
    {
      "Sid": "AllowRdsManagedCloneSecretCreation",
      "Effect": "Allow",
      "Action": ["secretsmanager:CreateSecret", "secretsmanager:TagResource"],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:311414082667:secret:rds!db-*"
    },
    {
      "Sid": "AllowCloneTaskDefinitionLifecycle",
      "Effect": "Allow",
      "Action": [
        "ecs:DeregisterTaskDefinition", "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions", "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowExactCloneTaskList",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": {
        "ArnEquals": {"ecs:cluster": "arn:aws:ecs:ap-southeast-1:311414082667:cluster/watchdog-bms-prod"}
      }
    },
    {
      "Sid": "AllowExactCloneTaskRun",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:ap-southeast-1:311414082667:task-definition/watchdog-a5-clone-*:*",
      "Condition": {
        "ArnEquals": {"ecs:cluster": "arn:aws:ecs:ap-southeast-1:311414082667:cluster/watchdog-bms-prod"}
      }
    },
    {
      "Sid": "AllowExactCloneTaskDescribeStop",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTasks", "ecs:StopTask"],
      "Resource": "arn:aws:ecs:ap-southeast-1:311414082667:task/watchdog-bms-prod/*",
      "Condition": {
        "ArnEquals": {"ecs:cluster": "arn:aws:ecs:ap-southeast-1:311414082667:cluster/watchdog-bms-prod"}
      }
    },
    {
      "Sid": "AllowExactExecutionRolePass",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::311414082667:role/watchdog-bms-production-a5-clone-execution",
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    },
    {
      "Sid": "AllowCloneLogRead",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogStreams", "logs:FilterLogEvents", "logs:GetLogEvents"],
      "Resource": [
        "arn:aws:logs:ap-southeast-1:311414082667:log-group:/ecs/watchdog-bms-production-a5-clone",
        "arn:aws:logs:ap-southeast-1:311414082667:log-group:/ecs/watchdog-bms-production-a5-clone:*"
      ]
    },
    {
      "Sid": "AllowRdsGrantOnSnapshotKey",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:kms:ap-southeast-1:311414082667:key/52b4943e-e9d7-4fae-b71c-c13b0b157b27",
      "Condition": {
        "StringEquals": {"kms:ViaService": "rds.ap-southeast-1.amazonaws.com"},
        "Bool": {"kms:GrantIsForAWSResource": "true"}
      }
    },
    {
      "Sid": "AllowNetworkAndKeyInspection",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeNetworkInterfaces", "ec2:DescribeRouteTables", "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets", "ec2:DescribeVpcEndpoints",
        "ecr:DescribeRepositories",
        "logs:DescribeLogGroups", "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowDedicatedToolRepositoryAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AllowDedicatedToolRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:BatchDeleteImage", "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages", "ecr:DescribeImageScanFindings", "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload", "ecr:ListImages", "ecr:PutImage", "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-1:311414082667:repository/watchdog-bms-migration-tool"
    },
    {
      "Sid": "DenyOutsideCloneController",
      "Effect": "Deny",
      "NotAction": [
        "ec2:DescribeNetworkInterfaces", "ec2:DescribeRouteTables", "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets", "ec2:DescribeVpcEndpoints",
        "ecr:BatchCheckLayerAvailability", "ecr:BatchDeleteImage", "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages", "ecr:DescribeImageScanFindings", "ecr:DescribeRepositories",
        "ecr:GetAuthorizationToken",
        "ecr:GetDownloadUrlForLayer", "ecr:InitiateLayerUpload", "ecr:ListImages",
        "ecr:PutImage", "ecr:UploadLayerPart",
        "ecs:DeregisterTaskDefinition", "ecs:DescribeTaskDefinition", "ecs:ListTaskDefinitions",
        "ecs:DescribeTasks", "ecs:ListTasks", "ecs:RegisterTaskDefinition", "ecs:RunTask", "ecs:StopTask",
        "iam:GetRole", "iam:GetRolePolicy", "iam:ListAttachedRolePolicies", "iam:ListRolePolicies",
        "iam:PassRole", "kms:CreateGrant", "kms:DescribeKey",
        "logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:FilterLogEvents", "logs:GetLogEvents",
        "rds:AddTagsToResource", "rds:DeleteDBInstance", "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots", "rds:DescribeDBSubnetGroups", "rds:ListTagsForResource",
        "rds:ModifyDBInstance", "rds:RestoreDBInstanceFromDBSnapshot",
        "secretsmanager:CreateSecret", "secretsmanager:DescribeSecret", "secretsmanager:TagResource",
        "ssm:GetParameter",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
