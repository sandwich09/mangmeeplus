{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccountProbe",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "EcsReleaseAndExpressDeploy",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:DescribeExpressGatewayService",
        "ecs:UpdateExpressGatewayService",
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions",
        "ecs:RunTask",
        "ecs:StopTask",
        "ecs:ListTasks",
        "ecs:DescribeTasks",
        "ecs:ListServiceDeployments",
        "ecs:DescribeServiceDeployments",
        "ecs:DescribeServiceRevisions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadAndPassExistingEcsRoles",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/ecs.amazonaws.com/AWSServiceRoleForECS",
        "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/elasticloadbalancing.amazonaws.com/AWSServiceRoleForElasticLoadBalancing",
        "arn:aws:iam::<ACCOUNT_ID>:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService",
        "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-release-task-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-production-a5-apply-execution",
        "arn:aws:iam::<ACCOUNT_ID>:role/ecsInfrastructureRoleForExpressServices",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-ecs-express-api-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-ecs-express-ai-gateway-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-ecs-express-workers-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-production-agentcore-candidate-execution-role"
      ]
    },
    {
      "Sid": "ManageProductionAgentCoreCandidateRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-production-agentcore-candidate-execution-role"
    },
    {
      "Sid": "PassProductionAgentCoreCandidateRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-production-agentcore-candidate-execution-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageProductionAgentCoreCandidate",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateAgentRuntime",
        "bedrock-agentcore:CreateWorkloadIdentity",
        "bedrock-agentcore:UpdateAgentRuntime",
        "bedrock-agentcore:GetAgentRuntime",
        "bedrock-agentcore:ListAgentRuntimes",
        "bedrock-agentcore:CreateAgentRuntimeEndpoint",
        "bedrock-agentcore:GetAgentRuntimeEndpoint",
        "bedrock-agentcore:ListAgentRuntimeEndpoints",
        "bedrock-agentcore:TagResource",
        "bedrock-agentcore:InvokeAgentRuntime"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageVersionedProductionAgentCoreArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::watchdog-bms-agentcore-artifacts-<ACCOUNT_ID>",
        "arn:aws:s3:::watchdog-bms-agentcore-artifacts-<ACCOUNT_ID>/agentcore/watchdog_orchestrator_production_candidate-*"
      ]
    },
    {
      "Sid": "PassExistingEcsRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-release-task-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-production-a5-apply-execution",
        "arn:aws:iam::<ACCOUNT_ID>:role/ecsInfrastructureRoleForExpressServices",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-ecs-express-api-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-ecs-express-ai-gateway-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-ecs-express-workers-role"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ecs.amazonaws.com",
            "ecs-tasks.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "VerifyReleaseTaskRolePolicy",
      "Effect": "Allow",
      "Action": [
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": [
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-release-task-role",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-production-a5-apply-execution",
        "arn:aws:iam::<ACCOUNT_ID>:role/watchdog-bms-ecs-express-workers-role"
      ]
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ReleaseTaskImage",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-1:<ACCOUNT_ID>:repository/watchdog-bms-api"
    },
    {
      "Sid": "VerifyAndPullRuntimeImages",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-1:<ACCOUNT_ID>:repository/watchdog-bms-ai-gateway",
        "arn:aws:ecr:ap-southeast-1:<ACCOUNT_ID>:repository/watchdog-bms-migration-tool",
        "arn:aws:ecr:ap-southeast-1:<ACCOUNT_ID>:repository/watchdog-bms-workers"
      ]
    },
    {
      "Sid": "ProductionParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-1:<ACCOUNT_ID>:parameter/watchdog-bms/production/*"
    },
    {
      "Sid": "DescribeProductionSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:<ACCOUNT_ID>:secret:watchdog-bms/production/*"
    },
    {
      "Sid": "ReadExactWorkerHealthToken",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:<ACCOUNT_ID>:secret:watchdog-bms/production/worker-internal-token-*"
    },
    {
      "Sid": "NetworkRead",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRouteTables",
        "ec2:DescribeVpcEndpoints"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LoadBalancerHealthRead",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProductionDatabaseReadback",
      "Effect": "Allow",
      "Action": "rds:DescribeDBInstances",
      "Resource": "arn:aws:rds:ap-southeast-1:<ACCOUNT_ID>:db:watchdog-bms-prod-db"
    },
    {
      "Sid": "ReleaseAndDeployLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:DescribeLogStreams",
        "logs:PutRetentionPolicy",
        "logs:AssociateKmsKey",
        "logs:PutMetricFilter"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DescribeLogEncryptionKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:ap-southeast-1:<ACCOUNT_ID>:key/*"
    },
    {
      "Sid": "SecurityAlarmRouting",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EvidenceBucketControls",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetLifecycleConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketCORS"
      ],
      "Resource": "arn:aws:s3:::watchdog-bms-prod-<ACCOUNT_ID>"
    }
  ]
}
