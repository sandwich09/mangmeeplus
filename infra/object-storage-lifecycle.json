{
  "Rules": [
    {
      "ID": "expire-uncompleted-uploads",
      "Status": "Enabled",
      "Filter": { "Prefix": "pending/" },
      "Expiration": { "Days": 1 },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    },
    {
      "ID": "expire-report-exports",
      "Status": "Enabled",
      "Filter": { "Prefix": "report-export/" },
      "Expiration": { "Days": 7 },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 1 }
    }
  ]
}
