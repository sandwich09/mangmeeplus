{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProductionDataSecretsForSupport",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-1:<ACCOUNT_ID>:secret:watchdog-bms/production/database-url-*",
        "arn:aws:secretsmanager:ap-southeast-1:<ACCOUNT_ID>:secret:watchdog-bms/production/a5-readonly-database-url-*"
      ]
    },
    {
      "Sid": "ConnectAsSupportDatabaseRoles",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": [
        "arn:aws:rds-db:ap-southeast-1:<ACCOUNT_ID>:dbuser:<DB_RESOURCE_ID>/watchdog_support_ro",
        "arn:aws:rds-db:ap-southeast-1:<ACCOUNT_ID>:dbuser:<DB_RESOURCE_ID>/watchdog_support_rw"
      ]
    }
  ]
}
