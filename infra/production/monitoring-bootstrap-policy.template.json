{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LogEncryptionKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:CreateAlias",
        "kms:ListAliases",
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-1" }
      }
    },
    {
      "Sid": "SecurityAlertTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:Subscribe",
        "sns:Publish",
        "sns:GetTopicAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:ListTopics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-1" }
      }
    },
    {
      "Sid": "BaselineAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:DeleteAlarms"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-1" }
      }
    },
    {
      "Sid": "DiscoverRedisMetricDimensions",
      "Effect": "Allow",
      "Action": "elasticache:DescribeCacheClusters",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "ap-southeast-1" }
      }
    },
    {
      "Sid": "RuntimeMetricFilters",
      "Effect": "Allow",
      "Action": [
        "logs:PutMetricFilter",
        "logs:DescribeMetricFilters",
        "logs:DeleteMetricFilter"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-1:<ACCOUNT_ID>:log-group:/ecs/watchdog-bms-uat-api-web:*",
        "arn:aws:logs:ap-southeast-1:<ACCOUNT_ID>:log-group:/ecs/watchdog-bms-uat-ai-gateway:*",
        "arn:aws:logs:ap-southeast-1:<ACCOUNT_ID>:log-group:/ecs/watchdog-bms-prod-api-web:*",
        "arn:aws:logs:ap-southeast-1:<ACCOUNT_ID>:log-group:/ecs/watchdog-bms-prod-ai-gateway:*"
      ]
    },
    {
      "Sid": "CustomerJourneyDashboard",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutDashboard",
        "cloudwatch:GetDashboard"
      ],
      "Resource": "arn:aws:cloudwatch::<ACCOUNT_ID>:dashboard/watchdog-bms-*-customer-journeys"
    },
    {
      "Sid": "EcrLifecycle",
      "Effect": "Allow",
      "Action": [
        "ecr:PutLifecyclePolicy",
        "ecr:GetLifecyclePolicy",
        "ecr:DescribeRepositories"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-1:<ACCOUNT_ID>:repository/watchdog-bms-*"
    }
  ]
}
