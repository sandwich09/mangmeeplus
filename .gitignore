# Office lock files (Excel/Word leave these next to an open document)
~$*

# Playwright run output (traces, failure contexts) — regenerated per run.
test-results/

# Evidence screenshots are ~170MB per full run: the manifest and results.jsonl are the
# reviewable record, the PNGs are local artifacts (spec docs/specs/mobile-first-launch-features-spec.md section 12.6).
outputs/mobile-evidence/**/*.png

# Python bytecode from the infra/* release tooling tests.
__pycache__/

# Portable local proof toolkit: machine settings and generated proof artifacts.
/scripts/local-proof/settings.local.sh
/.local-proof/
